<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================= -->
    <!-- REVERTIDO: el enfoque de "footer dinámico de última hoja"     -->
    <!-- rompía el diseño (cabecera encimada con el contenido por el   -->
    <!-- margen amplio) y ocultaba los Términos. Se elimina el override -->
    <!-- del layout y el paperformat personalizado.                    -->
    <!--                                                               -->
    <!-- Aquí solo restauramos el paperformat POR DEFECTO en las       -->
    <!-- acciones que lo habían recibido. El resto de plantillas de    -->
    <!-- este archivo se eliminaron, por lo que Odoo limpia el override -->
    <!-- y el paperformat huérfanos al actualizar.                     -->
    <!-- ============================================================= -->

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" eval="False"/>
    </record>

    <record id="stock_lot_dimensions.action_report_sale_order_main_no_prices" model="ir.actions.report">
        <field name="paperformat_id" eval="False"/>
    </record>

    <record id="stock_lot_dimensions.action_report_sale_order_custom_detail" model="ir.actions.report">
        <field name="paperformat_id" eval="False"/>
    </record>

    <record id="stock_lot_dimensions.action_report_sale_order_detail_no_prices" model="ir.actions.report">
        <field name="paperformat_id" eval="False"/>
    </record>
</odoo>
