<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_stock_lot_hold_order_detail" model="ir.actions.report">
        <field name="name">Orden de Reserva - Detalle</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_stock_lot_hold_order_detail</field>
        <field name="report_file">stock_lot_dimensions.report_stock_lot_hold_order_detail</field>
        <field name="print_report_name">'Reserva Detalle - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_lot_hold_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_stock_lot_hold_order_detail">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">

                    <t t-set="address" t-value="False"/>
                    <t t-set="information_block" t-value="False"/>

                    <div class="page report-hold-order-detail"
                         style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">

                        <style type="text/css">
                            .report-hold-order-detail,
                            .report-hold-order-detail * {
                                box-sizing: border-box;
                            }

                            .report-hold-order-detail {
                                padding-top: 0;
                                clear: both;
                            }

                            .report-hold-order-detail .section-avoid,
                            .report-hold-order-detail .report-main-header,
                            .report-hold-order-detail .expiration-alert,
                            .report-hold-order-detail .info-block,
                            .report-hold-order-detail .notes-block,
                            .report-hold-order-detail .totals-block,
                            .report-hold-order-detail .signature-block,
                            .report-hold-order-detail .terms-block {
                                page-break-inside: avoid;
                                break-inside: avoid;
                            }

                            .report-hold-order-detail .report-main-header {
                                width: 100%;
                                border-bottom: 1px solid #000;
                                padding: 0 0 3px 0;
                                margin: 0 0 5px 0;
                                line-height: 1;
                            }

                            .report-hold-order-detail .report-main-header-table {
                                width: 100%;
                                border-collapse: collapse;
                                table-layout: fixed;
                            }

                            .report-hold-order-detail .report-main-header-table td {
                                border: none;
                                padding: 0;
                                vertical-align: middle;
                            }

                            .report-hold-order-detail .report-main-title {
                                font-size: 12px;
                                font-weight: 800;
                                letter-spacing: 0.6px;
                                text-transform: uppercase;
                                line-height: 1;
                                margin: 0;
                                padding: 0;
                            }

                            .report-hold-order-detail .report-main-date {
                                font-size: 7px;
                                color: #777;
                                line-height: 1;
                                margin: 0;
                                padding: 0;
                                text-align: right;
                            }

                            .report-hold-order-detail .detail-lines-wrapper {
                                clear: both;
                                display: block;
                                width: 100%;
                                margin-top: 6px;
                            }

                            .report-hold-order-detail .hold-line-card {
                                clear: both;
                                display: block;
                                width: 100%;
                                margin: 0 0 14px 0;
                                border: 1px solid #bbb;
                                page-break-inside: auto;
                                break-inside: auto;
                            }

                            .report-hold-order-detail .hold-line-header {
                                page-break-after: avoid;
                                break-after: avoid;
                                padding: 5px 7px;
                                background: #2f2f2f;
                                color: #fff;
                                border-bottom: 1px solid #bbb;
                            }

                            .report-hold-order-detail .hold-line-summary-table {
                                width: 100%;
                                table-layout: fixed;
                                border-collapse: collapse;
                            }

                            .report-hold-order-detail .hold-line-summary-table td {
                                border: none;
                                padding: 0;
                                vertical-align: middle;
                                line-height: 1.2;
                            }

                            .report-hold-order-detail .hold-line-product {
                                width: 42%;
                                font-weight: 800;
                                text-transform: uppercase;
                                overflow-wrap: break-word;
                                word-break: normal;
                            }

                            .report-hold-order-detail .hold-line-summary {
                                width: 58%;
                                text-align: right;
                                font-size: 9px;
                                white-space: normal;
                                line-height: 1.2;
                            }

                            .report-hold-order-detail .hold-lots-table {
                                width: 100%;
                                table-layout: fixed;
                                border-collapse: collapse;
                                page-break-inside: auto;
                                break-inside: auto;
                                font-size: 8.5px;
                            }

                            .report-hold-order-detail .hold-lots-table thead {
                                display: table-row-group;
                            }

                            .report-hold-order-detail .hold-lots-table tbody {
                                display: table-row-group;
                            }

                            .report-hold-order-detail .hold-lots-table tfoot {
                                display: table-row-group;
                            }

                            .report-hold-order-detail .hold-lots-table tr {
                                page-break-inside: avoid;
                                break-inside: avoid;
                                page-break-after: auto;
                            }

                            .report-hold-order-detail .hold-lots-table th,
                            .report-hold-order-detail .hold-lots-table td {
                                padding: 3px 4px;
                                line-height: 1.12;
                                vertical-align: top;
                                overflow-wrap: break-word;
                                word-break: normal;
                            }

                            .report-hold-order-detail .hold-lots-table th {
                                background-color: #f8f8f8;
                                border-bottom: 1px solid #000;
                                font-weight: 800;
                            }

                            .report-hold-order-detail .hold-lots-table tbody td {
                                border-bottom: 1px solid #e5e5e5;
                            }

                            .report-hold-order-detail .hold-lots-table tfoot td {
                                border-top: 2px solid #000;
                                background-color: #f8f8f8;
                                font-weight: bold;
                            }

                            .report-hold-order-detail .col-index { width: 4%; }
                            .report-hold-order-detail .col-lot { width: 13%; }
                            .report-hold-order-detail .col-bloque { width: 11%; }
                            .report-hold-order-detail .col-atado { width: 9%; }
                            .report-hold-order-detail .col-placa { width: 9%; }
                            .report-hold-order-detail .col-color { width: 11%; }
                            .report-hold-order-detail .col-grosor { width: 7%; }
                            .report-hold-order-detail .col-alto { width: 8%; }
                            .report-hold-order-detail .col-ancho { width: 8%; }
                            .report-hold-order-detail .col-m2 { width: 8%; }
                            .report-hold-order-detail .col-subtotal { width: 12%; }

                            .report-hold-order-detail .text-end {
                                text-align: right;
                            }

                            .report-hold-order-detail .text-center {
                                text-align: center;
                            }

                            .report-hold-order-detail .nowrap {
                                white-space: nowrap;
                            }

                            .report-hold-order-detail .safe-spacer {
                                clear: both;
                                height: 1px;
                                line-height: 1px;
                                font-size: 1px;
                            }
                        </style>

                        <!-- ================= ENCABEZADO COMPACTO ================= -->
                        <div class="report-main-header">
                            <table class="report-main-header-table">
                                <tr>
                                    <td style="width: 70%;">
                                        <div class="report-main-title">
                                            Orden de Reserva
                                            <span t-field="o.name" style="margin-left: 6px; color: #333;"/>
                                        </div>
                                    </td>
                                    <td style="width: 30%;">
                                        <div class="report-main-date">
                                            Impreso:
                                            <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- ================= ALERTA DE VENCIMIENTO ================= -->
                        <div class="expiration-alert row mb-3" t-if="o.fecha_expiracion and o.state not in ['done', 'cancel']">
                            <div class="col-12">
                                <div style="border: 3px solid #ff0000; background-color: #fff5f5; padding: 7px; width: 100%;">
                                    <div style="color: #ff0000; font-weight: 900; font-size: 14px; text-transform: uppercase; line-height: 1.1;">
                                        RESERVA CON VENCIMIENTO:
                                        <span t-field="o.fecha_expiracion" t-options='{"widget": "date"}'/>
                                    </div>
                                    <div style="color: #333; font-size: 10px; margin-top: 3px; font-style: italic; line-height: 1.15;">
                                        A partir de esa fecha, las placas se liberan automáticamente y podrán ser asignadas a otro proyecto sin previo aviso.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ================= INFORMACIÓN GENERAL ================= -->
                        <div class="info-block row mb-2" id="informations">
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Cliente</strong>
                                </div>
                                <div style="line-height: 1.2; padding-left: 2px;">
                                    <span style="font-weight: bold; font-size: 12px;" t-field="o.partner_id.name"/><br/>
                                    <span t-if="o.partner_id.vat">RFC: <span t-field="o.partner_id.vat"/></span>
                                </div>
                                <div class="mt-1" style="border-top: 1px dotted #9f9f9f; padding-top: 1px;">
                                    <strong style="font-size: 9px; text-transform: uppercase; color: #555; display: block;">Dirección de Entrega:</strong>
                                    <div style="font-size: 9px; color: #333; line-height: 1.1; margin-top: 2px; white-space: pre-line;">
                                        <span t-field="o.delivery_address"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Referencia</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-0 p-0" style="width: 100%;">
                                    <tr t-if="o.project_id">
                                        <td class="p-0" style="width: 30%;"><strong>Proyecto:</strong></td>
                                        <td class="p-0"><span t-field="o.project_id.name"/></td>
                                    </tr>
                                    <tr t-if="o.arquitecto_id">
                                        <td class="p-0"><strong>Arquitecto:</strong></td>
                                        <td class="p-0"><span t-field="o.arquitecto_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Vendedor:</strong></td>
                                        <td class="p-0"><span t-field="o.user_id.name"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Estado</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-1 p-0" style="width: 100%;">
                                    <tr>
                                        <td class="p-0"><strong>Fecha Emisión:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.fecha_orden" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Moneda:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.currency_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 pt-1"><strong>Estatus:</strong></td>
                                        <td class="p-0 pt-1 text-end">
                                            <span style="font-weight: 900; text-transform: uppercase;">
                                                <t t-if="o.state == 'draft'">Borrador</t>
                                                <t t-if="o.state == 'confirmed'">Confirmada</t>
                                                <t t-if="o.state == 'done'">Finalizada</t>
                                                <t t-if="o.state == 'cancel'">Cancelada</t>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="safe-spacer"></div>

                        <!-- ================= DETALLE POR LÍNEA ================= -->
                        <div class="detail-lines-wrapper">
                            <t t-foreach="o.hold_line_ids" t-as="line">
                                <div class="hold-line-card">
                                    <div class="hold-line-header">
                                        <table class="hold-line-summary-table">
                                            <tr>
                                                <td class="hold-line-product">
                                                    <span t-esc="line.product_id.display_name"/>
                                                </td>
                                                <td class="hold-line-summary">
                                                    <strong>Placas:</strong>
                                                    <span t-esc="len(line.lot_ids) if line.product_id.type != 'service' else '-'"/>
                                                    <span style="margin: 0 4px;">|</span>
                                                    <strong>m²:</strong>
                                                    <span t-esc="'%.2f' % (line.cantidad_m2 or 0.0)"/>
                                                    <span style="margin: 0 4px;">|</span>
                                                    <strong>Precio/m²:</strong>
                                                    <span t-esc="'%s %.2f' % ((o.currency_id.symbol or ''), (line.precio_unitario or 0.0))"/>
                                                    <span style="margin: 0 4px;">|</span>
                                                    <strong>Total:</strong>
                                                    <span t-esc="'%s %.2f' % ((o.currency_id.symbol or ''), (line.precio_total or 0.0))"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>

                                    <t t-if="line.product_id.type == 'service'">
                                        <div style="padding: 8px; font-size: 9px; color: #666; page-break-inside: avoid;">
                                            Línea de servicio. No aplica desglose por placas.
                                        </div>
                                    </t>

                                    <t t-if="line.product_id.type != 'service'">
                                        <table class="hold-lots-table">
                                            <thead>
                                                <tr>
                                                    <th class="col-index text-center">#</th>
                                                    <th class="col-lot">Lote</th>
                                                    <th class="col-bloque">Bloque</th>
                                                    <th class="col-atado">Atado</th>
                                                    <th class="col-placa">No. Placa</th>
                                                    <th class="col-color">Color</th>
                                                    <th class="col-grosor text-center">Grosor</th>
                                                    <th class="col-alto text-end">Alto</th>
                                                    <th class="col-ancho text-end">Ancho</th>
                                                    <th class="col-m2 text-end">m²</th>
                                                    <th class="col-subtotal text-end">Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="line.lot_ids" t-as="lot">
                                                    <t t-set="lot_m2" t-value="(lot.x_alto or 0.0) * (lot.x_ancho or 0.0)"/>
                                                    <t t-set="lot_subtotal" t-value="lot_m2 * (line.precio_unitario or 0.0)"/>
                                                    <tr>
                                                        <td class="text-center">
                                                            <span t-esc="lot_index + 1"/>
                                                        </td>
                                                        <td style="font-weight: 600;">
                                                            <span t-esc="lot.name or ''"/>
                                                        </td>
                                                        <td>
                                                            <span t-esc="lot.x_bloque or ''"/>
                                                        </td>
                                                        <td>
                                                            <span t-esc="lot.x_atado or ''"/>
                                                        </td>
                                                        <td>
                                                            <span t-esc="lot.x_numero_placa or ''"/>
                                                        </td>
                                                        <td>
                                                            <span t-esc="lot.x_color or ''"/>
                                                        </td>
                                                        <td class="text-center">
                                                            <span t-esc="lot.x_grosor or ''"/>
                                                        </td>
                                                        <td class="text-end nowrap">
                                                            <span t-esc="'%.4f' % (lot.x_alto or 0.0)"/>
                                                        </td>
                                                        <td class="text-end nowrap">
                                                            <span t-esc="'%.4f' % (lot.x_ancho or 0.0)"/>
                                                        </td>
                                                        <td class="text-end nowrap" style="font-weight: 600;">
                                                            <span t-esc="'%.2f' % lot_m2"/>
                                                        </td>
                                                        <td class="text-end nowrap">
                                                            <span t-esc="'%s %.2f' % ((o.currency_id.symbol or ''), lot_subtotal)"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                            <tfoot>
                                                <tr>
                                                    <td colspan="9" class="text-end">Total línea:</td>
                                                    <td class="text-end nowrap">
                                                        <span t-esc="'%.2f' % (line.cantidad_m2 or 0.0)"/>
                                                    </td>
                                                    <td class="text-end nowrap">
                                                        <span t-esc="'%s %.2f' % ((o.currency_id.symbol or ''), (line.precio_total or 0.0))"/>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <!-- ================= NOTAS ================= -->
                        <div t-if="o.notas" class="notes-block row mt-2">
                            <div class="col-12">
                                <div style="border: 1px dashed #ccc; padding: 8px; margin-top: 4px;">
                                    <strong style="font-size: 9px; text-transform: uppercase; color: #555;">Notas:</strong>
                                    <div style="font-size: 9px; white-space: pre-wrap;" t-esc="o.notas"/>
                                </div>
                            </div>
                        </div>

                        <!-- ================= TOTALES GENERALES ================= -->
                        <div class="totals-block row mt-2">
                            <div class="col-6"></div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size: 9px; border-top: 2px solid #000;">
                                    <tr style="font-weight: bold;">
                                        <td class="text-end">SUBTOTAL</td>
                                        <td class="text-end" style="width: 30%;">
                                            <span t-field="o.total_con_precio" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="font-weight: bold; color: #555;">
                                        <td class="text-end">IMPUESTOS (16%)</td>
                                        <td class="text-end">
                                            <span t-esc="o.total_con_precio * 0.16" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="font-weight: 900; font-size: 11px; border-top: 1px solid #ccc; background-color: #f1f1f1;">
                                        <td class="text-end pt-2 pb-2">TOTAL</td>
                                        <td class="text-end pt-2 pb-2">
                                            <span t-esc="o.total_con_precio * 1.16" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ================= FOOTER / FIRMAS ================= -->
                        <div class="signature-block" style="margin-top: 42px; width: 100%;">
                            <div class="row" style="margin-top: 32px; margin-bottom: 10px;">
                                <div class="col-1"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL VENDEDOR</strong>
                                    </div>
                                </div>
                                <div class="col-2"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL CLIENTE / ACEPTACIÓN</strong>
                                    </div>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-12 text-center">
                                    <p style="font-size: 9px; margin-top: 5px; padding: 0 20px;">
                                        Al firmar este documento, el cliente confirma la selección de las placas y acepta que la
                                        <span style="font-weight: bold;">
                                            RESERVA ES VÁLIDA SOLO HASTA EL
                                            <span t-field="o.fecha_expiracion" t-options='{"widget": "date"}'/>
                                        </span>.
                                        Para garantizar la disponibilidad del material, se recomienda formalizar antes de esa fecha.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="section-avoid">
                            <t t-set="company" t-value="o.company_id"/>
                            <t t-call="stock_lot_dimensions.company_bank_details_block"/>
                        </div>

                        <div class="terms-block row mt-2">
                            <div class="col-12">
                                <div style="border: 1px solid #ccc; padding: 8px; background-color: #fafafa;">
                                    <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                        Términos y Condiciones – Reserva de Material
                                    </strong>
                                    <div style="font-size: 8px; text-align: justify; color: #555;">
                                        <p style="margin: 0 0 3px 0;">• La reserva de material tiene una vigencia de 5 días hábiles a partir de la fecha de confirmación.</p>
                                        <p style="margin: 0 0 3px 0;">• Durante este periodo, el material quedará separado exclusivamente para el cliente.</p>
                                        <p style="margin: 0 0 3px 0;">• En caso de no recibir el pago total o parcial dentro del plazo establecido, la reserva se cancelará automáticamente y el material quedará disponible para venta.</p>
                                        <p style="margin: 0 0 3px 0;">• La reserva no congela precios en caso de variación del tipo de cambio; el precio final será el vigente al momento del pago.</p>
                                        <p style="margin: 0 0 3px 0;">• Pasado el periodo de reserva, la empresa no garantiza disponibilidad del material ni condiciones previamente cotizadas.</p>
                                        <p style="margin: 0;">• El mármol y granito pueden presentar variaciones naturales propias del material.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>