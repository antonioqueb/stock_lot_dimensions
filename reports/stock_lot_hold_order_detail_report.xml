<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_stock_lot_hold_order_detail" model="ir.actions.report">
        <field name="name">Orden de Reserva - Detalle</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_stock_lot_hold_order_detail</field>
        <field name="report_file">stock_lot_dimensions.report_stock_lot_hold_order_detail</field>
        <field name="print_report_name">'Reserva Detalle - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_lot_hold_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_stock_lot_hold_order_detail">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 11px; color: #111;">

                        <!-- ENCABEZADO -->
                        <div class="row mb-3">
                            <div class="col-8">
                                <h2 style="margin-bottom: 6px;">Orden de Reserva - Detalle</h2>
                                <div><strong>Folio:</strong> <span t-esc="o.name"/></div>
                                <div><strong>Cliente:</strong> <span t-esc="o.partner_id.display_name"/></div>
                                <div t-if="o.project_id">
                                    <strong>Proyecto:</strong> <span t-esc="o.project_id.display_name"/>
                                </div>
                                <div t-if="o.arquitecto_id">
                                    <strong>Arquitecto:</strong> <span t-esc="o.arquitecto_id.display_name"/>
                                </div>
                                <div t-if="o.user_id">
                                    <strong>Vendedor:</strong> <span t-esc="o.user_id.name"/>
                                </div>
                                <div t-if="o.delivery_address">
                                    <strong>Dirección de entrega:</strong> <span t-esc="o.delivery_address"/>
                                </div>
                            </div>

                            <div class="col-4">
                                <table class="table table-sm table-borderless" style="font-size: 10px; margin-bottom: 0;">
                                    <tr>
                                        <td class="p-0"><strong>Fecha:</strong></td>
                                        <td class="p-0 text-end">
                                            <span t-field="o.fecha_orden" t-options='{"widget": "datetime"}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Expira:</strong></td>
                                        <td class="p-0 text-end">
                                            <span t-field="o.fecha_expiracion" t-options='{"widget": "datetime"}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Moneda:</strong></td>
                                        <td class="p-0 text-end">
                                            <span t-esc="o.currency_id.name"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Estado:</strong></td>
                                        <td class="p-0 text-end">
                                            <t t-if="o.state == 'draft'">Borrador</t>
                                            <t t-elif="o.state == 'confirmed'">Confirmada</t>
                                            <t t-elif="o.state == 'done'">Finalizada</t>
                                            <t t-elif="o.state == 'cancel'">Cancelada</t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Total placas:</strong></td>
                                        <td class="p-0 text-end"><span t-esc="o.total_placas"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Total m²:</strong></td>
                                        <td class="p-0 text-end"><span t-esc="'%.2f' % (o.total_m2 or 0.0)"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Total general:</strong></td>
                                        <td class="p-0 text-end">
                                            <span t-esc="'%s %.2f' % ((o.currency_id.symbol or ''), (o.total_con_precio or 0.0))"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- RESUMEN POR PRODUCTO -->
                        <div class="mb-4" t-if="o.hold_line_ids">
                            <div style="border: 1px solid #000;">
                                <div style="padding: 6px 8px; background-color: #000; color: #fff; font-weight: bold; font-size: 10px; text-transform: uppercase;">
                                    Resumen por producto
                                </div>

                                <t t-set="product_summary" t-value="{}"/>
                                <t t-foreach="o.hold_line_ids" t-as="line">
                                    <t t-set="pid" t-value="line.product_id.id"/>

                                    <t t-if="pid not in product_summary">
                                        <t t-set="dummy" t-value="product_summary.update({
                                            pid: {
                                                'name': line.product_id.display_name,
                                                'type': line.product_id.type,
                                                'placas': 0,
                                                'm2': 0.0,
                                                'subtotal': 0.0
                                            }
                                        })"/>
                                    </t>

                                    <t t-set="placas_linea" t-value="len(line.lot_ids) if line.product_id.type != 'service' else 0"/>
                                    <t t-set="dummy" t-value="product_summary[pid].update({
                                        'placas': product_summary[pid]['placas'] + placas_linea,
                                        'm2': product_summary[pid]['m2'] + (line.cantidad_m2 or 0.0),
                                        'subtotal': product_summary[pid]['subtotal'] + (line.precio_total or 0.0)
                                    })"/>
                                </t>

                                <table class="table table-sm mb-0" style="font-size: 9px; width: 100%;">
                                    <thead>
                                        <tr style="border-bottom: 1px solid #000;">
                                            <th style="padding: 5px;">Producto</th>
                                            <th class="text-center" style="padding: 5px; width: 90px;">Placas</th>
                                            <th class="text-end" style="padding: 5px; width: 110px;">m²</th>
                                            <th class="text-end" style="padding: 5px; width: 130px;">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="product_summary.values()" t-as="data">
                                            <tr style="border-bottom: 1px solid #ddd;">
                                                <td style="padding: 5px;">
                                                    <strong t-esc="data['name']"/>
                                                    <t t-if="data['type'] == 'service'">
                                                        <span style="font-style: italic; color: #777;"> (Servicio)</span>
                                                    </t>
                                                </td>
                                                <td class="text-center" style="padding: 5px;">
                                                    <t t-if="data['type'] != 'service'">
                                                        <span t-esc="data['placas']"/>
                                                    </t>
                                                    <t t-else="">-</t>
                                                </td>
                                                <td class="text-end" style="padding: 5px;">
                                                    <span t-esc="'%.2f' % (data['m2'] or 0.0)"/>
                                                </td>
                                                <td class="text-end" style="padding: 5px;">
                                                    <span t-esc="'%s %.2f' % ((o.currency_id.symbol or ''), (data['subtotal'] or 0.0))"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr style="border-top: 2px solid #000; font-weight: bold;">
                                            <td class="text-end" style="padding: 6px;">Totales</td>
                                            <td class="text-center" style="padding: 6px;">
                                                <span t-esc="o.total_placas"/>
                                            </td>
                                            <td class="text-end" style="padding: 6px;">
                                                <span t-esc="'%.2f' % (o.total_m2 or 0.0)"/>
                                            </td>
                                            <td class="text-end" style="padding: 6px;">
                                                <span t-esc="'%s %.2f' % ((o.currency_id.symbol or ''), (o.total_con_precio or 0.0))"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <!-- DETALLE POR LÍNEA -->
                        <t t-foreach="o.hold_line_ids" t-as="line">
                            <div style="margin-bottom: 16px; border: 1px solid #bbb;">
                                <div style="padding: 6px 8px; background: #f3f3f3; border-bottom: 1px solid #bbb;">
                                    <div class="row">
                                        <div class="col-7">
                                            <strong t-esc="line.product_id.display_name"/>
                                        </div>
                                        <div class="col-5 text-end">
                                            <strong>m²:</strong>
                                            <span t-esc="'%.2f' % (line.cantidad_m2 or 0.0)"/>
                                            &nbsp;&nbsp;|&nbsp;&nbsp;
                                            <strong>Total:</strong>
                                            <span t-esc="'%s %.2f' % ((o.currency_id.symbol or ''), (line.precio_total or 0.0))"/>
                                        </div>
                                    </div>
                                </div>

                                <t t-if="line.product_id.type == 'service'">
                                    <div style="padding: 8px; font-size: 9px; color: #666;">
                                        Línea de servicio. No aplica desglose por placas.
                                    </div>
                                </t>

                                <t t-if="line.product_id.type != 'service'">
                                    <table class="table table-sm mb-0" style="font-size: 8.5px; width: 100%;">
                                        <thead>
                                            <tr style="border-bottom: 1px solid #000;">
                                                <th style="padding: 4px; width: 35px;">#</th>
                                                <th style="padding: 4px;">Lote</th>
                                                <th style="padding: 4px;">Bloque</th>
                                                <th style="padding: 4px;">No. placa</th>
                                                <th style="padding: 4px;">Color</th>
                                                <th style="padding: 4px;">Grosor</th>
                                                <th class="text-end" style="padding: 4px;">Alto</th>
                                                <th class="text-end" style="padding: 4px;">Ancho</th>
                                                <th class="text-end" style="padding: 4px;">m²</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="line.lot_ids" t-as="lot">
                                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                                    <td class="text-center" style="padding: 4px;">
                                                        <span t-esc="line.lot_ids.ids.index(lot.id) + 1"/>
                                                    </td>
                                                    <td style="padding: 4px;"><span t-esc="lot.name or ''"/></td>
                                                    <td style="padding: 4px;"><span t-esc="lot.x_bloque or ''"/></td>
                                                    <td style="padding: 4px;"><span t-esc="lot.x_numero_placa or ''"/></td>
                                                    <td style="padding: 4px;"><span t-esc="lot.x_color or ''"/></td>
                                                    <td style="padding: 4px;"><span t-esc="lot.x_grosor or ''"/></td>
                                                    <td class="text-end" style="padding: 4px;">
                                                        <span t-esc="'%.4f' % (lot.x_alto or 0.0)"/>
                                                    </td>
                                                    <td class="text-end" style="padding: 4px;">
                                                        <span t-esc="'%.4f' % (lot.x_ancho or 0.0)"/>
                                                    </td>
                                                    <td class="text-end" style="padding: 4px;">
                                                        <span t-esc="'%.2f' % (((lot.x_alto or 0.0) * (lot.x_ancho or 0.0)))"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot>
                                            <tr style="border-top: 1px solid #000; font-weight: bold;">
                                                <td colspan="8" class="text-end" style="padding: 5px;">Total línea:</td>
                                                <td class="text-end" style="padding: 5px;">
                                                    <span t-esc="'%.2f' % (line.cantidad_m2 or 0.0)"/>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </t>
                            </div>
                        </t>

                        <div t-if="o.notas" style="margin-top: 12px;">
                            <strong>Notas:</strong>
                            <div t-esc="o.notas"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>