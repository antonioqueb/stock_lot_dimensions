<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_stock_lot_hold_order_detail" model="ir.actions.report">
        <field name="name">Orden de Reserva - Detalle</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_stock_lot_hold_order_detail_document</field>
        <field name="report_file">stock_lot_dimensions.report_stock_lot_hold_order_detail_document</field>
        <field name="print_report_name">'Reserva Detalle - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_lot_hold_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_stock_lot_hold_order_detail_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">
                        
                        <!-- ENCABEZADO SIMPLE -->
                        <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                            <div class="col-12">
                                <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                                    Orden de Reserva <span t-field="o.name" style="margin-left: 10px; color: #333;"/>
                                </h4>
                                <div style="font-size: 8px; color: #999; margin-top: 4px;">
                                    Impreso: <span t-esc="doc.env['ir.qweb.field.datetime'].value_to_html(datetime.datetime.now(), {'format': 'dd/MM/yyyy HH:mm', 'tz_name': doc.env.user.tz})"/>
                                </div>
                            </div>
                        </div>

                        <!-- ALERTA VENCIMIENTO -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div style="border: 4px solid #ff0000; background-color: #fff5f5; padding: 8px; width: 100%;">
                                    <div style="color: #ff0000; font-weight: 900; font-size: 16px; text-transform: uppercase;">
                                        ⚠️ RESERVA CON VENCIMIENTO: <span t-field="o.fecha_expiracion" t-options='{"widget": "date"}'/>
                                    </div>
                                    <div style="color: #333; font-size: 12px; margin-top: 3px; font-style: italic;">
                                       A partir de esa fecha, las placas se liberan automáticamente y podrán ser asignadas a otro proyecto sin previo aviso.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACIÓN GENERAL -->
                        <div class="row mb-2">
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Cliente</strong>
                                </div>
                                <div style="line-height: 1.2; padding-left: 2px;">
                                    <span style="font-weight: bold; font-size: 12px;" t-field="o.partner_id.name"/><br/>
                                    <span t-if="o.partner_id.vat">RFC: <span t-field="o.partner_id.vat"/></span>
                                </div>
                                <div class="mt-1" style="border-top: 1px dotted #9f9f9fff; padding-top: 1px;">
                                    <strong style="font-size: 10px; text-transform: uppercase; color: #555; display: block; margin-bottom: 0px;">Dirección de Entrega:</strong>
                                    <div style="font-size: 10px; color: #333; line-height: 0.6; white-space: pre-line; margin-top: 0px;">
                                        <span t-field="o.delivery_address"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Referencia</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-0 p-0" style="width: 100%;">
                                    <tr t-if="o.project_id">
                                        <td class="p-0" style="width: 30%; padding: 2px 5px !important;"><strong>Proyecto:</strong></td>
                                        <td class="p-0" style="padding: 2px 5px !important;"><span t-field="o.project_id.name"/></td>
                                    </tr>
                                    <tr t-if="o.arquitecto_id">
                                        <td class="p-0" style="padding: 2px 5px !important;"><strong>Arquitecto:</strong></td>
                                        <td class="p-0" style="padding: 2px 5px !important;"><span t-field="o.arquitecto_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0" style="padding: 2px 5px !important;"><strong>Vendedor:</strong></td>
                                        <td class="p-0" style="padding: 2px 5px !important;"><span t-field="o.user_id.name"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Estado</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-1 p-0" style="width: 100%;">
                                    <tr>
                                        <td class="p-0" style="padding: 2px 5px !important;"><strong>Fecha Emisión:</strong></td>
                                        <td class="p-0 text-end" style="padding: 2px 5px !important;"><span t-field="o.fecha_orden" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0" style="padding: 2px 5px !important;"><strong>Moneda:</strong></td>
                                        <td class="p-0 text-end" style="padding: 2px 5px !important;"><span t-field="o.currency_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 pt-1" style="padding: 2px 5px !important;"><strong>Estatus:</strong></td>
                                        <td class="p-0 pt-1 text-end" style="padding: 2px 5px !important;">
                                            <span style="font-weight: 900; text-transform: uppercase;">
                                                <t t-if="o.state == 'draft'">Borrador</t>
                                                <t t-if="o.state == 'confirmed'">Confirmada</t>
                                                <t t-if="o.state == 'done'">Finalizada</t>
                                                <t t-if="o.state == 'cancel'">Cancelada</t>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ============================================================ -->
                        <!-- SEPARACIÓN DE MATERIALES Y SERVICIOS -->
                        <!-- ============================================================ -->
                        <t t-set="materials" t-value="o.hold_line_ids.filtered(lambda l: l.product_id.type != 'service').sorted(key=lambda l: l.product_id.display_name)"/>
                        <t t-set="services" t-value="o.hold_line_ids.filtered(lambda l: l.product_id.type == 'service')"/>

                        <!-- TABLA DETALLADA DE MATERIALES -->
                        <div t-if="materials">
                            <div class="mt-3 mb-1">
                                <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Materiales</strong>
                            </div>
                            <table class="table table-sm table-striped" style="width: 100%; font-size: 9px; border-collapse: collapse;">
                                <thead>
                                    <tr style="border-bottom: 2px solid #000; color: #000; background-color: #000;">
                                        <th class="text-center" style="width: 3%; color: #fff; font-weight: bold; padding: 4px;">#</th>
                                        <th style="width: 12%; color: #fff; font-weight: bold; padding: 4px;">LOTE</th>
                                        <th style="width: 8%; color: #fff; font-weight: bold; padding: 4px;">BLOQUE</th>
                                        <th style="width: 8%; color: #fff; font-weight: bold; padding: 4px;">ATADO</th>
                                        <th style="width: 8%; color: #fff; font-weight: bold; padding: 4px;">COLOR</th>
                                        <th class="text-center" style="width: 5%; color: #fff; font-weight: bold; padding: 4px;">GROSOR</th>
                                        <th class="text-center" style="width: 5%; color: #fff; font-weight: bold; padding: 4px;">ALTO</th>
                                        <th class="text-center" style="width: 5%; color: #fff; font-weight: bold; padding: 4px;">ANCHO</th>
                                        <th class="text-end" style="width: 8%; color: #fff; font-weight: bold; padding: 4px;">m²</th>
                                        <th class="text-end" style="width: 8%; color: #fff; font-weight: bold; padding: 4px;">PRECIO/m²</th>
                                        <th class="text-end" style="width: 10%; color: #fff; font-weight: bold; padding: 4px;">SUBTOTAL</th>
                                        <th class="text-end" style="width: 10%; color: #fff; font-weight: bold; padding: 4px;">IVA (16%)</th>
                                        <th class="text-end" style="width: 12%; color: #fff; font-weight: bold; padding: 4px;">TOTAL</th>
                                    </tr>
                                </thead>
                                <tbody style="border-bottom: 1px solid #000;">
                                    <t t-set="seq" t-value="1"/>
                                    <t t-set="current_product" t-value="None"/>
                                    
                                    <t t-foreach="materials" t-as="line">
                                        <t t-if="current_product != line.product_id.id">
                                            <t t-set="current_product" t-value="line.product_id.id"/>
                                            <tr style="background-color: #000000; color: #FFFFFF;">
                                                <td colspan="12" style="padding: 4px 8px; font-weight: bold; font-size: 10px; text-transform: uppercase; color: #FFFFFF;">
                                                    <span t-field="line.product_id.display_name"/>
                                                </td>
                                            </tr>
                                        </t>
                                        
                                        <tr>
                                            <td class="text-center align-middle" style="padding: 2px 5px;">
                                                <span t-esc="seq"/>
                                                <t t-set="seq" t-value="seq + 1"/>
                                            </td>
                                            <td class="align-middle" style="padding: 2px 5px;">
                                                <strong t-field="line.lot_id.name"/>
                                            </td>
                                            <td class="align-middle" style="padding: 2px 5px;">
                                                <span t-field="line.lot_id.x_bloque"/>
                                            </td>
                                            <td class="align-middle" style="padding: 2px 5px;">
                                                <span t-field="line.lot_id.x_atado"/>
                                            </td>
                                            <td class="align-middle" style="padding: 2px 5px;">
                                                <span t-field="line.lot_id.x_color"/>
                                            </td>
                                            <td class="text-center align-middle" style="padding: 2px 5px;">
                                                <span t-field="line.x_grosor" t-options='{"precision": 2}'/>
                                            </td>
                                            <td class="text-center align-middle" style="padding: 2px 5px;">
                                                <span t-field="line.x_alto" t-options='{"precision": 3}'/>
                                            </td>
                                            <td class="text-center align-middle" style="padding: 2px 5px;">
                                                <span t-field="line.x_ancho" t-options='{"precision": 3}'/>
                                            </td>
                                            <td class="text-end align-middle" style="padding: 2px 5px;">
                                                <strong t-field="line.cantidad_m2" t-options='{"precision": 2}'/>
                                            </td>
                                            <td class="text-end align-middle" style="padding: 2px 5px;">
                                                <span t-if="line.precio_unitario" t-field="line.precio_unitario" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                                <span t-else="">-</span>
                                            </td>
                                            <td class="text-end align-middle" style="padding: 2px 5px;">
                                                <strong t-if="line.precio_total" t-field="line.precio_total" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                                <span t-else="">-</span>
                                            </td>
                                            <td class="text-end align-middle" style="color: #555; padding: 2px 5px;">
                                                <span t-if="line.precio_total" t-esc="line.precio_total * 0.16" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                                <span t-else="">-</span>
                                            </td>
                                            <td class="text-end align-middle" style="padding: 2px 5px;">
                                                <strong t-if="line.precio_total" t-esc="line.precio_total * 1.16" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                                <span t-else="">-</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- TABLA DETALLADA DE SERVICIOS -->
                        <div t-if="services" style="margin-top: 20px;">
                            <div class="mb-1">
                                <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Servicios Adicionales</strong>
                            </div>
                            <table class="table table-sm table-striped" style="width: 100%; font-size: 9px; border-collapse: collapse; border-bottom: 1px solid #000;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #ccc; color: #fff; background-color: #000;">
                                        <th style="width: 40%; color: #fff; font-weight: bold; padding: 4px;">DESCRIPCIÓN</th>
                                        <th class="text-end" style="width: 10%; color: #fff; font-weight: bold; padding: 4px;">CANTIDAD</th>
                                        <th class="text-end" style="width: 15%; color: #fff; font-weight: bold; padding: 4px;">PRECIO UNIT.</th>
                                        <th class="text-end" style="width: 12%; color: #fff; font-weight: bold; padding: 4px;">SUBTOTAL</th>
                                        <th class="text-end" style="width: 10%; color: #fff; font-weight: bold; padding: 4px;">IVA (16%)</th>
                                        <th class="text-end" style="width: 13%; color: #fff; font-weight: bold; padding: 4px;">TOTAL</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="services" t-as="line">
                                        <td class="align-middle" style="padding: 2px 5px;">
                                            <span t-field="line.product_id.display_name"/>
                                        </td>
                                        <td class="text-end align-middle" style="padding: 2px 5px;">
                                            <span t-field="line.cantidad_m2" t-options='{"precision": 2}'/>
                                        </td>
                                        <td class="text-end align-middle" style="padding: 2px 5px;">
                                            <span t-field="line.precio_unitario" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                        </td>
                                        <td class="text-end align-middle" style="padding: 2px 5px;">
                                            <span t-field="line.precio_total" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                        </td>
                                        <td class="text-end align-middle" style="color: #555; padding: 2px 5px;">
                                            <span t-esc="line.precio_total * 0.16" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                        </td>
                                        <td class="text-end align-middle" style="padding: 2px 5px;">
                                            <strong t-esc="line.precio_total * 1.16" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- TOTALES GENERALES (VERTICAL - ESTILO FACTURA) -->
                        <div class="clearfix" name="total_summary">
                            <div id="total" class="row" name="total">
                                <div class="col-6">
                                    <!-- Espacio vacío a la izquierda -->
                                </div>
                                <div class="col-6">
                                    <table class="table table-sm" style="font-size: 10px; margin-top: 15px;">
                                       
                                        
                                        <!-- Subtotal -->
                                        <tr class="border-black o_subtotal" style="">
                                            <td class="border-0"><strong>Subtotal</strong></td>
                                            <td class="text-end border-0">
                                                <span t-field="o.total_con_precio" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        
                                        <!-- IVA -->
                                        <tr>
                                            <td class="border-0">Impuestos (16%)</td>
                                            <td class="text-end border-0">
                                                <span t-esc="o.total_con_precio * 0.16" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                        
                                        <!-- Total General -->
                                        <tr class="border-black o_total">
                                            <td class="border-top border-dark"><strong>Total</strong></td>
                                            <td class="text-end border-top border-dark">
                                                <strong style="font-size: 12px;">
                                                    <span t-esc="o.total_con_precio * 1.16" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- FIRMAS Y TÉRMINOS -->
                        <div style="page-break-inside: avoid;">
                            <div class="row" style="margin-top: 40px; margin-bottom: 10px;">
                                <div class="col-1"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL VENDEDOR</strong>
                                    </div>
                                </div>
                                <div class="col-2"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL CLIENTE / ACEPTACIÓN DE LA RESERVA</strong>
                                    </div>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <!-- LEYENDA DE ACEPTACIÓN DE VENCIMIENTO -->
                            <div class="row mb-3">
                                <div class="col-12 text-center">
                                    <p style="font-size: 9px; margin-top: 5px; padding: 0 20px;">
                                        Al firmar este documento, el cliente confirma la selección de las placas y acepta que la <span style="font-weight: bold;">RESERVA ES VÁLIDA SOLO HASTA EL <span t-field="o.fecha_expiracion" t-options='{"widget": "date"}'/></span>. Para garantizar la disponibilidad del material en su proyecto, se recomienda firmar y formalizar las condiciones comerciales antes de esa fecha.
                                    </p>
                                </div>
                            </div>

                            <!-- TÉRMINOS SIMPLIFICADOS (Caja Gris) -->
                            <div class="row mt-2">
                                <div class="col-12">
                                    <div style="border: 1px solid #ccc; padding: 8px; background-color: #fafafa;">
                                        <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                            Términos y Condiciones Generales
                                        </strong>
                                        <ul class="list-unstyled mb-0" style="font-size: 8px; text-align: justify; color: #555;">
                                            <li class="mb-1">1. <strong>MATERIAL NATURAL:</strong> Las piedras naturales son productos de la naturaleza y están sujetas a variaciones de tono, veta y textura.</li>
                                            <li class="mb-1">2. <strong>DIMENSIONES:</strong> Las medidas son nominales y pueden presentar variaciones mínimas.</li>
                                            <li>3. <strong>ACEPTACIÓN:</strong> La firma constituye la aceptación del material en el estado en que se encuentra.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center text-muted mt-2" style="font-size: 7px;">
                                Documento Interno | Página <span class="page"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>