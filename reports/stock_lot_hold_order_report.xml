<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_stock_lot_hold_order" model="ir.actions.report">
        <field name="name">Orden de Reserva (Valuada)</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_stock_lot_hold_order_document</field>
        <field name="report_file">stock_lot_dimensions.report_stock_lot_hold_order_document</field>
        <field name="print_report_name">'Reserva - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_lot_hold_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_stock_lot_hold_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <!-- Contenedor Principal: Fuente condensada y negra para máximo contraste -->
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #000;">
                        
                        <!-- 1. CABECERA -->
                        <div class="row border-bottom pb-2 mb-3" style="border-color: #000 !important;">
                            <div class="col-8">
                                <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                                    Orden de Reserva
                                </h4>
                            </div>
                            <div class="col-4 text-end">
                                <h4 class="mb-0" style="font-weight: 600;">
                                    <span t-field="o.name"/>
                                </h4>
                            </div>
                        </div>

                        <!-- 2. INFORMACIÓN GENERAL (3 Columnas) -->
                        <div class="row mb-3">
                            <!-- Cliente -->
                            <div class="col-4">
                                <div class="mb-1 border-bottom border-secondary pb-1">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Cliente</strong>
                                </div>
                                <div style="line-height: 1.3;">
                                    <span style="font-weight: bold; font-size: 12px;" t-field="o.partner_id.name"/><br/>
                                    <span t-if="o.partner_id.vat">RFC: <span t-field="o.partner_id.vat"/></span>
                                    <div t-if="o.partner_id.street or o.partner_id.city" class="mt-1" style="font-size: 10px;">
                                        <span t-if="o.partner_id.street" t-field="o.partner_id.street"/>
                                        <span t-if="o.partner_id.city">, <span t-field="o.partner_id.city"/></span>
                                        <span t-if="o.partner_id.zip"> C.P. <span t-field="o.partner_id.zip"/></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Referencia -->
                            <div class="col-4">
                                <div class="mb-1 border-bottom border-secondary pb-1">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Referencia</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-0 p-0">
                                    <tr t-if="o.project_id">
                                        <td class="p-0" style="width: 30%;"><strong>Proyecto:</strong></td>
                                        <td class="p-0"><span t-field="o.project_id.name"/></td>
                                    </tr>
                                    <tr t-if="o.arquitecto_id">
                                        <td class="p-0"><strong>Arquitecto:</strong></td>
                                        <td class="p-0"><span t-field="o.arquitecto_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Vendedor:</strong></td>
                                        <td class="p-0"><span t-field="o.user_id.name"/></td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Fechas -->
                            <div class="col-4">
                                <div class="mb-1 border-bottom border-secondary pb-1">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Vigencia</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-0 p-0">
                                    <tr>
                                        <td class="p-0"><strong>Emisión:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.fecha_orden" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Expira:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.fecha_expiracion" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 pt-1"><strong>Estado:</strong></td>
                                        <td class="p-0 pt-1 text-end">
                                            <span style="font-weight: 900; text-transform: uppercase;">
                                                <t t-if="o.state == 'draft'">Borrador</t>
                                                <t t-if="o.state == 'confirmed'">Confirmada</t>
                                                <t t-if="o.state == 'done'">Finalizada</t>
                                                <t t-if="o.state == 'cancel'">Cancelada</t>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- 3. TABLA DE PRODUCTOS Y PRECIOS -->
                        <!-- Se usa font-size: 10px para que quepan las columnas de precio -->
                        <table class="table table-sm table-striped mt-3" style="width: 100%; font-size: 10px; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 2px solid #000; color: #000;">
                                    <th class="text-center" style="width: 5%;">#</th>
                                    <th style="width: 20%;">Lote / Serie</th>
                                    <th style="width: 30%;">Producto</th>
                                    <th class="text-center" style="width: 7%;">Grosor</th>
                                    <th class="text-center" style="width: 7%;">Alto</th>
                                    <th class="text-center" style="width: 7%;">Ancho</th>
                                    <th class="text-end" style="width: 6%;">m²</th>
                                    <!-- Nuevas Columnas de Precio -->
                                    <th class="text-end" style="width: 9%;">P. Unitario</th>
                                    <th class="text-end" style="width: 9%;">Total</th>
                                </tr>
                            </thead>
                            <tbody style="border-bottom: 1px solid #000;">
                                <t t-set="seq" t-value="1"/>
                                <tr t-foreach="o.hold_line_ids" t-as="line">
                                    <td class="text-center align-middle">
                                        <span t-esc="seq"/>
                                        <t t-set="seq" t-value="seq + 1"/>
                                    </td>
                                    <td class="align-middle">
                                        <strong t-field="line.lot_id.name"/>
                                    </td>
                                    <td class="align-middle">
                                        <span t-field="line.product_id.display_name"/>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span t-field="line.x_grosor" t-options='{"precision": 2}'/>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span t-field="line.x_alto" t-options='{"precision": 2}'/>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span t-field="line.x_ancho" t-options='{"precision": 2}'/>
                                    </td>
                                    <td class="text-end align-middle">
                                        <span t-field="line.cantidad_m2" t-options='{"precision": 2}'/>
                                    </td>
                                    <!-- Precio Unitario (Asegúrate que el campo 'price_unit' exista en tu modelo) -->
                                    <td class="text-end align-middle">
                                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <!-- Total de la Línea (Asegúrate que exista un campo calculado o price_subtotal) -->
                                    <td class="text-end align-middle fw-bold">
                                        <span t-field="line.price_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- 4. TOTALES Y RESUMEN (Diseño compacto a la derecha) -->
                        <div class="row mt-0">
                            <div class="col-7">
                                <!-- Espacio vacío para balance visual -->
                                <div class="pt-2">
                                    <strong style="font-size: 10px;">RESUMEN FÍSICO:</strong><br/>
                                    <span style="font-size: 10px;">Total Piezas: <span t-field="o.total_placas"/> | Total m²: <span t-field="o.total_m2"/></span>
                                </div>
                            </div>
                            <div class="col-5">
                                <table class="table table-sm table-borderless mb-0" style="font-size: 11px;">
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td class="text-end"><strong>Subtotal:</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <!-- Si tienes campo de impuestos, descomenta esto:
                                    <tr>
                                        <td class="text-end">Impuestos:</td>
                                        <td class="text-end"><span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    </tr> 
                                    -->
                                    <tr style="border-top: 2px solid #000;">
                                        <td class="text-end" style="vertical-align: bottom;">
                                            <strong style="font-size: 12px;">TOTAL:</strong><br/>
                                            <small style="font-size: 8px; font-style: italic;">(Precios antes de Impuestos)</small>
                                        </td>
                                        <td class="text-end" style="vertical-align: bottom;">
                                            <strong style="font-size: 13px;">
                                                <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- 5. TÉRMINOS Y CONDICIONES (Legal - Destacado) -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div style="border: 1px solid #000; padding: 8px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Términos y Condiciones de la Reserva</strong>
                                    <ul style="font-size: 9px; margin-bottom: 0; padding-left: 15px; margin-top: 4px;">
                                        <li>El material listado se encuentra reservado exclusivamente hasta la fecha de vencimiento indicada.</li>
                                        <li>Una vez vencido el plazo, la empresa se reserva el derecho de liberar el material para venta general sin previo aviso.</li>
                                        <li>Los precios mostrados <strong>NO incluyen I.V.A.</strong> a menos que se especifique lo contrario.</li>
                                        <li>Las dimensiones (m²) son nominales y pueden tener ligeras variaciones naturales. Se recomienda inspección física.</li>
                                        <li>Cualquier cambio en el pedido puede modificar los precios finales pactados.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- 6. FIRMAS -->
                        <div class="row" style="margin-top: 40px; margin-bottom: 20px;">
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #000; width: 80%; margin: 0 auto;"></div>
                                <div class="mt-1">
                                    <strong style="font-size: 10px;">POR LA EMPRESA</strong><br/>
                                    <span style="font-size: 9px;" t-field="o.user_id.name"/>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #000; width: 80%; margin: 0 auto;"></div>
                                <div class="mt-1">
                                    <strong style="font-size: 10px;">ACEPTACIÓN CLIENTE</strong><br/>
                                    <span style="font-size: 9px;">Nombre y Firma</span>
                                </div>
                            </div>
                        </div>

                        <!-- 7. OBSERVACIONES (Al final de la hoja) -->
                        <t t-if="o.notas">
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div style="background-color: #f8f9fa; border-left: 4px solid #333; padding: 10px;">
                                        <strong style="font-size: 10px; text-transform: uppercase;">Observaciones Adicionales:</strong>
                                        <p style="font-size: 10px; margin-top: 5px; margin-bottom: 0; white-space: pre-wrap;">
                                            <span t-field="o.notas"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Pie de página técnico -->
                        <div class="text-center text-muted mt-4 pt-2" style="font-size: 8px; border-top: 1px solid #ddd;">
                            Documento Interno de Control | Impreso: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/> | Pag. <span class="page"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>