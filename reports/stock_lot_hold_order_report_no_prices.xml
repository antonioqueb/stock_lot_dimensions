<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- ACCIÓN: REPORTE DE RESERVA - COMPLETO (SIN PRECIOS) -->
    <!-- ======================================================= -->
    <record id="action_report_stock_lot_hold_order_no_prices" model="ir.actions.report">
        <field name="name">Orden de Reserva - Completo (Sin Precios)</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_stock_lot_hold_order_document_no_prices</field>
        <field name="report_file">stock_lot_dimensions.report_stock_lot_hold_order_document_no_prices</field>
        <field name="print_report_name">'Reserva Sin Precios - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_lot_hold_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ======================================================= -->
    <!-- PLANTILLA: COMPLETO SIN PRECIOS CON RESUMEN UNIFICADO -->
    <!-- ======================================================= -->
    <template id="report_stock_lot_hold_order_document_no_prices">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    
                    <!-- 1. OCULTAR CABECERAS ESTÁNDAR DE ODOO -->
                    <t t-set="address" t-value="False"/>
                    <t t-set="information_block" t-value="False"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">
                        
                        <!-- ================= ENCABEZADO SIMPLE ================= -->
                        <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                            <div class="col-8">
                                <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                                    Orden de Reserva (Sin Precios) <span t-field="o.name" style="margin-left: 10px; color: #333;"/>
                                </h4>
                            </div>
                            <div class="col-4 text-end">
                                <div style="font-size: 8px; color: #999; margin-top: 4px;">
                                    Impreso: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                </div>
                            </div>
                        </div>

                        <!-- NUEVO BLOQUE DE ALERTA (VENCIMIENTO) -->
                        <div class="row mb-4" t-if="o.fecha_expiracion and o.state not in ['done', 'cancel']">
                            <div class="col-12">
                                <div style="border: 4px solid #ff0000; background-color: #fff5f5; padding: 8px; width: 100%;">
                                    <div style="color: #ff0000; font-weight: 900; font-size: 16px; text-transform: uppercase;">
                                        ⚠️ RESERVA CON VENCIMIENTO: <span t-field="o.fecha_expiracion" t-options='{"widget": "date"}'/>
                                    </div>
                                    <div style="color: #333; font-size: 12px; margin-top: 3px; font-style: italic;">
                                        ⏱️ A partir de esa fecha, las placas se liberan automáticamente y podrán ser asignadas a otro proyecto sin previo aviso.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ================= INFORMACIÓN GENERAL ================= -->
                        <div class="row mb-3">
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Cliente</strong>
                                </div>
                                <div style="line-height: 1.2; padding-left: 2px;">
                                    <span style="font-weight: bold; font-size: 12px;" t-field="o.partner_id.name"/><br/>
                                    <span t-if="o.partner_id.vat">RFC: <span t-field="o.partner_id.vat"/></span>
                                </div>
                                <div class="mt-1" style="border-top: 1px dotted #9f9f9fff; padding-top: 1px;">
                                    <strong style="font-size: 9px; text-transform: uppercase; color: #555; display: block; margin-bottom: 0px;">Dirección de Entrega:</strong>
                                    <div style="font-size: 9px; color: #333; line-height: 1.1; white-space: pre-line; margin-top: 2px;">
                                        <span t-field="o.delivery_address"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Referencia</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-0 p-0" style="width: 100%;">
                                    <tr t-if="o.project_id">
                                        <td class="p-0" style="width: 30%; padding: 2px 5px !important;"><strong>Proyecto:</strong></td>
                                        <td class="p-0" style="padding: 2px 5px !important;"><span t-field="o.project_id.name"/></td>
                                    </tr>
                                    <tr t-if="o.arquitecto_id">
                                        <td class="p-0" style="padding: 2px 5px !important;"><strong>Arquitecto:</strong></td>
                                        <td class="p-0" style="padding: 2px 5px !important;"><span t-field="o.arquitecto_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0" style="padding: 2px 5px !important;"><strong>Vendedor:</strong></td>
                                        <td class="p-0" style="padding: 2px 5px !important;"><span t-field="o.user_id.name"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Estado</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-1 p-0" style="width: 100%;">
                                    <tr>
                                        <td class="p-0" style="padding: 2px 5px !important;"><strong>Fecha Emisión:</strong></td>
                                        <td class="p-0 text-end" style="padding: 2px 5px !important;"><span t-field="o.fecha_orden" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 pt-1" style="padding: 2px 5px !important;"><strong>Estatus:</strong></td>
                                        <td class="p-0 pt-1 text-end" style="padding: 2px 5px !important;">
                                            <span style="font-weight: 900; text-transform: uppercase;">
                                                <t t-if="o.state == 'draft'">Borrador</t>
                                                <t t-if="o.state == 'confirmed'">Confirmada</t>
                                                <t t-if="o.state == 'done'">Finalizada</t>
                                                <t t-if="o.state == 'cancel'">Cancelada</t>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ============================================================ -->
                        <!-- SEPARACIÓN DE MATERIALES Y SERVICIOS -->
                        <!-- ============================================================ -->
                        <t t-set="materials" t-value="o.hold_line_ids.filtered(lambda l: l.product_id.type != 'service').sorted(key=lambda l: l.product_id.display_name)"/>
                        <t t-set="services" t-value="o.hold_line_ids.filtered(lambda l: l.product_id.type == 'service')"/>

                        <!-- ================= RESUMEN ÚNICO (TODO AGRUPADO SIN PRECIOS) ================= -->
                        <div class="row mt-2 mb-3" t-if="o.hold_line_ids">
                            <div class="col-12">
                                <div style="border: 1px solid #ddd; padding: 0; background-color: #f9f9f9;">
                                    <strong style="font-size: 9px; text-transform: uppercase; color: #555; display: block; margin: 5px 5px 5px 5px;">
                                        Resumen General (Materiales, Importación y Servicios)
                                    </strong>
                                    
                                    <!-- Cálculo de Agrupación -->
                                    <t t-set="product_summary" t-value="{}"/>
                                    <t t-foreach="o.hold_line_ids" t-as="line">
                                        <t t-set="pid" t-value="line.product_id.id"/>
                                        <t t-if="pid not in product_summary">
                                            <t t-set="dummy" t-value="product_summary.update({pid: {
                                                'name': line.product_id.display_name,
                                                'type': line.product_id.type,
                                                'placas': 0,
                                                'm2': 0.0
                                            }})"/>
                                        </t>
                                        <!-- Solo contamos placas si es material físico -->
                                        <t t-set="is_plate" t-value="1 if line.lot_id else 0"/>
                                        <t t-set="dummy" t-value="product_summary[pid].update({
                                            'placas': product_summary[pid]['placas'] + is_plate,
                                            'm2': product_summary[pid]['m2'] + line.cantidad_m2
                                        })"/>
                                    </t>
                                    
                                    <!-- Tabla Única de Resumen -->
                                    <table class="table table-sm table-borderless mb-0 p-0" style="font-size: 8px; width: 100%;">
                                        <!-- Cabecera -->
                                        <thead>
                                            <tr style="border-bottom: 1px solid #000; background-color: #000; color: #fff;">
                                                <th style="width: 70%; color: #fff; font-weight: bold; padding: 4px;">DESCRIPCIÓN</th>
                                                <th class="text-center" style="width: 15%; color: #fff; font-weight: bold; padding: 4px;">PLACAS FÍSICAS</th>
                                                <th class="text-end" style="width: 15%; color: #fff; font-weight: bold; padding: 4px;">CANT TOTAL (m² / Unid)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="product_summary.values()" t-as="data">
                                                <tr style="border-bottom: 1px solid #eee;">
                                                    <td style="padding: 4px 5px; text-transform: uppercase;">
                                                        <strong t-esc="data['name']"/>
                                                        <!-- Indicador visual si es un servicio -->
                                                        <t t-if="data['type'] == 'service'">
                                                            <span style="font-style: italic; color: #888; font-size: 7px;"> (Servicio)</span>
                                                        </t>
                                                    </td>
                                                    <td class="text-center" style="padding: 4px 5px;">
                                                        <span t-if="data['type'] != 'service'" t-esc="data['placas']"/>
                                                        <span t-else="" style="color: #aaa;">-</span>
                                                    </td>
                                                    <td class="text-end" style="padding: 4px 5px;">
                                                        <strong t-esc="'%.2f' % data['m2']"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <!-- Footer: TOTALES GENERALES DE CANTIDAD -->
                                        <tfoot style="border-top: 2px solid #000; background-color: #eaeaea;">
                                            <tr style="font-weight: bold; font-size: 9px;">
                                                <td class="text-end pt-2 pb-2" style="padding: 4px 5px; text-transform: uppercase;">
                                                    TOTAL GENERAL:
                                                </td>
                                                <td class="text-center pt-2 pb-2" style="padding: 4px 5px;">
                                                    <span t-esc="o.total_placas"/>
                                                </td>
                                                <td class="text-end pt-2 pb-2" style="padding: 4px 5px;">
                                                    <span t-esc="'%.2f' % o.total_m2"/>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- ================= TABLA DETALLADA DE MATERIALES (SIN PRECIOS) ================= -->
                        <div t-if="materials" style="margin-top: 25px;">
                            <div class="mb-1">
                                <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Detalle de Lotes y Dimensiones</strong>
                            </div>

                            <table class="table table-sm table-striped" style="width: 100%; font-size: 9px; border-collapse: collapse;">
                                <thead>
                                    <tr style="border-bottom: 2px solid #000; background-color: #000; color: #fff;">
                                        <th class="text-center" style="width: 5%; color: #fff; font-weight: bold; padding: 4px;">#</th>
                                        <th style="width: 25%; color: #fff; font-weight: bold; padding: 4px;">LOTE</th>
                                        <th style="width: 15%; color: #fff; font-weight: bold; padding: 4px;">BLOQUE</th>
                                        <th style="width: 15%; color: #fff; font-weight: bold; padding: 4px;">ATADO</th>
                                        <th class="text-center" style="width: 10%; color: #fff; font-weight: bold; padding: 4px;">GROSOR</th>
                                        <th class="text-center" style="width: 10%; color: #fff; font-weight: bold; padding: 4px;">ALTO</th>
                                        <th class="text-center" style="width: 10%; color: #fff; font-weight: bold; padding: 4px;">ANCHO</th>
                                        <th class="text-end" style="width: 10%; color: #fff; font-weight: bold; padding: 4px;">m²</th>
                                    </tr>
                                </thead>
                                <tbody style="border-bottom: 1px solid #000;">
                                    <t t-set="seq" t-value="1"/>
                                    <t t-set="current_product" t-value="None"/>
                                    
                                    <t t-foreach="materials" t-as="line">
                                        <!-- AGRUPACIÓN POR PRODUCTO -->
                                        <t t-if="current_product != line.product_id.id">
                                            <t t-set="current_product" t-value="line.product_id.id"/>
                                            <tr style="background-color: #2f2f2f; color: #FFFFFF;">
                                                <td colspan="8" style="padding: 4px 8px; font-weight: bold; font-size: 10px; text-transform: uppercase; color: #FFFFFF;">
                                                    <span t-field="line.product_id.display_name"/>
                                                </td>
                                            </tr>
                                        </t>
                                        
                                        <!-- FILA DETALLE -->
                                        <tr>
                                            <td class="text-center align-middle" style="padding: 2px 5px;">
                                                <span t-esc="seq"/>
                                                <t t-set="seq" t-value="seq + 1"/>
                                            </td>
                                            <td class="align-middle" style="padding: 2px 5px;">
                                                <t t-if="line.lot_id">
                                                    <strong t-field="line.lot_id.name"/>
                                                </t>
                                                <t t-else="">
                                                    <span style="font-style: italic; color: #666;">(Por pedir)</span>
                                                </t>
                                            </td>
                                            <td class="align-middle" style="padding: 2px 5px;">
                                                <span t-if="line.lot_id" t-field="line.lot_id.x_bloque"/>
                                            </td>
                                            <td class="align-middle" style="padding: 2px 5px;">
                                                <span t-if="line.lot_id" t-field="line.lot_id.x_atado"/>
                                            </td>
                                            <td class="text-center align-middle" style="padding: 2px 5px;">
                                                <span t-if="line.lot_id" t-field="line.x_grosor" t-options='{"precision": 2}'/>
                                            </td>
                                            <td class="text-center align-middle" style="padding: 2px 5px;">
                                                <span t-if="line.lot_id" t-field="line.x_alto" t-options='{"precision": 3}'/>
                                            </td>
                                            <td class="text-center align-middle" style="padding: 2px 5px;">
                                                <span t-if="line.lot_id" t-field="line.x_ancho" t-options='{"precision": 3}'/>
                                            </td>
                                            <td class="text-end align-middle" style="padding: 2px 5px;">
                                                <strong t-field="line.cantidad_m2" t-options='{"precision": 2}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- ================= TABLA DE SERVICIOS (SIN PRECIOS) ================= -->
                        <div t-if="services" style="margin-top: 20px;">
                            <div class="mb-1">
                                <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Servicios Adicionales</strong>
                            </div>
                            <table class="table table-sm" style="width: 100%; font-size: 9px; border-collapse: collapse; border-bottom: 1px solid #000;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #ccc; background-color: #000; color: #fff;">
                                        <th style="width: 80%; color: #fff; font-weight: bold; padding: 4px;">DESCRIPCIÓN</th>
                                        <th class="text-end" style="width: 20%; color: #fff; font-weight: bold; padding: 4px;">CANTIDAD</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="services" t-as="line">
                                        <td class="align-middle" style="padding: 2px 5px;">
                                            <span t-field="line.product_id.display_name"/>
                                        </td>
                                        <td class="text-end align-middle" style="padding: 2px 5px;">
                                            <strong t-field="line.cantidad_m2" t-options='{"precision": 2}'/> <span t-field="line.product_id.uom_id"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- ================= TOTALES (SOLO CANTIDAD) AL FINAL ================= -->
                        <div class="row mt-2">
                            <div class="col-6"></div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size: 9px; border-top: 2px solid #000;">
                                    <tr style="font-weight: 900; font-size: 11px;">
                                        <td class="text-end">TOTAL m² / UNIDADES</td>
                                        <td class="text-end" style="width: 30%;">
                                            <span t-esc="'%.2f' % o.total_m2"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ================= FIRMAS Y TÉRMINOS ================= -->
                        <div style="margin-top: 50px; page-break-inside: avoid;">
                            <div class="row" style="margin-top: 40px; margin-bottom: 10px;">
                                <div class="col-1"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL VENDEDOR</strong>
                                    </div>
                                </div>
                                <div class="col-2"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL CLIENTE / ACEPTACIÓN DE LA RESERVA</strong>
                                    </div>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <!-- LEYENDA DE ACEPTACIÓN DE VENCIMIENTO -->
                            <div class="row mb-3">
                                <div class="col-12 text-center">
                                    <p style="font-size: 9px; margin-top: 5px; padding: 0 20px;">
                                        Al firmar este documento, el cliente confirma la selección de las placas y acepta que la <span style="font-weight: bold;">RESERVA ES VÁLIDA SOLO HASTA EL <span t-field="o.fecha_expiracion" t-options='{"widget": "date"}'/></span>. Para garantizar la disponibilidad del material en su proyecto, se recomienda firmar y formalizar las condiciones comerciales antes de esa fecha.
                                    </p>
                                </div>
                            </div>

                            <!-- Información Bancaria Agregada -->
                            <div style="border: 1px solid #ccc; padding: 8px; background-color: #fafafa; margin-top: 5px;">
                                <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                    Recubrimientos STO SA de CV (RFC: RST191127ER6)
                                </strong>
                                
                                <div class="row" style="font-size: 8px; color: #555; margin-top: 5px;">
                                    <!-- Columna 1: Dólares -->
                                    <div class="col-6">
                                        <p class="mb-1" style="font-weight: bold; color: #000; text-transform: uppercase;">Banorte - Moneda Dólares (USD)</p>
                                        <p class="mb-0"><strong>Cuenta:</strong> 1097074150</p>
                                        <p class="mb-0"><strong>Clabe:</strong> 072580010970741500</p>
                                        <p class="mb-0"><strong>Swift:</strong> MENOMXMTXXX</p>
                                        <p class="mb-0"><strong>Sucursal:</strong> 1924 Paseo Santa Catarina</p>
                                    </div>
                                    
                                    <!-- Columna 2: Pesos -->
                                    <div class="col-6" style="border-left: 1px dotted #ccc;">
                                        <p class="mb-1" style="font-weight: bold; color: #000; text-transform: uppercase;">Banorte - Moneda Pesos (MXN)</p>
                                        <p class="mb-0"><strong>Cuenta:</strong> 1060415841</p>
                                        <p class="mb-0"><strong>Clabe:</strong> 072580010604158414</p>
                                        <p class="mb-0"><strong>Sucursal:</strong> 1924 Paseo Santa Catarina</p>
                                    </div>
                                </div>
                                
                                <div class="mt-2" style="font-size: 8px; color: #555; border-top: 1px solid #eee; padding-top: 4px;">
                                    <strong>Correo de recepción de comprobantes:</strong> norma@somgroup.com y clara@somgroup.com
                                </div>
                            </div>

                            <!-- TÉRMINOS SIMPLIFICADOS (Caja Gris) -->
                            <div class="row mt-2">
                                <div class="col-12">
                                    <div style="border: 1px solid #ccc; padding: 8px; background-color: #fafafa;">
                                        <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                            Términos y Condiciones – Reserva de Material
                                        </strong>
                                        <div style="font-size: 8px; text-align: justify; color: #555;">
                                            <p style="margin: 0 0 3px 0;">• La reserva de material tiene una vigencia de 7 días naturales a partir de la fecha de confirmación.</p>
                                            <p style="margin: 0 0 3px 0;">• Durante este periodo, el material quedará separado exclusivamente para el cliente.</p>
                                            <p style="margin: 0 0 3px 0;">• En caso de no recibir el pago total o parcial dentro del plazo establecido, la reserva se cancelará automáticamente y el material quedará disponible para venta.</p>
                                            <p style="margin: 0 0 3px 0;">• La reserva no congela precios en caso de variación del tipo de cambio; el precio final será el vigente al momento del pago.</p>
                                            <p style="margin: 0 0 3px 0;">• Pasado el periodo de reserva, la empresa no garantiza disponibilidad del material ni condiciones previamente cotizadas.</p>
                                            <p style="margin: 0;">• El mármol y granito pueden presentar variaciones naturales propias del material.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>