<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- ACCIÓN: REPORTE DE RESERVA - RESUMEN (SIN PRECIOS) -->
    <!-- ======================================================= -->
    <record id="action_report_stock_lot_hold_order_summary_no_prices" model="ir.actions.report">
        <field name="name">Orden de Reserva - Resumen (Sin Precios)</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_stock_lot_hold_order_summary_document_no_prices</field>
        <field name="report_file">stock_lot_dimensions.report_stock_lot_hold_order_summary_document_no_prices</field>
        <field name="print_report_name">'Reserva Resumen - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_lot_hold_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ======================================================= -->
    <!-- PLANTILLA: SOLO RESUMEN AGRUPADO (SIN PRECIOS)          -->
    <!-- ======================================================= -->
    <template id="report_stock_lot_hold_order_summary_document_no_prices">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">

                    <t t-set="address" t-value="False"/>
                    <t t-set="information_block" t-value="False"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000; line-height: 1.25;">

                        <style type="text/css">
                            /* Evita superposición del thead en saltos de página */
                            thead { display: table-row-group; }
                            tbody { display: table-row-group; }
                            tfoot { display: table-row-group; }
                            tr { page-break-inside: avoid; break-inside: avoid; }

                            /* Compacta únicamente las tablas de productos sin alterar estructura */
                            table.table.table-sm.table-striped > thead > tr > th,
                            table.table.table-sm > thead > tr > th {
                                padding-top: 3px !important;
                                padding-bottom: 3px !important;
                                line-height: 1.05 !important;
                            }

                            table.table.table-sm.table-striped > tbody > tr > td,
                            table.table.table-sm > tbody > tr > td {
                                padding-top: 2px !important;
                                padding-bottom: 2px !important;
                                line-height: 1.08 !important;
                            }

                            table.table.table-sm.table-striped > tbody > tr,
                            table.table.table-sm > tbody > tr {
                                height: auto !important;
                            }

                            /* Legibilidad en datos bancarios y términos */
                            .aq-bank-details,
                            .aq-bank-details *,
                            .aq-terms-conditions,
                            .aq-terms-conditions * {
                                font-size: 11px !important;
                                line-height: 1.35 !important;
                            }

                            .aq-terms-conditions-title {
                                font-size: 11px !important;
                                line-height: 1.25 !important;
                            }

                            .aq-terms-conditions p {
                                margin: 0 0 4px 0 !important;
                            }
                        </style>

                        <!-- Tabla de página: ancla el footer al fondo (compatible con wkhtmltopdf/QtWebKit,
                             que NO soporta flexbox). La fila de contenido absorbe el espacio libre y la
                             fila del footer queda abajo. height = mínimo; si hay más contenido, crece y pagina. -->
                        <div style="display: table; width: 100%; height: 212mm;">
                            <div style="display: table-row; height: 100%;">
                                <div style="display: table-cell; vertical-align: top;">

                        <!-- ENCABEZADO + INFORMACIÓN -->
                        <t t-call="stock_lot_dimensions.hold_order_info_header"/>

                        <!-- RESUMEN POR TIPO Y PRODUCTO (SIN PRECIOS) -->
                        <t t-set="show_prices" t-value="False"/>
                        <t t-call="stock_lot_dimensions.hold_order_summary_body"/>

                        <!-- TOTALES + NOTAS -->
                        <t t-call="stock_lot_dimensions.hold_order_totals_box"/>

                                </div>
                            </div>
                            <div style="display: table-row;">
                                <div style="display: table-cell; vertical-align: bottom;">
                        <!-- PIE: FIRMAS / BANCO / TÉRMINOS (anclado al fondo de la última hoja) -->
                        <t t-call="stock_lot_dimensions.hold_order_footer"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
