<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         TEMPLATE DEL DOCUMENTO (cuerpo del reporte)
         NOTA: ID Renombrado a *_custom para romper conflicto de herencia
    ============================================================ -->
    <template id="report_sale_order_document_no_prices_custom">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">

                <!-- Tabla de página: ancla el footer al fondo (wkhtmltopdf/QtWebKit, sin flexbox). -->
                <div style="display: table; width: 100%; height: 212mm;">
                    <div style="display: table-row; height: 100%;">
                        <div style="display: table-cell; vertical-align: top;">

                <!-- ================= ENCABEZADO ================= -->
                <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                    <div class="col-8">
                        <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                            <span t-if="doc.state in ['draft','sent']">Cotización</span>
                            <span t-else="">Orden de Venta</span>
                            <span t-field="doc.name" style="margin-left: 10px; color: #333;"/>
                        </h4>
                    </div>
                    <div class="col-4 text-end">
                        <div style="font-size: 12px; color: #999; margin-top: 4px;">
                            Impreso: <span t-esc="datetime.datetime.utcnow()" t-options='{"widget": "datetime", "format": "dd MMM yyyy HH:mm"}'/>
                        </div>
                    </div>
                </div>

                <!-- ALERTA DE VENCIMIENTO -->
                <div class="row mb-4" t-if="doc.validity_date and doc.state in ['draft', 'sent']">
                    <div class="col-12">
                        <div style="border: 4px solid #ff0000; background-color: #fff5f5; padding: 8px; width: 100%;">
                            <div style="color: #ff0000; font-weight: 900; font-size: 14px; text-transform: uppercase;">
                                ⚠️ OFERTA VÁLIDA HASTA: <span t-field="doc.validity_date" t-options='{"widget": "date", "format": "dd MMM yyyy"}'/>
                            </div>
                            <div style="color: #333; font-size: 10px; margin-top: 3px; font-style: italic;">
                                A partir de esa fecha, los precios y la disponibilidad de los materiales pueden cambiar sin previo aviso.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= INFORMACIÓN GENERAL ================= -->
                <div class="row mb-2" id="informations">
                    <!-- Columna 1: Cliente -->
                    <div class="col-4">
                        <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                            <strong style="font-size: 10px; text-transform: uppercase;">Cliente</strong>
                        </div>
                        <div style="line-height: 1.2; padding-left: 2px;">
                            <span style="font-weight: bold; font-size: 12px;" t-field="doc.partner_id.name"/><br/>
                            <span t-if="doc.partner_id.vat">RFC: <span t-field="doc.partner_id.vat"/></span>
                        </div>
                        <div class="mt-1" t-if="doc.state not in ['draft', 'sent']" style="border-top: 1px dotted #9f9f9f; padding-top: 1px;">
                            <strong style="font-size: 9px; text-transform: uppercase; color: #555; display: block;">Dirección Fiscal / Entrega:</strong>
                            <div style="font-size: 9px; color: #333; line-height: 1.1; margin-top: 2px;">
                                <span t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            </div>
                        </div>
                    </div>

                    <!-- Columna 2: Referencias -->
                    <div class="col-4">
                        <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                            <strong style="font-size: 10px; text-transform: uppercase;">Detalles del Proyecto</strong>
                        </div>
                        <table class="table table-borderless table-sm mb-0 p-0" style="width: 100%;">
                            <tr>
                                <td class="p-0" style="width: 35%;"><strong>Proyecto:</strong></td>
                                <td class="p-0">
                                    <span t-if="doc.x_project_id" t-field="doc.x_project_id.name"/>
                                    <span t-else="">-</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="p-0"><strong>Embajador:</strong></td>
                                <td class="p-0">
                                    <span t-if="doc.x_architect_id" t-field="doc.x_architect_id.name"/>
                                    <span t-else="">-</span>
                                </td>
                            </tr>
                            <tr t-if="doc.client_order_ref">
                                <td class="p-0"><strong>Ref. Cliente:</strong></td>
                                <td class="p-0"><span t-field="doc.client_order_ref"/></td>
                            </tr>
                            <tr>
                                <td class="p-0"><strong>Vendedor:</strong></td>
                                <td class="p-0"><span t-field="doc.user_id.name"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- Columna 3: Estado -->
                    <div class="col-4">
                        <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                            <strong style="font-size: 10px; text-transform: uppercase;">Estado del Documento</strong>
                        </div>
                        <table class="table table-borderless table-sm mb-1 p-0" style="width: 100%;">
                            <tr>
                                <td class="p-0"><strong>Fecha:</strong></td>
                                <td class="p-0 text-end"><span t-field="doc.date_order" t-options='{"widget": "date", "format": "dd MMM yyyy"}'/></td>
                            </tr>
                            <tr>
                                <td class="p-0"><strong>Moneda:</strong></td>
                                <td class="p-0 text-end"><span t-field="doc.currency_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="p-0 pt-1"><strong>Plazos:</strong></td>
                                <td class="p-0 pt-1 text-end"><span t-field="doc.payment_term_id.name"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- ================= LÓGICA DE PROCESAMIENTO ================= -->
                <t t-set="material_summary" t-value="{}"/>
                <t t-set="service_summary" t-value="{}"/>
                <t t-foreach="doc.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="key" t-value="line.product_id.id"/>
                        <t t-if="line.product_id.type == 'service'">
                            <t t-if="key not in service_summary">
                                <t t-set="dummy" t-value="service_summary.update({key: {
                                    'name': line.name,
                                    'qty_total': 0.0,
                                    'uom': line.product_id.uom_id.name
                                }})"/>
                            </t>
                            <t t-set="dummy" t-value="service_summary[key].update({
                                'qty_total': service_summary[key]['qty_total'] + line.product_uom_qty
                            })"/>
                        </t>
                        <t t-else="">
                            <t t-if="key not in material_summary">
                                <t t-set="dummy" t-value="material_summary.update({key: {
                                    'name': line.name,
                                    'qty_lot': 0,
                                    'qty_total': 0.0,
                                    'uom': line.product_id.uom_id.name
                                }})"/>
                            </t>
                            <t t-set="current_plates" t-value="len(line.x_selected_lots) if line.x_selected_lots else 0"/>
                            <t t-set="dummy" t-value="material_summary[key].update({
                                'qty_lot': material_summary[key]['qty_lot'] + current_plates,
                                'qty_total': material_summary[key]['qty_total'] + line.product_uom_qty
                            })"/>
                        </t>
                    </t>
                </t>

                <!-- ================= TABLA 1: MATERIALES (SIN PRECIOS) ================= -->
                <div class="mt-3 mb-1">
                    <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Suministro de Materiales</strong>
                </div>

                <table class="table table-sm table-striped" style="width: 100%; font-size: 9px; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid #000; background-color: #000; color: #fff;">
                            <th style="color: #fff; width: 50%; padding: 4px 8px; font-weight: bold;">Descripción</th>
                            <th class="text-center" style="color: #fff; width: 20%; padding: 4px 8px; font-weight: bold;">Placas</th>
                            <th class="text-end" style="color: #fff; width: 30%; padding: 4px 8px; font-weight: bold;">Cantidad</th>
                        </tr>
                    </thead>
                    <tbody style="border-bottom: 1px solid #000;">
                        <t t-foreach="material_summary.values()" t-as="data">
                            <tr>
                                <td class="align-middle" style="padding: 4px 8px;">
                                    <span t-esc="data['name']"/>
                                </td>
                                <td class="text-center align-middle">
                                    <span t-if="data['qty_lot'] > 0" t-esc="data['qty_lot']" style="font-weight: bold;"/>
                                    <span t-else="" style="color: #999;">-</span>
                                </td>
                                <td class="text-end align-middle">
                                    <span t-esc="'{:,.2f}'.format(data['qty_total'])"/> <span t-esc="data['uom']"/>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="not material_summary">
                            <td colspan="3" class="text-center" style="font-style: italic; color: #777;">Sin materiales físicos seleccionados.</td>
                        </tr>
                    </tbody>
                </table>

                <!-- ================= TABLA 2: SERVICIOS (SIN PRECIOS) ================= -->
                <div t-if="service_summary" style="margin-top: 15px;">
                    <div class="mb-1">
                        <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Servicios Adicionales</strong>
                    </div>
                    <table class="table table-sm" style="width: 100%; font-size: 9px; border-collapse: collapse; border-bottom: 1px solid #000;">
                        <thead>
                            <tr style="border-bottom: 2px solid #000; background-color: #000; color: #fff;">
                                <th style="width: 70%; font-weight: bold; color: #fff;">Descripción</th>
                                <th class="text-end" style="width: 30%; font-weight: bold; color: #fff;">Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="service_summary.values()" t-as="data">
                                <tr>
                                    <td class="align-middle"><span t-esc="data['name']"/></td>
                                    <td class="text-end align-middle">
                                        <span t-esc="'{:,.2f}'.format(data['qty_total'])"/> <span t-esc="data['uom']"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- ================= NOTAS ================= -->
                <div class="row mt-2">
                    <div class="col-12">
                        <div t-if="doc.note" style="border: 1px dashed #ccc; padding: 10px; margin-top: 5px;">
                            <strong style="font-size: 9px; text-transform: uppercase; color: #555;">Notas de la Orden:</strong>
                            <div style="font-size: 9px; white-space: pre-wrap;" t-field="doc.note"/>
                        </div>
                    </div>
                </div>

                        </div>
                    </div>
                    <div style="display: table-row;">
                        <div style="display: table-cell; vertical-align: bottom;">
                <!-- ================= FOOTER / FIRMAS (anclado al fondo de la última hoja) ================= -->
                <div style="margin-top: 50px; width: 100%; page-break-inside: avoid;">
                    <div class="row" style="margin-top: 40px; margin-bottom: 10px;">
                        <div class="col-1"></div>
                        <div class="col-4 text-center">
                            <div style="border-top: 1px solid #000; padding-top: 5px;">
                                <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL VENDEDOR</strong>
                            </div>
                        </div>
                        <div class="col-2"></div>
                        <div class="col-4 text-center">
                            <div style="border-top: 1px solid #000; padding-top: 5px;">
                                <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL CLIENTE</strong>
                            </div>
                        </div>
                        <div class="col-1"></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-12">

                            <!-- Información Bancaria -->
                            <t t-set="company" t-value="doc.company_id"/>
                            <t t-call="stock_lot_dimensions.company_bank_details_block"/>

                            <!-- Términos Comerciales -->
                            <div style="border: 1px solid #ccc; padding: 8px; background-color: #fafafa; page-break-inside: avoid; break-inside: avoid;">
                                <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                    <t t-if="doc.state in ('draft', 'sent')">Términos y Condiciones – Cotización</t>
                                    <t t-if="doc.state in ('sale', 'done')">Términos y Condiciones – Orden de Venta</t>
                                </strong>
                                <div style="font-size: 8px; text-align: justify; color: #555;">
                                    <p style="margin: 0 0 3px 0;">• El mármol y granito son materiales naturales, por lo que pueden existir variaciones en coloración, vetas y tonalidad respecto a muestras o imágenes.</p>
                                    <t t-if="doc.state in ('draft', 'sent')">
                                        <p style="margin: 0 0 3px 0;">• Los precios están sujetos a disponibilidad y no garantizan existencia hasta recibir confirmación de pago.</p>
                                        <p style="margin: 0 0 3px 0;">• En materiales de importación o bajo pedido, los tiempos de entrega son estimados y pueden variar por causas ajenas a la empresa.</p>
                                        <p style="margin: 0 0 3px 0;">• En caso de existir variación en el tipo de cambio entre la fecha de cotización y el pago, se realizará el ajuste correspondiente al día del pago.</p>
                                        <p style="margin: 0 0 3px 0;">• La cotización no incluye maniobras especiales de descarga ni servicios adicionales, salvo que se especifique por escrito.</p>
                                        <p style="margin: 0;">• Los precios pueden cambiar sin previo aviso en caso de incrementos por parte del proveedor.</p>
                                    </t>
                                    <t t-if="doc.state in ('sale', 'done')">
                                        <p style="margin: 0 0 3px 0;">• La presente orden de venta confirma los materiales, cantidades y precios acordados con el cliente.</p>
                                        <p style="margin: 0 0 3px 0;">• En caso de devolución autorizada, el material deberá entregarse en las mismas condiciones en que fue recibido, sin daño, sin cortes y sin haber sido instalado.</p>
                                        <p style="margin: 0 0 3px 0;">• Después de 3 meses de almacenaje, se comenzará a generar un cargo de $7.00 MXN por m², por mes o fracción.</p>
                                        <p style="margin: 0 0 3px 0;">• La entrega del material está sujeta a que el pedido se encuentre liquidado al 100%.</p>
                                        <p style="margin: 0 0 3px 0;">• Cualquier aclaración deberá realizarse por escrito dentro de las 24 horas posteriores a la entrega.</p>
                                        <p style="margin: 0 0 3px 0;">• El cliente acepta las condiciones aquí descritas a partir del momento en que se recibe el anticipo y/o el pago total correspondiente a esta orden de venta.</p>
                                        <p style="margin: 0;">• El plazo de entrega será de 24 a 48 horas hábiles, contado a partir de la confirmación de disponibilidad del material y de la recepción del pago total correspondiente al pedido.</p>
                                    </t>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                        </div>
                    </div>
                </div>

            </div>
        </t>
    </template>

    <!-- ============================================================
         TEMPLATE WRAPPER
         NOTA: ID Renombrado a *_custom y actualizado el t-call
    ============================================================ -->
    <template id="report_sale_order_no_prices_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="stock_lot_dimensions.report_sale_order_document_no_prices_custom"/>
            </t>
        </t>
    </template>

    <!-- ============================================================
         ACCIÓN DEL REPORTE
         NOTA: ID Renombrado a *_custom y actualizado report_name
    ============================================================ -->
    <record id="action_report_sale_order_no_prices_custom" model="ir.actions.report">
        <field name="name">Cotización/OS sin Precios</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_sale_order_no_prices_custom</field>
        <field name="report_file">stock_lot_dimensions.report_sale_order_no_prices_custom</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo>