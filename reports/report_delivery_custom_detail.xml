<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- DESACTIVAR reporte nativo de entrega                     -->
    <!-- ======================================================= -->
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- ======================================================= -->
    <!-- ACCIÓN: REPORTE DE ENTREGA DETALLADO (Predeterminado)    -->
    <!-- ======================================================= -->
    <record id="action_report_delivery_custom_detail" model="ir.actions.report">
        <field name="name">Remisión de Entrega</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_delivery_custom_document</field>
        <field name="report_file">stock_lot_dimensions.report_delivery_custom_document</field>
        <field name="print_report_name">'Remisión - %s - %s' % (object.name, object.partner_id.name or '')</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ======================================================= -->
    <!-- PLANTILLA: DOCUMENTO DE ENTREGA                          -->
    <!-- ======================================================= -->
    <template id="report_delivery_custom_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    
                    <!-- OCULTAR CABECERAS ESTÁNDAR -->
                    <t t-set="address" t-value="False"/>
                    <t t-set="information_block" t-value="False"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">
                        
                        <!-- ================= ENCABEZADO ================= -->
                        <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                            <div class="col-8">
                                <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                                    Remisión <span t-esc="o.name.split('/')[-1]" style="margin-left: 10px; color: #333;"/>
                                </h4>
                            </div>
                            <div class="col-4 text-end">
                                <div style="font-size: 8px; color: #999; margin-top: 4px;">
                                    Impreso: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                </div>
                            </div>
                        </div>

                        <!-- ================= INFORMACIÓN GENERAL (3 COLUMNAS) ================= -->
                        <div class="row mb-4" id="informations">
                            
                            <!-- Columna 1: Cliente y Dirección Fiscal -->
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Cliente / Facturación</strong>
                                </div>
                                <t t-set="commercial_partner" t-value="o.sale_id.partner_id if o.sale_id else o.partner_id"/>
                                
                                <div style="line-height: 1.2; padding-left: 2px;">
                                    <span style="font-weight: bold; font-size: 12px;" t-esc="commercial_partner.name"/><br/>
                                    <span t-if="commercial_partner.vat">RFC: <span t-esc="commercial_partner.vat"/></span>
                                </div>
                                <div class="mt-1" style="border-top: 1px dotted #9f9f9fff; padding-top: 1px;">
                                    <div style="font-size: 9px; color: #333; line-height: 1.1; margin-top: 2px;">
                                        <span t-esc="commercial_partner.contact_address" style="white-space: pre-line;"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Columna 2: Dirección de Entrega -->
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Dirección de Entrega</strong>
                                </div>
                                <div style="font-size: 10px; color: #333; line-height: 1.2; padding-left: 2px;">
                                    <t t-if="o.move_ids and o.move_ids[0].partner_id and o.move_ids[0].partner_id.id != commercial_partner.id">
                                        <strong t-field="o.move_ids[0].partner_id.name"/><br/>
                                        <span t-field="o.move_ids[0].partner_id.contact_address"/>
                                    </t>
                                    <t t-elif="o.partner_id and o.partner_id.id != commercial_partner.id">
                                        <strong t-field="o.partner_id.name"/><br/>
                                        <span t-field="o.partner_id.contact_address"/>
                                    </t>
                                    <t t-else="">
                                        <span style="font-style: italic; color: #666;">Misma dirección del cliente.</span>
                                    </t>
                                </div>
                            </div>

                            <!-- Columna 3: Detalles del Documento -->
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Referencia</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-1 p-0" style="width: 100%;">
                                    <tr>
                                        <td class="p-0"><strong>Fecha Efectiva:</strong></td>
                                        <td class="p-0 text-end">
                                            <span t-if="o.date_done" t-field="o.date_done" t-options='{"widget": "date"}'/>
                                            <span t-else="" t-field="o.scheduled_date" t-options='{"widget": "date"}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.origin">
                                        <td class="p-0"><strong>Origen:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.origin"/></td>
                                    </tr>
                                    <tr t-if="o.sale_id and o.sale_id.x_project_id">
                                        <td class="p-0"><strong>Proyecto:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.sale_id.x_project_id.name"/></td>
                                    </tr>
                                    <tr t-if="o.sale_id and o.sale_id.x_architect_id">
                                        <td class="p-0"><strong>Arquitecto:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.sale_id.x_architect_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ================= TABLA DE DETALLES ================= -->
                        <div class="mt-3 mb-1">
                            <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Detalle de Materiales Entregados</strong>
                        </div>

                        <table class="table table-sm table-striped" style="width: 100%; font-size: 9px; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 2px solid #000; background-color: #000; color: #fff;">
                                    <th class="text-center" style="width: 5%; color: #fff; font-weight: bold;">#</th>
                                    <th style="width: 20%; color: #fff; font-weight: bold;">LOTE</th>
                                    <th style="width: 10%; color: #fff; font-weight: bold;">BLOQUE</th>
                                    <th style="width: 10%; color: #fff; font-weight: bold;">ATADO</th>
                                    <th class="text-center" style="width: 10%; color: #fff; font-weight: bold;">GROSOR</th>
                                    <th class="text-center" style="width: 10%; color: #fff; font-weight: bold;">ALTO</th>
                                    <th class="text-center" style="width: 10%; color: #fff; font-weight: bold;">ANCHO</th>
                                    <th class="text-end" style="width: 10%; color: #fff; font-weight: bold;">CANTIDAD</th>
                                    <th class="text-center" style="width: 15%; color: #fff; font-weight: bold;">UDM</th>
                                </tr>
                            </thead>
                            <tbody style="border-bottom: 1px solid #000;">
                                <t t-set="lines" t-value="o.move_line_ids.filtered(lambda l: l.qty_done > 0 or l.quantity > 0).sorted(key=lambda l: (l.product_id.display_name, l.lot_id.name))"/>
                                <t t-set="current_product" t-value="None"/>
                                <t t-set="seq" t-value="1"/>

                                <t t-foreach="lines" t-as="line">
                                    <!-- Cabecera de Producto -->
                                    <t t-if="current_product != line.product_id.id">
                                        <t t-set="current_product" t-value="line.product_id.id"/>
                                        <tr style="background-color: #2f2f2f; color: #fff;">
                                            <td colspan="9" style="padding: 4px 8px; font-weight: bold; font-size: 10px; text-transform: uppercase; color: #FFFFFF;">
                                                <span t-field="line.product_id.display_name"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-set="qty_to_show" t-value="line.qty_done if line.qty_done > 0 else line.quantity"/>

                                    <tr>
                                        <td class="text-center align-middle">
                                            <span t-esc="seq"/>
                                            <t t-set="seq" t-value="seq + 1"/>
                                        </td>
                                        <td class="align-middle">
                                            <t t-if="line.lot_id">
                                                <strong t-field="line.lot_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted text-italic">Sin Lote</span>
                                            </t>
                                        </td>
                                        <td class="align-middle">
                                            <span t-field="line.lot_id.x_bloque"/>
                                        </td>
                                        <td class="align-middle">
                                            <span t-field="line.lot_id.x_atado"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-field="line.lot_id.x_grosor"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-field="line.lot_id.x_alto" t-options='{"widget": "float", "precision": 3}'/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-field="line.lot_id.x_ancho" t-options='{"widget": "float", "precision": 3}'/>
                                        </td>
                                        <td class="text-end align-middle">
                                            <strong t-esc="qty_to_show" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-field="line.product_uom_id.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot style="border-top: 2px solid #000; background-color: #f9f9f9;">
                                <tr>
                                    <td colspan="7" class="text-end" style="padding: 5px; font-weight: bold;">TOTAL UNIDADES:</td>
                                    <td class="text-end" style="padding: 5px; font-weight: bold;">
                                        <span t-esc="sum(lines.mapped(lambda l: l.qty_done if l.qty_done > 0 else l.quantity))" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ================= FOOTER / FIRMAS ================= -->
                        <div style="margin-top: 30px; width: 100%; page-break-inside: avoid;">

                            <!-- Notas de entrega -->
                            <div class="row">
                                <div class="col-12 mb-3">
                                    <div style="border: 1px solid #ccc; padding: 5px 10px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">Notas de Entrega:</strong>
                                        <div t-if="o.note" style="font-size: 9px; margin-top: 2px;">
                                            <span t-field="o.note"/>
                                        </div>
                                        <div t-else="" style="font-size: 9px; color: #999; margin-top: 2px;">
                                            Sin notas adicionales.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Firma centrada: RECIBIDO POR -->
                            <div class="row" style="margin-top: 30px; margin-bottom: 10px;">
                                <div class="col-3"></div>
                                <div class="col-6 text-center">
                                    <t t-if="o.signature">
                                        <div style="margin-bottom: 8px;">
                                            <img t-att-src="image_data_uri(o.signature)" 
                                                 style="max-height: 100px; max-width: 250px;"/>
                                        </div>
                                    </t>
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">RECIBIDO POR</strong><br/>
                                        <span style="font-size: 9px;" t-esc="o.x_received_by_name or o.partner_id.name"/>
                                    </div>
                                </div>
                                <div class="col-3"></div>
                            </div>

                            <!-- Términos y Condiciones -->
                            <div class="row mt-2">
                                <div class="col-12">
                                    <div style="border: 1px solid #ccc; padding: 5px; background-color: #fafafa;">
                                        <strong style="font-size: 12px; display: block; border-bottom: 1px solid #eee; margin-bottom: 3px; text-transform: uppercase;">
                                            Términos y Condiciones – Remisión de Entrega
                                        </strong>
                                        <ul class="list-unstyled mb-0" style="font-size: 11px; text-align: justify; color: #555; padding-left: 0;">
                                            <li class="mb-1">• Para la programación y realización de la entrega, el pedido deberá estar pagado al 100%.</li>
                                            <li class="mb-1">• La entrega se realiza a pie de camión. No incluye maniobras especiales de descarga.</li>
                                            <li class="mb-1">• Es indispensable que se encuentre presente el contacto autorizado para recibir el material. En caso contrario, el material será regresado a bodega y se generará un cargo adicional por reenvío.</li>
                                            <li class="mb-1">• El tiempo máximo de descarga es de 2 horas a partir de la llegada de la unidad. El tiempo excedente podrá generar cargos adicionales.</li>
                                            <li class="mb-1">• El cliente es responsable de revisar el material al momento de la entrega. Cualquier observación deberá anotarse en la remisión; una vez firmada, se considera el material recibido de conformidad.</li>
                                            <li class="mb-1">• El mármol y granito son piedras naturales, por lo que pueden presentar variaciones en color, vetas, tono y dureza, propias del material.</li>
                                            <li class="mb-0">• La empresa no se hace responsable por daños ocasionados después de la entrega, durante maniobras de descarga o traslado posterior.</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="text-center text-muted mt-2" style="font-size: 6px;">
                                Documento Interno | Página <span class="page"/>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>