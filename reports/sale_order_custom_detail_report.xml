<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- ACCIÓN: REPORTE DETALLADO (Con Lotes Individuales) -->
    <!-- ======================================================= -->
    <record id="action_report_sale_order_custom_detail" model="ir.actions.report">
        <field name="name">Orden de Venta - Detalle de Placas</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_sale_order_custom_detail</field>
        <field name="report_file">stock_lot_dimensions.report_sale_order_custom_detail</field>
        <field name="print_report_name">'Orden Detalle - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ======================================================= -->
    <!-- PLANTILLA: DETALLE (Estilo Unificado + Columnas Nuevas) -->
    <!-- ======================================================= -->
    <template id="report_sale_order_custom_detail">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    
                    <!-- 1. OCULTAR CABECERAS ESTÁNDAR DE ODOO -->
                    <t t-set="address" t-value="False"/>
                    <t t-set="information_block" t-value="False"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">
                        
                        <!-- ================= ENCABEZADO (ESTILO A) ================= -->
                        <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                            <div class="col-8">
                                <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                                    <span t-if="o.state in ['draft','sent']">Cotización Detallada</span>
                                    <span t-else="">Orden de Venta Detallada</span>
                                    <span t-field="o.name" style="margin-left: 10px; color: #333;"/>
                                </h4>
                            </div>
                            <div class="col-4 text-end">
                                <div style="font-size: 8px; color: #999; margin-top: 4px;">
                                    Impreso: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                </div>
                            </div>
                        </div>

                        <!-- ALERTA DE VENCIMIENTO (ESTILO A) -->
                        <div class="row mb-4" t-if="o.validity_date and o.state in ['draft', 'sent']">
                            <div class="col-12">
                                <div style="border: 4px solid #ff0000; background-color: #fff5f5; padding: 8px; width: 100%;">
                                    <div style="color: #ff0000; font-weight: 900; font-size: 14px; text-transform: uppercase;">
                                        ⚠️ OFERTA VÁLIDA HASTA: <span t-field="o.validity_date" t-options='{"widget": "date"}'/>
                                    </div>
                                    <div style="color: #333; font-size: 10px; margin-top: 3px; font-style: italic;">
                                        A partir de esa fecha, los precios y la disponibilidad de los materiales pueden cambiar sin previo aviso.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ================= INFORMACIÓN GENERAL (ESTILO A - 3 COLUMNAS) ================= -->
                        <div class="row mb-2" id="informations">
                            <!-- Columna 1: Cliente -->
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Cliente</strong>
                                </div>
                                <div style="line-height: 1.2; padding-left: 2px;">
                                    <span style="font-weight: bold; font-size: 12px;" t-field="o.partner_id.name"/><br/>
                                    <span t-if="o.partner_id.vat">RFC: <span t-field="o.partner_id.vat"/></span>
                                </div>
                                <div class="mt-1" style="border-top: 1px dotted #9f9f9fff; padding-top: 1px;">
                                    <strong style="font-size: 9px; text-transform: uppercase; color: #555; display: block;">Dirección Fiscal / Entrega:</strong>
                                    <div style="font-size: 9px; color: #333; line-height: 1.1; margin-top: 2px;">
                                        <span t-field="o.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                    </div>
                                </div>
                            </div>

                            <!-- Columna 2: Referencias y Proyecto -->
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Detalles del Proyecto</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-0 p-0" style="width: 100%;">
                                    <tr>
                                        <td class="p-0" style="width: 35%;"><strong>Proyecto:</strong></td>
                                        <td class="p-0">
                                            <span t-if="o.x_project_id" t-field="o.x_project_id.name"/>
                                            <span t-else="">-</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Arquitecto:</strong></td>
                                        <td class="p-0">
                                            <span t-if="o.x_architect_id" t-field="o.x_architect_id.name"/>
                                            <span t-else="">-</span>
                                        </td>
                                    </tr>
                                    <tr t-if="o.client_order_ref">
                                        <td class="p-0"><strong>Ref. Cliente:</strong></td>
                                        <td class="p-0"><span t-field="o.client_order_ref"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Vendedor:</strong></td>
                                        <td class="p-0"><span t-field="o.user_id.name"/></td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Columna 3: Estado -->
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Estado del Documento</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-1 p-0" style="width: 100%;">
                                    <tr>
                                        <td class="p-0"><strong>Fecha:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.date_order" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Moneda:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.currency_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 pt-1"><strong>Plazos:</strong></td>
                                        <td class="p-0 pt-1 text-end"><span t-field="o.payment_term_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- LÓGICA DE SEPARACIÓN (Manteniendo lógica original de Detalle) -->
                        <t t-set="materials" t-value="o.order_line.filtered(lambda l: l.product_id.type != 'service' and not l.display_type)"/>
                        <t t-set="services" t-value="o.order_line.filtered(lambda l: l.product_id.type == 'service' and not l.display_type)"/>

                        <!-- ================= TABLA 1: MATERIALES DETALLADOS (ESTILO A + COLUMNAS NUEVAS) ================= -->
                        <div t-if="materials">
                            <div class="mt-3 mb-1">
                                <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Suministro de Materiales (Detalle de Lotes)</strong>
                            </div>
                            
                            <!-- Tabla con Cabecera Negra (Estilo A) -->
                            <table class="table table-sm table-striped" style="width: 100%; font-size: 9px; border-collapse: collapse;">
                                <thead>
                                    <tr style="border-bottom: 2px solid #000; background-color: #000; color: #fff;">
                                        <th class="text-center" style="color: #fff; width: 3%;">#</th>
                                        <th style="color: #fff; width: 12%;">Lote</th>
                                        <th style="color: #fff; width: 8%;">Bloque</th>
                                        <th style="color: #fff; width: 8%;">Atado</th>
                                        <th class="text-center" style="color: #fff; width: 5%;">Grosor</th>
                                        <th class="text-center" style="color: #fff; width: 5%;">Alto</th>
                                        <th class="text-center" style="color: #fff; width: 5%;">Ancho</th>
                                        <th class="text-end" style="color: #fff; width: 8%;">m²</th>
                                        
                                        <!-- NUEVAS COLUMNAS FINANCIERAS -->
                                        <th class="text-end" style="color: #fff; width: 10%;">P. Unit.</th>
                                        <th class="text-end" style="color: #fff; width: 10%;">Subtotal</th>
                                        <th class="text-end" style="color: #fff; width: 8%;">IVA</th>
                                        <th class="text-end" style="color: #fff; width: 12%;">Total</th>
                                    </tr>
                                </thead>
                                <tbody style="border-bottom: 1px solid #000;">
                                    <t t-set="global_seq" t-value="1"/>
                                    
                                    <t t-foreach="materials" t-as="line">
                                        <!-- Sub-encabezado del Producto -->
                                        <tr style="background-color: #444; color: #fff;">
                                            <td colspan="12" style="padding: 2px 8px; font-weight: bold; font-size: 9px; text-transform: uppercase;">
                                                <span t-field="line.product_id.display_name"/>
                                            </td>
                                        </tr>

                                        <!-- CASO A: TIENE LOTES (Desglose) -->
                                        <t t-if="line.x_selected_lots">
                                            <t t-foreach="line.x_selected_lots" t-as="quant">
                                                <!-- Cálculos proporcionales por línea de lote para mostrar IVA/Total correctos visualmente -->
                                                <t t-set="row_subtotal" t-value="quant.quantity * line.price_unit"/>
                                                <!-- Calculamos el ratio de esta placa respecto a la línea total para el impuesto -->
                                                <t t-set="tax_ratio" t-value="0"/>
                                                <t t-if="line.product_uom_qty > 0">
                                                    <t t-set="tax_ratio" t-value="quant.quantity / line.product_uom_qty"/>
                                                </t>
                                                <t t-set="row_tax" t-value="line.price_tax * tax_ratio"/>
                                                <t t-set="row_total" t-value="row_subtotal + row_tax"/>

                                                <tr>
                                                    <td class="text-center align-middle">
                                                        <span t-esc="global_seq"/>
                                                        <t t-set="global_seq" t-value="global_seq + 1"/>
                                                    </td>
                                                    <td class="align-middle"><strong t-field="quant.lot_id.name"/></td>
                                                    <td class="align-middle"><span t-field="quant.lot_id.x_bloque"/></td>
                                                    <td class="align-middle"><span t-field="quant.lot_id.x_atado"/></td>
                                                    <td class="text-center align-middle"><span t-field="quant.lot_id.x_grosor" t-options='{"precision": 2}'/></td>
                                                    <td class="text-center align-middle"><span t-field="quant.lot_id.x_alto" t-options='{"precision": 3}'/></td>
                                                    <td class="text-center align-middle"><span t-field="quant.lot_id.x_ancho" t-options='{"precision": 3}'/></td>
                                                    <td class="text-end align-middle">
                                                        <strong t-field="quant.quantity" t-options='{"precision": 2}'/>
                                                    </td>

                                                    <!-- DATOS FINANCIEROS -->
                                                    <td class="text-end align-middle">
                                                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                    <td class="text-end align-middle">
                                                        <span t-esc="row_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                    <td class="text-end align-middle">
                                                        <span t-esc="row_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                    <td class="text-end align-middle" style="font-weight: bold;">
                                                        <span t-esc="row_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>

                                        <!-- CASO B: NO TIENE LOTES (Línea general) -->
                                        <t t-else="">
                                            <tr>
                                                <td class="text-center align-middle"><span t-esc="global_seq"/><t t-set="global_seq" t-value="global_seq + 1"/></td>
                                                <td colspan="6" class="align-middle" style="font-style: italic; color: #555; font-size: 8px;">(Sin selección de placas específicas)</td>
                                                <td class="text-end align-middle">
                                                    <strong t-field="line.product_uom_qty" t-options='{"precision": 2}'/>
                                                </td>
                                                <td class="text-end align-middle">
                                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                                <td class="text-end align-middle">
                                                    <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                                <td class="text-end align-middle">
                                                    <span t-field="line.price_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                                <td class="text-end align-middle" style="font-weight: bold;">
                                                    <span t-field="line.price_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- ================= TABLA 2: SERVICIOS (ESTILO A + COLUMNAS) ================= -->
                        <div t-if="services" style="margin-top: 15px;">
                            <div class="mb-1">
                                <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Servicios Adicionales</strong>
                            </div>
                            <table class="table table-sm" style="width: 100%; font-size: 9px; border-collapse: collapse; border-bottom: 1px solid #000;">
                                <thead>
                                    <tr style="border-bottom: 2px solid #000; background-color: #000; color: #fff;">
                                        <th style="width: 30%; font-weight: bold; color: #fff;">Descripción</th>
                                        <th class="text-end" style="width: 10%; font-weight: bold; color: #fff;">Cantidad</th>
                                        <th class="text-end" style="width: 10%; font-weight: bold; color: #fff;">Precio Unitario</th>
                                        <th class="text-end" style="width: 15%; font-weight: bold; color: #fff;">Subtotal</th>
                                        <th class="text-end" style="width: 15%; font-weight: bold; color: #fff;">IVA</th>
                                        <th class="text-end" style="width: 20%; font-weight: bold; color: #fff;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="services" t-as="line">
                                        <tr>
                                            <td class="align-middle"><span t-field="line.name"/></td>
                                            <td class="text-end align-middle">
                                                <span t-field="line.product_uom_qty"/> <span t-field="line.product_id.uom_id.name"/>
                                            </td>
                                            <td class="text-end align-middle">
                                                <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-end align-middle">
                                                <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-end align-middle">
                                                <span t-field="line.price_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                            <td class="text-end align-middle" style="font-weight: bold;">
                                                <span t-field="line.price_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- ================= TOTALES (ESTILO A) ================= -->
                        <div class="row mt-2">
                            <div class="col-6"></div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size: 9px; border-top: 2px solid #000;">
                                    <tr style="font-weight: bold;">
                                        <td class="text-end">SUBTOTAL</td>
                                        <td class="text-end" style="width: 30%;">
                                            <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="font-weight: bold; color: #555;">
                                        <td class="text-end">IMPUESTOS</td>
                                        <td class="text-end">
                                            <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="font-weight: 900; font-size: 11px; border-top: 1px solid #ccc;">
                                        <td class="text-end">TOTAL</td>
                                        <td class="text-end">
                                            <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ================= FOOTER / FIRMAS (ESTILO A) ================= -->
                        <div style="margin-top: 250px; width: 100%; page-break-inside: avoid;">
                            <div class="row" style="margin-top: 40px; margin-bottom: 10px;">
                                <div class="col-1"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL VENDEDOR</strong>
                                    </div>
                                </div>
                                <div class="col-2"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL CLIENTE</strong>
                                    </div>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <div class="row mt-2">
                                <div class="col-12">
                                    <div style="border: 1px solid #ccc; padding: 8px; background-color: #fafafa;">
                                        <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                            Términos y Condiciones Comerciales
                                        </strong>
                                        <div class="mb-1" style="font-size: 8px; text-align: justify; color: #555;">
                                            <p class="mb-1"><strong>1. NATURALEZA DEL PRODUCTO:</strong> La piedra natural (mármol, granito, cuarcita, ónix, etc.) es un producto de la naturaleza y está sujeta a variaciones de tono, color y veta. Las muestras son indicativas.</p>
                                            <p class="mb-0"><strong>2. ACEPTACIÓN:</strong> La firma de remisión o salida del almacén constituye aceptación total de la calidad. No se aceptan reclamaciones tras el corte o instalación.</p>
                                            <span t-field="o.note" style="display: block; margin-top: 5px; font-style: italic;"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>