<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sobrescribir el documento base del reporte de ventas original -->
    <template id="report_sale_order_document_inherit_marmol" inherit_id="sale.report_saleorder_document">
        
        <!-- 1. OCULTAR DIRECCIÓN ESTÁNDAR -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address" t-value="False"/>
        </xpath>

        <!-- 2. OCULTAR INFORMACIÓN BLOCK -->
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block" t-value="False"/>
        </xpath>

        <!-- 3. CONTENIDO PERSONALIZADO -->
        <xpath expr="//div[hasclass('page')]" position="replace">
            <!-- 
                VUELTA A LA NORMALIDAD: 
                Quitamos min-height y absolute. Ahora el diseño fluye naturalmente.
            -->
            <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">
                
                <!-- ================= ENCABEZADO (DISEÑO A) ================= -->
                <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                    <div class="col-8">
                        <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                            <span t-if="doc.state in ['draft','sent']">Cotización</span>
                            <span t-else="">Orden de Venta</span>
                            <span t-field="doc.name" style="margin-left: 10px; color: #333;"/>
                        </h4>
                    </div>
                    <div class="col-4 text-end">
                        <div style="font-size: 8px; color: #999; margin-top: 4px;">
                            Impreso: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </div>
                </div>

                <!-- ALERTA DE VENCIMIENTO (DISEÑO A) -->
                <div class="row mb-4" t-if="doc.validity_date and doc.state in ['draft', 'sent']">
                    <div class="col-12">
                        <div style="border: 4px solid #ff0000; background-color: #fff5f5; padding: 8px; width: 100%;">
                            <div style="color: #ff0000; font-weight: 900; font-size: 14px; text-transform: uppercase;">
                                ⚠️ OFERTA VÁLIDA HASTA: <span t-field="doc.validity_date" t-options='{"widget": "date"}'/>
                            </div>
                            <div style="color: #333; font-size: 10px; margin-top: 3px; font-style: italic;">
                                A partir de esa fecha, los precios y la disponibilidad de los lotes pueden cambiar sin previo aviso.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= INFORMACIÓN GENERAL ================= -->
                <div class="row mb-2" id="informations">
                    <!-- Columna 1: Cliente -->
                    <div class="col-4">
                        <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                            <strong style="font-size: 10px; text-transform: uppercase;">Cliente</strong>
                        </div>
                        <div style="line-height: 1.2; padding-left: 2px;">
                            <span style="font-weight: bold; font-size: 12px;" t-field="doc.partner_id.name"/><br/>
                            <span t-if="doc.partner_id.vat">RFC: <span t-field="doc.partner_id.vat"/></span>
                        </div>
                        <div class="mt-1" style="border-top: 1px dotted #9f9f9fff; padding-top: 1px;">
                            <strong style="font-size: 9px; text-transform: uppercase; color: #555; display: block;">Dirección Fiscal / Entrega:</strong>
                            <div style="font-size: 9px; color: #333; line-height: 1.1; margin-top: 2px;">
                                <span t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            </div>
                        </div>
                    </div>

                    <!-- Columna 2: Referencias -->
                    <div class="col-4">
                        <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                            <strong style="font-size: 10px; text-transform: uppercase;">Detalles del Proyecto</strong>
                        </div>
                        <table class="table table-borderless table-sm mb-0 p-0" style="width: 100%;">
                            <tr>
                                <td class="p-0" style="width: 35%;"><strong>Proyecto:</strong></td>
                                <td class="p-0">
                                    <span t-if="doc.x_project_id" t-field="doc.x_project_id.name"/>
                                    <span t-else="">-</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="p-0"><strong>Arquitecto:</strong></td>
                                <td class="p-0">
                                    <span t-if="doc.x_architect_id" t-field="doc.x_architect_id.name"/>
                                    <span t-else="">-</span>
                                </td>
                            </tr>
                            <tr t-if="doc.client_order_ref">
                                <td class="p-0"><strong>Ref. Cliente:</strong></td>
                                <td class="p-0"><span t-field="doc.client_order_ref"/></td>
                            </tr>
                            <tr>
                                <td class="p-0"><strong>Vendedor:</strong></td>
                                <td class="p-0"><span t-field="doc.user_id.name"/></td>
                            </tr>
                        </table>
                    </div>

                    <!-- Columna 3: Estado -->
                    <div class="col-4">
                        <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                            <strong style="font-size: 10px; text-transform: uppercase;">Estado del Documento</strong>
                        </div>
                        <table class="table table-borderless table-sm mb-1 p-0" style="width: 100%;">
                            <tr>
                                <td class="p-0"><strong>Fecha:</strong></td>
                                <td class="p-0 text-end"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                            </tr>
                            <tr>
                                <td class="p-0"><strong>Moneda:</strong></td>
                                <td class="p-0 text-end"><span t-field="doc.currency_id.name"/></td>
                            </tr>
                            <tr>
                                <td class="p-0 pt-1"><strong>Plazos:</strong></td>
                                <td class="p-0 pt-1 text-end"><span t-field="doc.payment_term_id.name"/></td>
                            </tr>
                           
                        </table>
                    </div>
                </div>

                <!-- ================= LÓGICA DE PROCESAMIENTO ================= -->
                <t t-set="material_summary" t-value="{}"/>
                <t t-set="service_summary" t-value="{}"/>
                <t t-foreach="doc.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="key" t-value="line.product_id.id"/>
                        <t t-if="line.product_id.type == 'service'">
                            <t t-if="key not in service_summary">
                                <t t-set="dummy" t-value="service_summary.update({key: {
                                    'name': line.product_id.display_name, 
                                    'qty_total': 0.0, 
                                    'uom': line.product_id.uom_id.name,
                                    'price_unit': line.price_unit,
                                    'subtotal': 0.0,
                                    'tax': 0.0,
                                    'total': 0.0
                                }})"/>
                            </t>
                            <t t-set="dummy" t-value="service_summary[key].update({
                                'qty_total': service_summary[key]['qty_total'] + line.product_uom_qty, 
                                'price_unit': line.price_unit,
                                'subtotal': service_summary[key]['subtotal'] + line.price_subtotal,
                                'tax': service_summary[key]['tax'] + line.price_tax,
                                'total': service_summary[key]['total'] + line.price_total
                            })"/>
                        </t>
                        <t t-else="">
                            <t t-if="key not in material_summary">
                                <t t-set="dummy" t-value="material_summary.update({key: {
                                    'name': line.product_id.display_name, 
                                    'qty_lot': 0, 
                                    'qty_total': 0.0, 
                                    'uom': line.product_id.uom_id.name,
                                    'price_unit': line.price_unit,
                                    'subtotal': 0.0,
                                    'tax': 0.0,
                                    'total': 0.0
                                }})"/>
                            </t>
                            <t t-set="current_plates" t-value="len(line.x_selected_lots) if line.x_selected_lots else 0"/>
                            <t t-set="dummy" t-value="material_summary[key].update({
                                'qty_lot': material_summary[key]['qty_lot'] + current_plates, 
                                'qty_total': material_summary[key]['qty_total'] + line.product_uom_qty,
                                'price_unit': line.price_unit,
                                'subtotal': material_summary[key]['subtotal'] + line.price_subtotal,
                                'tax': material_summary[key]['tax'] + line.price_tax,
                                'total': material_summary[key]['total'] + line.price_total
                            })"/>
                        </t>
                    </t>
                </t>

                <!-- ================= TABLA 1: MATERIALES ================= -->
                <div class="mt-3 mb-1">
                    <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Suministro de Materiales</strong>
                </div>
                
                <table class="table table-sm table-striped" style="width: 100%; font-size: 9px; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid #000; background-color: #000; color: #fff;">
                            <!-- Ajustado ancho de 35% a 25% para dar espacio al precio unitario -->
                            <th name="th_description" style="color: #fff; width: 25%; padding: 4px 8px; font-weight: bold;">Descripción</th>
                            <th class="text-center" style="color: #fff;width: 10%; padding: 4px 8px; font-weight: bold;">Placas</th>
                            <th name="th_quantity" class="text-end" style="color: #fff; width: 10%; padding: 4px 8px; font-weight: bold;">Cantidad</th>
                            <!-- Columna Nueva: Precio Unitario -->
                            <th name="th_price_unit_display" class="text-end" style="color: #fff; width: 15%; padding: 4px 8px; font-weight: bold;">Precio Unitario</th>
                            
                            <th name="th_priceunit" t-if="False"></th>
                            <th name="th_discount" t-if="False"></th>
                            <th name="th_taxes" t-if="False"></th>
                            <th name="th_subtotal" class="text-end" style="color: #fff; width: 15%; padding: 4px 8px; font-weight: bold;">Subtotal</th>
                            <th name="th_iva_custom" class="text-end" style="color: #fff; width: 10%; padding: 4px 8px; font-weight: bold;">IVA</th>
                            <th name="th_total_custom" class="text-end" style="color: #fff; width: 15%; padding: 4px 8px; font-weight: bold;">Total</th>
                        </tr>
                    </thead>
                    <tbody style="border-bottom: 1px solid #000;">
                        <t t-foreach="material_summary.values()" t-as="data">
                            <tr>
                                <td name="td_name" class="align-middle" style="padding: 4px 8px;">
                                    <strong t-esc="data['name']"/>
                                </td>
                                <td class="text-center align-middle">
                                    <span t-if="data['qty_lot'] > 0" t-esc="data['qty_lot']" style="font-weight: bold;"/>
                                    <span t-else="" style="color: #999;">-</span>
                                </td>
                                <td name="td_quantity" class="text-end align-middle">
                                    <span t-esc="'%.2f' % data['qty_total']"/> <span t-esc="data['uom']"/>
                                </td>
                                <!-- Dato Nuevo: Precio Unitario -->
                                <td name="td_price_unit_display" class="text-end align-middle">
                                    <span t-esc="data['price_unit']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>

                                <td name="td_priceunit" t-if="False"></td>
                                <td name="td_discount" t-if="False"></td>
                                <td name="td_taxes" t-if="False"></td>
                                <td name="td_product_quantity" t-if="False"></td>
                                <td name="td_product_discount" t-if="False"></td>
                                <td name="td_subtotal" class="text-end align-middle">
                                    <span t-esc="data['subtotal']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                                <td name="td_iva_custom" class="text-end align-middle">
                                    <span t-esc="data['tax']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                                <td name="td_total_custom" class="text-end align-middle" style="font-weight: bold;">
                                    <span t-esc="data['total']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <tr t-if="not material_summary">
                            <td colspan="7" class="text-center" style="font-style: italic; color: #777;">Sin materiales físicos seleccionados.</td>
                        </tr>
                    </tbody>
                </table>

                <!-- ================= TABLA 2: SERVICIOS ================= -->
                <div t-if="service_summary" style="margin-top: 15px;">
                    <div class="mb-1">
                        <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Servicios Adicionales</strong>
                    </div>
                    <table class="table table-sm" style="width: 100%; font-size: 9px; border-collapse: collapse; border-bottom: 1px solid #000;">
                        <thead>
                            <tr style="border-bottom: 2px solid #000; background-color: #000; color: #fff;">
                                <!-- Ajustado ancho de 40% a 30% -->
                                <th style="width: 30%; font-weight: bold; color: #fff;">Descripción</th>
                                <th class="text-end" style="width: 10%; font-weight: bold; color: #fff;">Cantidad</th>
                                <!-- Columna Nueva: Precio Unitario (10%) -->
                                <th class="text-end" style="width: 10%; font-weight: bold; color: #fff;">Precio Unitario</th>
                                <th class="text-end" style="width: 15%; font-weight: bold; color: #fff;">Subtotal</th>
                                <th class="text-end" style="width: 15%; font-weight: bold; color: #fff;">IVA</th>
                                <th class="text-end" style="width: 20%; font-weight: bold; color: #fff;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="service_summary.values()" t-as="data">
                                <tr>
                                    <td class="align-middle"><span t-esc="data['name']"/></td>
                                    <td class="text-end align-middle">
                                        <span t-esc="'%.2f' % data['qty_total']"/> <span t-esc="data['uom']"/>
                                    </td>
                                    <!-- Dato Nuevo: Precio Unitario -->
                                    <td class="text-end align-middle">
                                        <span t-esc="data['price_unit']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle">
                                        <span t-esc="data['subtotal']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle">
                                        <span t-esc="data['tax']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle" style="font-weight: bold;">
                                        <span t-esc="data['total']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- ================= TOTALES ================= -->
                <div class="row mt-2">
                    <div class="col-6"></div>
                    <div class="col-6">
                        <table class="table table-sm table-borderless" style="font-size: 9px; border-top: 2px solid #000;">
                            <tr style="font-weight: bold;">
                                <td class="text-end">SUBTOTAL</td>
                                <td class="text-end" style="width: 30%;">
                                    <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr style="font-weight: bold; color: #555;">
                                <td class="text-end">IMPUESTOS</td>
                                <td class="text-end">
                                    <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr style="font-weight: 900; font-size: 11px; border-top: 1px solid #ccc;">
                                <td class="text-end">TOTAL</td>
                                <td class="text-end">
                                    <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- ✅ BLOQUE OCULTO DE TOTALES -->
                <div class="clearfix" name="so_total_summary" t-if="False">
                    <div id="total" class="row" name="total">
                        <div class="col-6"></div>
                    </div>
                </div>

                <!-- ================= FOOTER / FIRMAS (DISEÑO A) ================= -->
                <!-- 
                     CAMBIO SOLICITADO:
                     Quitamos absolute y bottom:0.
                     Usamos margin-top: 50px para separar.
                     page-break-inside: avoid se queda para no cortar el bloque.
                -->
                <div style="margin-top: 250px; width: 100%; page-break-inside: avoid;">
                    <div class="row" style="margin-top: 40px; margin-bottom: 10px;">
                        <div class="col-1"></div>
                        <div class="col-4 text-center">
                            <div style="border-top: 1px solid #000; padding-top: 5px;">
                                <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL VENDEDOR</strong>
                            </div>
                        </div>
                        <div class="col-2"></div>
                        <div class="col-4 text-center">
                            <div style="border-top: 1px solid #000; padding-top: 5px;">
                                <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL CLIENTE</strong>
                            </div>
                        </div>
                        <div class="col-1"></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-12">
                            <div style="border: 1px solid #ccc; padding: 8px; background-color: #fafafa;">
                                <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                    Términos y Condiciones Comerciales
                                </strong>
                                <div class="mb-1" style="font-size: 8px; text-align: justify; color: #555;">
                                    <p class="mb-1"><strong>1. NATURALEZA DEL PRODUCTO:</strong> La piedra natural (mármol, granito, cuarcita, ónix, etc.) es un producto de la naturaleza y está sujeta a variaciones de tono, color y veta. Las muestras son indicativas.</p>
                                    <p class="mb-0"><strong>2. ACEPTACIÓN:</strong> La firma de remisión o salida del almacén constituye aceptación total de la calidad. No se aceptan reclamaciones tras el corte o instalación.</p>
                                    <span t-field="doc.note" style="display: block; margin-top: 5px; font-style: italic;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </xpath>
    </template>
</odoo>