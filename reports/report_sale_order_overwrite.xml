<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sale_order_document_inherit_marmol" inherit_id="sale.report_saleorder_document">

        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address" t-value="False"/>
        </xpath>

        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block" t-value="False"/>
        </xpath>

        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000; line-height: 1.25;">

                <style type="text/css">
                    /* Evita superposición del thead en saltos de página */
                    thead { display: table-row-group; }
                    tbody { display: table-row-group; }
                    tfoot { display: table-row-group; }
                    tr { page-break-inside: avoid; break-inside: avoid; }
                </style>

                <!-- Anchors ocultos para herencias de Odoo (proforma, portal). NO BORRAR. -->
                <div style="display: none;">
                    <table>
                        <thead>
                            <tr>
                                <th name="th_description"/>
                                <th name="th_quantity"/>
                                <th name="th_priceunit"/>
                                <th name="th_discount"/>
                                <th name="th_taxes"/>
                                <th name="th_subtotal"/>
                                <th name="th_price_unit_display"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td name="td_name"/>
                                <td name="td_quantity"/>
                                <td name="td_priceunit"/>
                                <td name="td_discount"/>
                                <td name="td_taxes"/>
                                <td name="td_subtotal"/>
                                <td name="td_product_quantity"/>
                                <td name="td_product_discount"/>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- ENCABEZADO -->
                <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                    <div class="col-8">
                        <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                            <span t-if="doc.state in ['draft', 'sent']">Cotización</span>
                            <span t-else="">Orden de Venta</span>
                            <span t-field="doc.name" style="margin-left: 10px; color: #333;"/>
                        </h4>
                    </div>
                    <div class="col-4 text-end">
                        <div style="font-size: 14px; color: #505050; margin-top: 4px;">
                            Impreso: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </div>
                </div>

                <!-- ALERTA DE VENCIMIENTO -->
                <div class="row mb-4" t-if="doc.validity_date and doc.state in ['draft', 'sent']">
                    <div class="col-12">
                        <div style="border: 4px solid #ff0000; background-color: #fff5f5; padding: 8px; width: 100%; box-sizing: border-box;">
                            <div style="color: #ff0000; font-weight: 900; font-size: 14px; text-transform: uppercase; overflow-wrap: anywhere; word-break: break-word;">
                                ⚠️ OFERTA VÁLIDA HASTA: <span t-field="doc.validity_date" t-options='{"widget": "date"}'/>
                            </div>
                            <div style="color: #333; font-size: 10px; margin-top: 3px; font-style: italic; overflow-wrap: anywhere; word-break: break-word;">
                                A partir de esa fecha, los precios y la disponibilidad de los materiales pueden cambiar sin previo aviso.
                            </div>
                        </div>
                    </div>
                </div>

                <!-- INFORMACIÓN GENERAL (3 COLUMNAS) -->
                <div id="informations" style="margin-bottom: 12px; font-size: 0;">

                    <t t-set="state_label"
                       t-value="'Borrador' if doc.state == 'draft' else 'Cotización Enviada' if doc.state == 'sent' else 'Orden Confirmada' if doc.state == 'sale' else 'Cerrada' if doc.state == 'done' else 'Cancelada' if doc.state == 'cancel' else doc.state"/>

                    <!-- COL 1: CLIENTE -->
                    <div style="display: inline-block; width: 38%; vertical-align: top; padding-right: 8px; box-sizing: border-box; font-size: 10px;">
                        <table style="font-size: 9px; width: 100%; border-collapse: collapse; border: 1px solid #bbb; table-layout: fixed;">
                            <thead>
                                <tr style="background-color: #2f2f2f; color: #fff;">
                                    <th style="padding: 5px 8px; text-align: left; font-weight: 800; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.5px;">Cliente</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 6px 8px; overflow-wrap: anywhere; word-break: break-word;">
                                        <span style="font-weight: bold; font-size: 11px;" t-field="doc.partner_id.name"/>
                                        <span t-if="doc.partner_id.vat" style="display: block; font-size: 8.5px; color: #555; margin-top: 2px;">RFC: <span t-field="doc.partner_id.vat"/></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 6px 8px; overflow-wrap: anywhere; word-break: break-word;">
                                        <strong style="font-size: 8.5px; text-transform: uppercase; color: #555; display: block; letter-spacing: 0.3px;">Dirección Fiscal / Entrega</strong>
                                        <div style="font-size: 9px; color: #333; line-height: 1.25; margin-top: 3px; overflow-wrap: anywhere; word-break: break-word;">
                                            <span t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- COL 2: DETALLES DEL PROYECTO -->
                    <div style="display: inline-block; width: 30%; vertical-align: top; padding-right: 8px; box-sizing: border-box; font-size: 10px;">
                        <table style="font-size: 9px; width: 100%; border-collapse: collapse; border: 1px solid #bbb; table-layout: fixed;">
                            <thead>
                                <tr style="background-color: #2f2f2f; color: #fff;">
                                    <th colspan="2" style="padding: 5px 8px; text-align: left; font-weight: 800; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.5px;">Detalles del Proyecto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 8px; width: 38%; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">Proyecto</td>
                                    <td style="padding: 5px 8px; font-weight: 600; overflow-wrap: anywhere; word-break: break-word;">
                                        <span t-if="doc.x_project_id" t-field="doc.x_project_id.name"/>
                                        <span t-else="" style="color: #aaa;">-</span>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">Arquitecto</td>
                                    <td style="padding: 5px 8px; font-weight: 600; overflow-wrap: anywhere; word-break: break-word;">
                                        <span t-if="doc.x_architect_id" t-field="doc.x_architect_id.name"/>
                                        <span t-else="" style="color: #aaa;">-</span>
                                    </td>
                                </tr>
                                <tr t-if="doc.client_order_ref" style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">Ref. Cliente</td>
                                    <td style="padding: 5px 8px; font-weight: 600; overflow-wrap: anywhere; word-break: break-word;"><span t-field="doc.client_order_ref"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">Vendedor</td>
                                    <td style="padding: 5px 8px; font-weight: 600; overflow-wrap: anywhere; word-break: break-word;"><span t-field="doc.user_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- COL 3: ESTADO DEL DOCUMENTO -->
                    <div style="display: inline-block; width: 32%; vertical-align: top; box-sizing: border-box; font-size: 10px;">
                        <table style="font-size: 9px; width: 100%; border-collapse: collapse; border: 1px solid #bbb; table-layout: fixed;">
                            <thead>
                                <tr style="background-color: #2f2f2f; color: #fff;">
                                    <th colspan="2" style="padding: 5px 8px; text-align: left; font-weight: 800; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.5px;">Estado del Documento</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 8px; width: 45%; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">Fecha</td>
                                    <td style="padding: 5px 8px; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums;">
                                        <span t-field="doc.date_order" t-options='{"widget": "date"}'/>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">Estado</td>
                                    <td style="padding: 5px 8px; text-align: right; font-weight: 600; overflow-wrap: anywhere; word-break: break-word;"><span t-esc="state_label"/></td>
                                </tr>
                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">Moneda</td>
                                    <td style="padding: 5px 8px; text-align: right; font-weight: 600;"><span t-field="doc.currency_id.name"/></td>
                                </tr>
                                <tr t-if="doc.x_is_usd" style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">T. Cambio</td>
                                    <td style="padding: 5px 8px; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums;">
                                        <span t-esc="'%.4f' % doc.x_exchange_rate"/> MXN/USD
                                    </td>
                                </tr>
                                <tr t-attf-style="#{'border-bottom: 1px solid #e5e5e5;' if doc.validity_date and doc.state in ['draft', 'sent'] else ''}">
                                    <td style="padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">Plazos</td>
                                    <td style="padding: 5px 8px; text-align: right; font-weight: 600; overflow-wrap: anywhere; word-break: break-word;">
                                        <span t-if="doc.payment_term_id" t-field="doc.payment_term_id.name"/>
                                        <span t-else="" style="color: #aaa;">-</span>
                                    </td>
                                </tr>
                                <tr t-if="doc.validity_date and doc.state in ['draft', 'sent']">
                                    <td style="padding: 5px 8px; color: #555; text-transform: uppercase; font-size: 8.5px; letter-spacing: 0.3px;">Vigencia</td>
                                    <td style="padding: 5px 8px; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums;">
                                        Hasta el <span t-field="doc.validity_date" t-options='{"widget": "date"}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>

                <!-- LÓGICA -->
                <t t-set="normal_lines" t-value="doc.order_line.filtered(lambda l: not l.display_type and l.price_subtotal &gt;= 0)"/>
                <t t-set="discount_lines" t-value="doc.order_line.filtered(lambda l: not l.display_type and l.price_subtotal &lt; 0)"/>

                <t t-set="has_line_discount_columns" t-value="False"/>
                <t t-foreach="normal_lines" t-as="chk_line">
                    <t t-if="(chk_line.discount or 0.0) &gt; 0">
                        <t t-set="has_line_discount_columns" t-value="True"/>
                    </t>
                </t>

                <t t-set="placas_lines" t-value="normal_lines.filtered(lambda l: l.product_id.type != 'service' and 'Placas' in (l.product_id.categ_id.complete_name or ''))"/>
                <t t-set="formatos_lines" t-value="normal_lines.filtered(lambda l: l.product_id.type != 'service' and 'Formatos' in (l.product_id.categ_id.complete_name or ''))"/>
                <t t-set="adhesivos_lines" t-value="normal_lines.filtered(lambda l: l.product_id.type != 'service' and ('Adhesivos' in (l.product_id.categ_id.complete_name or '') or 'Selladores' in (l.product_id.categ_id.complete_name or '')))"/>
                <t t-set="accesorios_lines" t-value="normal_lines.filtered(lambda l: l.product_id.type != 'service' and 'Accesorios' in (l.product_id.categ_id.complete_name or ''))"/>
                <t t-set="services" t-value="normal_lines.filtered(lambda l: l.product_id.type == 'service' or 'Servicios' in (l.product_id.categ_id.complete_name or ''))"/>
                <t t-set="classified_ids" t-value="(placas_lines | formatos_lines | adhesivos_lines | accesorios_lines | services).ids"/>
                <t t-set="otros_lines" t-value="normal_lines.filtered(lambda l: l.id not in classified_ids)"/>

                <t t-set="gross_total_amount" t-value="0.0"/>
                <t t-set="line_discount_total_amount" t-value="0.0"/>
                <t t-set="global_discount_total_amount" t-value="0.0"/>

                <t t-foreach="normal_lines" t-as="calc_line">
                    <t t-set="line_gross" t-value="calc_line.price_unit * calc_line.product_uom_qty"/>
                    <t t-set="line_discount_amount" t-value="(line_gross - calc_line.price_subtotal) if line_gross &gt;= calc_line.price_subtotal else 0.0"/>
                    <t t-set="gross_total_amount" t-value="gross_total_amount + line_gross"/>
                    <t t-set="line_discount_total_amount" t-value="line_discount_total_amount + line_discount_amount"/>
                </t>

                <t t-foreach="discount_lines" t-as="disc_line">
                    <t t-set="global_discount_total_amount" t-value="global_discount_total_amount + abs(disc_line.price_subtotal)"/>
                </t>

                <t t-set="total_discount_amount" t-value="line_discount_total_amount + global_discount_total_amount"/>
                <t t-set="global_seq" t-value="1"/>

                <!-- ================= TABLAS POR CATEGORÍA ================= -->
                <t t-foreach="[
                    (placas_lines, 'Placas'),
                    (formatos_lines, 'Formatos'),
                    (adhesivos_lines, 'Adhesivos y Selladores'),
                    (accesorios_lines, 'Accesorios'),
                    (otros_lines, 'Otros Materiales'),
                    (services, 'Servicios')
                ]" t-as="section">
                    <t t-set="section_lines" t-value="section[0]"/>
                    <t t-set="section_title" t-value="section[1]"/>

                    <t t-if="section_lines">
                        <div style="margin-top: 12px; margin-bottom: 4px;">
                            <strong style="display: inline-block; font-size: 10px; font-weight: 800; text-transform: uppercase; background-color: #2f2f2f; color: #fff; padding: 5px 10px; letter-spacing: 0.5px;" t-esc="section_title"/>
                        </div>

                        <table class="table table-sm table-striped"
                               style="width: 100%; font-size: 9px; border-collapse: collapse; table-layout: fixed; page-break-inside: auto;">
                            <thead>
                                <tr style="background-color: #2f2f2f; color: #fff;">
                                    <th class="text-center" style="color: #fff; width: 4%; font-weight: bold;">#</th>
                                    <th style="color: #fff; width: 32%; font-weight: bold;">Descripción</th>
                                    <th class="text-end" style="color: #fff; width: 10%; font-weight: bold;">Cantidad</th>
                                    <th class="text-end" style="color: #fff; width: 12%; font-weight: bold;">P. Unitario</th>
                                    <th t-if="has_line_discount_columns" class="text-end" style="color: #fff; width: 7%; font-weight: bold;">% Desc.</th>
                                    <th t-if="has_line_discount_columns" class="text-end" style="color: #fff; width: 9%; font-weight: bold;">Descuento</th>
                                    <th class="text-end" style="color: #fff; width: 10%; font-weight: bold;">Subtotal</th>
                                    <th class="text-end" style="color: #fff; width: 8%; font-weight: bold;">IVA</th>
                                    <th class="text-end" style="color: #fff; width: 10%; font-weight: bold;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="section_lines" t-as="line">
                                    <t t-set="line_discount_pct" t-value="line.discount or 0.0"/>
                                    <t t-set="line_gross" t-value="line.price_unit * line.product_uom_qty"/>
                                    <t t-set="line_discount_amount" t-value="(line_gross - line.price_subtotal) if line_gross &gt;= line.price_subtotal else 0.0"/>

                                    <tr style="page-break-inside: avoid;">
                                        <td class="text-center align-middle" style="overflow-wrap: anywhere; word-break: break-word;">
                                            <span t-esc="global_seq"/>
                                            <t t-set="global_seq" t-value="global_seq + 1"/>
                                        </td>

                                        <td class="align-middle" style="white-space: normal; overflow-wrap: anywhere; word-break: break-word; line-height: 1.2;">
                                            <span t-field="line.name"/>
                                        </td>

                                        <td class="text-end align-middle" style="white-space: normal; overflow-wrap: anywhere; word-break: break-word;">
                                            <span t-field="line.product_uom_qty"/>
                                            <span t-field="line.product_id.uom_id.name"/>
                                        </td>

                                        <td class="text-end align-middle" style="white-space: nowrap;">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>

                                        <td t-if="has_line_discount_columns" class="text-end align-middle" style="white-space: nowrap;">
                                            <span t-if="line_discount_pct &gt; 0" t-esc="'%.2f%%' % line_discount_pct"/>
                                            <span t-else="" style="color: #999;">-</span>
                                        </td>

                                        <td t-if="has_line_discount_columns" class="text-end align-middle" style="white-space: nowrap;">
                                            <span t-if="line_discount_amount &gt; 0" style="color: #b00020; font-weight: 700;">
                                                -<span t-esc="line_discount_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </span>
                                            <span t-else="" style="color: #999;">-</span>
                                        </td>

                                        <td class="text-end align-middle" style="white-space: nowrap;">
                                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>

                                        <td class="text-end align-middle" style="white-space: nowrap;">
                                            <span t-field="line.price_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>

                                        <td class="text-end align-middle" style="font-weight: bold; white-space: nowrap;">
                                            <span t-field="line.price_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </t>

                <!-- ================= DESCUENTOS GLOBALES ================= -->
                <div t-if="discount_lines" style="margin-top: 15px;">
                    <div class="mb-1">
                        <strong style="display: inline-block; font-size: 10px; font-weight: 800; text-transform: uppercase; background-color: #b00020; color: #fff; padding: 5px 10px; letter-spacing: 0.5px;">Descuentos Aplicados</strong>
                    </div>

                    <table class="table table-sm"
                           style="width: 100%; font-size: 9px; border-collapse: collapse; border-bottom: 1px solid #b00020; table-layout: fixed;">
                        <thead>
                            <tr style="border-bottom: 2px solid #b00020; background-color: #b00020; color: #fff;">
                                <th style="width: 55%; font-weight: bold; color: #fff;">Concepto</th>
                                <th class="text-end" style="width: 15%; font-weight: bold; color: #fff;">Subtotal</th>
                                <th class="text-end" style="width: 10%; font-weight: bold; color: #fff;">IVA</th>
                                <th class="text-end" style="width: 20%; font-weight: bold; color: #fff;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="discount_lines" t-as="dline">
                                <tr>
                                    <td class="align-middle" style="white-space: normal; overflow-wrap: anywhere; word-break: break-word;">
                                        <span t-esc="dline.name or 'Descuento'"/>
                                    </td>
                                    <td class="text-end align-middle" style="color: #b00020; font-weight: 700; white-space: nowrap;">
                                        <span t-esc="dline.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle" style="color: #b00020; font-weight: 700; white-space: nowrap;">
                                        <span t-esc="dline.price_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-end align-middle" style="color: #b00020; font-weight: 800; white-space: nowrap;">
                                        <span t-esc="dline.price_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- ================= TOTALES ================= -->
                <div class="row mt-3">
                    <div class="col-7">
                        <div t-if="doc.note" style="border: 1px dashed #ccc; padding: 10px; margin-top: 5px;">
                            <strong style="font-size: 9px; text-transform: uppercase; color: #555;">Notas de la Orden:</strong>
                            <div style="font-size: 9px; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;" t-field="doc.note"/>
                        </div>
                    </div>

                    <div class="col-5">
                        <table style="font-size: 9.5px; width: 100%; border-collapse: collapse; border: 1px solid #bbb;">
                            <tbody>
                                <tr t-if="line_discount_total_amount &gt; 0" style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 10px; text-transform: uppercase; color: #b00020; font-weight: bold; letter-spacing: 0.3px;">Descuento en Líneas</td>
                                    <td style="padding: 5px 10px; width: 50%; text-align: right; color: #b00020; font-weight: bold; font-variant-numeric: tabular-nums; white-space: nowrap;">
                                        -<span t-esc="line_discount_total_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr t-if="global_discount_total_amount &gt; 0" style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 10px; text-transform: uppercase; color: #b00020; font-weight: bold; letter-spacing: 0.3px;">Desc. Globales</td>
                                    <td style="padding: 5px 10px; text-align: right; color: #b00020; font-weight: bold; font-variant-numeric: tabular-nums; white-space: nowrap;">
                                        -<span t-esc="global_discount_total_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr t-if="total_discount_amount &gt; 0" style="border-bottom: 1px solid #e5e5e5; background-color: #fff5f5;">
                                    <td style="padding: 5px 10px; text-transform: uppercase; color: #b00020; font-weight: 900; letter-spacing: 0.3px;">Descuento Total</td>
                                    <td style="padding: 5px 10px; text-align: right; color: #b00020; font-weight: 900; font-variant-numeric: tabular-nums; white-space: nowrap;">
                                        -<span t-esc="total_discount_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 10px; text-transform: uppercase; font-weight: bold; letter-spacing: 0.3px;">Subtotal</td>
                                    <td style="padding: 5px 10px; text-align: right; font-weight: bold; font-variant-numeric: tabular-nums; white-space: nowrap;">
                                        <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                    <td style="padding: 5px 10px; text-transform: uppercase; color: #555; letter-spacing: 0.3px;">IVA 16%</td>
                                    <td style="padding: 5px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums; white-space: nowrap;">
                                        <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                                <tr style="background-color: #2f2f2f; color: #fff;">
                                    <td style="padding: 8px 10px; font-weight: 900; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Total</td>
                                    <td style="padding: 8px 10px; text-align: right; font-weight: 900; font-size: 11px; font-variant-numeric: tabular-nums; white-space: nowrap;">
                                        <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- BLOQUE OCULTO -->
                <div class="clearfix" name="so_total_summary" t-if="False">
                    <div id="total" class="row" name="total">
                        <div class="col-6"></div>
                    </div>
                </div>

                <!-- FOOTER / FIRMAS -->
                <div style="margin-top: 50px; width: 100%; page-break-inside: avoid;">
                    <div class="row" style="margin-top: 40px; margin-bottom: 10px;">
                        <div class="col-1"></div>
                        <div class="col-4 text-center">
                            <div style="border-top: 1px solid #000; padding-top: 5px;">
                                <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL VENDEDOR</strong>
                            </div>
                        </div>
                        <div class="col-2"></div>
                        <div class="col-4 text-center">
                            <div style="border-top: 1px solid #000; padding-top: 5px;">
                                <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL CLIENTE</strong>
                            </div>
                        </div>
                        <div class="col-1"></div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-12">
                            <t t-set="company" t-value="doc.company_id"/>
                            <t t-call="stock_lot_dimensions.company_bank_details_block"/>

                            <div style="border: 1px solid #ccc; padding: 8px; background-color: #fafafa;">
                                <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                    <t t-if="doc.state in ('draft', 'sent')">Términos y Condiciones – Cotización</t>
                                    <t t-if="doc.state in ('sale', 'done')">Términos y Condiciones – Orden de Venta</t>
                                </strong>

                                <div style="font-size: 8px; text-align: justify; color: #555; overflow-wrap: anywhere; word-break: break-word;">
                                    <p style="margin: 0 0 3px 0;">• El mármol y granito son materiales naturales, por lo que pueden existir variaciones en coloración, vetas y tonalidad respecto a muestras o imágenes.</p>

                                    <t t-if="doc.state in ('draft', 'sent')">
                                        <p style="margin: 0 0 3px 0;">• Los precios están sujetos a disponibilidad y no garantizan existencia hasta recibir confirmación de pago.</p>
                                        <p style="margin: 0 0 3px 0;">• En materiales de importación o bajo pedido, los tiempos de entrega son estimados y pueden variar por causas ajenas a la empresa.</p>
                                        <p style="margin: 0 0 3px 0;">• En caso de existir variación en el tipo de cambio entre la fecha de cotización y el pago, se realizará el ajuste correspondiente al día del pago.</p>
                                        <p style="margin: 0 0 3px 0;">• La cotización no incluye maniobras especiales de descarga ni servicios adicionales, salvo que se especifique por escrito.</p>
                                        <p style="margin: 0;">• Los precios pueden cambiar sin previo aviso en caso de incrementos por parte del proveedor.</p>
                                    </t>

                                    <t t-if="doc.state in ('sale', 'done')">
                                        <p style="margin: 0 0 3px 0;">• La presente orden de venta confirma los materiales, cantidades y precios acordados con el cliente.</p>
                                        <p style="margin: 0 0 3px 0;">• En caso de devolución autorizada, el material deberá entregarse en las mismas condiciones en que fue recibido, sin daño, sin cortes y sin haber sido instalado.</p>
                                        <p style="margin: 0 0 3px 0;">• Después de 3 meses de almacenaje, se comenzará a generar un cargo de $7.00 MXN por m², por mes o fracción.</p>
                                        <p style="margin: 0 0 3px 0;">• La entrega del material está sujeta a que el pedido se encuentre liquidado al 100%.</p>
                                        <p style="margin: 0 0 3px 0;">• Cualquier aclaración deberá realizarse por escrito dentro de las 24 horas posteriores a la entrega.</p>
                                        <p style="margin: 0 0 3px 0;">• El cliente acepta las condiciones aquí descritas a partir del momento en que se recibe el anticipo y/o el pago total correspondiente a esta orden de venta.</p>
                                        <p style="margin: 0;">• El plazo de entrega será de 24 a 48 horas hábiles, contado a partir de la confirmación de disponibilidad del material y de la recepción del pago total correspondiente al pedido.</p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </xpath>
    </template>
</odoo>