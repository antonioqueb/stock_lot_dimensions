<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sobrescribir el documento base del reporte de ventas original -->
    <template id="report_sale_order_document_inherit_marmol" inherit_id="sale.report_saleorder_document">
        
        <!-- 1. OCULTAR DIRECCIÓN ESTÁNDAR -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address" t-value="False"/>
        </xpath>

        <!-- 2. OCULTAR INFORMACIÓN BLOCK -->
        <xpath expr="//t[@t-set='information_block']" position="replace">
            <t t-set="information_block" t-value="False"/>
        </xpath>

        <!-- 3. CONTENIDO PERSONALIZADO -->
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">
                
                <!-- ENCABEZADO -->
                <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                    <div class="col-12">
                        <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                            <span t-if="doc.state in ['draft','sent']">Cotización</span>
                            <span t-else="">Orden de Venta</span> 
                            <span t-field="doc.name" style="margin-left: 10px; color: #333;"/>
                        </h4>
                        <div style="font-size: 8px; color: #515151ff; margin-top: 5px;">
                            Impreso: <span t-esc="datetime.datetime.now().strftime('%d/%m/%Y %H:%M')"/>
                        </div>
                    </div>
                </div>

                <!-- ALERTA VENCIMIENTO -->
                <div class="row mb-4" t-if="doc.validity_date and doc.state in ['draft', 'sent']">
                    <div class="col-12">
                        <div style="border: 4px solid #ff0000; background-color: #fff5f5; padding: 8px; width: 100%;">
                            <div style="color: #ff0000; font-weight: 900; font-size: 16px; text-transform: uppercase;">
                                ⚠️ OFERTA VÁLIDA HASTA: <span t-field="doc.validity_date" t-options='{"widget": "date"}'/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN INTEGRADA: CLIENTE + TABLA DE REFERENCIAS Y ESTADO -->
                <div class="row" style="font-family: 'Helvetica', Arial, sans-serif; color: #000;">
                    
                    <!-- ENCABEZADOS DE SECCIÓN (Para imitar la imagen) -->
                    <div class="col-12 mb-1">
                        <table style="width: 100%; border-bottom: 2px solid #ccc;">
                            <tr>
                                <td style="width: 40%; padding-bottom: 5px;">
                                    <strong style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Cliente</strong>
                                </td>
                                <td style="width: 35%; padding-bottom: 5px;">
                                    <strong style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Referencia</strong>
                                </td>
                                <td style="width: 25%; padding-bottom: 5px;">
                                    <strong style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Estado</strong>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- CONTENIDO PRINCIPAL -->
                    <!-- COLUMNA IZQUIERDA: DATOS DEL CLIENTE (Limpio, sin caja) -->
                    <div class="col-5" style="padding-right: 20px;">
                        <!-- Nombre del Cliente -->
                        <div style="margin-bottom: 10px;">
                            <span t-field="doc.partner_id.name" style="font-weight: 900; font-size: 13px; display: block; margin-bottom: 2px;"/>
                            <span t-if="doc.partner_id.vat" style="font-size: 10px; color: #555;">RFC: <span t-field="doc.partner_id.vat"/></span>
                        </div>
                        
                        <!-- Dirección de Entrega -->
                        <div>
                            <strong style="font-size: 10px; color: #666; text-transform: uppercase;">Dirección de Entrega:</strong>
                            <div style="font-size: 10px; margin-top: 2px; line-height: 1.3;">
                                <span t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            </div>
                        </div>
                    </div>

                    <!-- COLUMNA DERECHA: TABLA UNIFICADA (Bordes visibles, sin fondo) -->
                    <div class="col-7">
                        <table class="table table-sm" style="width: 100%; border: 1px solid #333; font-size: 10px; margin-bottom: 0;">
                            <!-- FILA 1: Proyecto + Fecha -->
                            <tr>
                                <td style="width: 18%; font-weight: bold; border-right: 1px solid #333; border-bottom: 1px solid #333; vertical-align: middle;">
                                    Proyecto:
                                </td>
                                <td style="width: 42%; border-right: 2px solid #333; border-bottom: 1px solid #333; vertical-align: middle;">
                                    <span t-if="doc.x_project_id" t-field="doc.x_project_id.name"/>
                                    <span t-else="">-</span>
                                </td>
                                <td style="width: 18%; font-weight: bold; border-right: 1px solid #333; border-bottom: 1px solid #333; vertical-align: middle;">
                                    Fecha Emisión:
                                </td>
                                <td style="width: 22%; font-weight: bold; text-align: right; border-bottom: 1px solid #333; vertical-align: middle;">
                                    <span t-field="doc.date_order" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            
                            <!-- FILA 2: Arquitecto + Estatus -->
                            <tr>
                                <td style="font-weight: bold; border-right: 1px solid #333; border-bottom: 1px solid #333; vertical-align: middle;">
                                    Arquitecto:
                                </td>
                                <td style="border-right: 2px solid #333; border-bottom: 1px solid #333; vertical-align: middle;">
                                    <span t-if="doc.x_architect_id" t-field="doc.x_architect_id.name"/>
                                    <span t-else="">-</span>
                                </td>
                                <td style="font-weight: bold; border-right: 1px solid #333; border-bottom: 1px solid #333; vertical-align: middle;">
                                    Estatus:
                                </td>
                                <td style="font-weight: 900; text-align: right; text-transform: uppercase; border-bottom: 1px solid #333; vertical-align: middle;">
                                    <span t-field="doc.state"/>
                                </td>
                            </tr>

                            <!-- FILA 3: Vendedor (Ocupa espacio restante o celda vacía a la derecha) -->
                            <tr>
                                <td style="font-weight: bold; border-right: 1px solid #333; vertical-align: middle;">
                                    Vendedor:
                                </td>
                                <td style="border-right: 2px solid #333; vertical-align: middle;">
                                    <span t-field="doc.user_id.name"/>
                                </td>
                                <td colspan="2" style="background-color: #fff;">
                                    <!-- Espacio vacío intencional para completar la cuadrícula -->
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="mb-4"></div> <!-- Separador inferior -->

                <!-- ======================================================= -->
                <!-- LÓGICA DE PROCESAMIENTO (MATERIALES VS SERVICIOS)       -->
                <!-- ======================================================= -->
                <t t-set="material_summary" t-value="{}"/>
                <t t-set="service_summary" t-value="{}"/>

                <t t-foreach="doc.order_line" t-as="line">
                    <t t-if="not line.display_type">
                        <t t-set="key" t-value="line.product_id.id"/>
                        
                        <!-- DETECTAR SI ES SERVICIO -->
                        <t t-if="line.product_id.type == 'service'">
                            <t t-if="key not in service_summary">
                                <t t-set="dummy" t-value="service_summary.update({key: {
                                    'name': line.product_id.display_name,
                                    'qty_total': 0.0,
                                    'uom': line.product_id.uom_id.name, 
                                    'subtotal': 0.0
                                }})"/>
                            </t>
                            <t t-set="dummy" t-value="service_summary[key].update({
                                'qty_total': service_summary[key]['qty_total'] + line.product_uom_qty,
                                'subtotal': service_summary[key]['subtotal'] + line.price_subtotal
                            })"/>
                        </t>
                        
                        <t t-else="">
                            <!-- ACUMULAR EN MATERIALES -->
                            <t t-if="key not in material_summary">
                                <t t-set="dummy" t-value="material_summary.update({key: {
                                    'name': line.product_id.display_name,
                                    'qty_lot': 0,
                                    'qty_total': 0.0,
                                    'uom': line.product_id.uom_id.name, 
                                    'subtotal': 0.0
                                }})"/>
                            </t>
                            <t t-set="current_plates" t-value="len(line.x_selected_lots) if line.x_selected_lots else 0"/>
                            <t t-set="dummy" t-value="material_summary[key].update({
                                'qty_lot': material_summary[key]['qty_lot'] + current_plates,
                                'qty_total': material_summary[key]['qty_total'] + line.product_uom_qty,
                                'subtotal': material_summary[key]['subtotal'] + line.price_subtotal
                            })"/>
                        </t>
                    </t>
                </t>

                <!-- ======================================================= -->
                <!-- TABLA 1: MATERIALES (PRODUCTOS FÍSICOS)                 -->
                <!-- ======================================================= -->
                <div class="row mt-2 mb-1">
                    <div class="col-12">
                        <div style="border: 1px solid #000; padding: 6px; background-color: #f8f9fa;">
                            <strong style="font-size: 10px; text-transform: uppercase; display: block; margin-bottom: 4px;">Materiales:</strong>
                            
                            <table class="table table-sm table-borderless mb-1" style="font-size: 9px; width: 100%;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #ccc;">
                                        <th name="th_description" style="width: 50%;">Producto</th>
                                        <th class="text-center" style="width: 15%;">Placas (Lotes)</th>
                                        <th name="th_quantity" class="text-end" style="width: 15%;">Cantidad</th>
                                        
                                        <!-- ✅ COLUMNAS OCULTAS REQUERIDAS POR ODOO (HEADER) -->
                                        <th name="th_priceunit" t-if="False"></th>
                                        <th name="th_discount" t-if="False"></th>
                                        <th name="th_taxes" t-if="False"></th>
                                        
                                        <th name="th_subtotal" class="text-end" style="width: 20%;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="material_summary.values()" t-as="data">
                                        <tr>
                                            <td name="td_name"><span t-esc="data['name']"/></td>
                                            <td class="text-center">
                                                <span t-if="data['qty_lot'] > 0" t-esc="data['qty_lot']"/>
                                                <span t-else="">-</span>
                                            </td>
                                            <td name="td_quantity" class="text-end">
                                                <span t-esc="'%.2f' % data['qty_total']"/> <span t-esc="data['uom']"/>
                                            </td>
                                            
                                            <!-- ✅ CELDAS OCULTAS REQUERIDAS POR ODOO (BODY) -->
                                            <td name="td_priceunit" t-if="False"></td>
                                            <td name="td_discount" t-if="False"></td>
                                            <td name="td_taxes" t-if="False"></td>
                                            
                                            <!-- ✅ SOPORTE PARA MÓDULOS LEGACY O LOCALIZACIONES -->
                                            <td name="td_product_quantity" t-if="False"></td>
                                            <td name="td_product_discount" t-if="False"></td>
                                            
                                            <td name="td_subtotal" class="text-end">
                                                <span t-esc="data['subtotal']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr t-if="not material_summary">
                                        <td colspan="4" class="text-center text-muted" style="font-style: italic;">No hay materiales físicos en esta orden.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ======================================================= -->
                <!-- TABLA 2: SERVICIOS ADICIONALES (AL FINAL)               -->
                <!-- ======================================================= -->
                <div class="row mb-3" t-if="service_summary">
                    <div class="col-12">
                        <div style="border: 1px solid #ccc; border-top: none; padding: 6px; background-color: #fff;">
                            <strong style="font-size: 10px; text-transform: uppercase; display: block; margin-bottom: 4px; color: #555;">Servicios Adicionales:</strong>
                            
                            <table class="table table-sm table-borderless mb-1" style="font-size: 9px; width: 100%;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <th style="width: 50%;">Descripción</th>
                                        <th class="text-center" style="width: 15%;"></th> 
                                        <th class="text-end" style="width: 15%;">Cantidad</th>
                                        <th class="text-end" style="width: 20%;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="service_summary.values()" t-as="data">
                                        <tr>
                                            <td><span t-esc="data['name']"/></td>
                                            <td></td>
                                            <td class="text-end">
                                                <span t-esc="'%.2f' % data['qty_total']"/> <span t-esc="data['uom']"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="data['subtotal']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- TOTALES -->
                <div class="row mb-3">
                    <div class="col-12">
                        <table class="table table-sm table-borderless" style="font-size: 9px; width: 100%; border-top: 2px solid #000;">
                            <tfoot>
                                <tr style="font-weight: bold;">
                                    <td style="width: 65%;"></td>
                                    <td class="text-end" style="width: 15%;">SUBTOTAL</td>
                                    <td class="text-end" style="width: 20%;"><span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td class="text-end">IMPUESTOS</td>
                                    <td class="text-end"><span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                                <tr style="font-weight: 900; font-size: 11px; border-top: 1px solid #ccc;">
                                    <td></td>
                                    <td class="text-end">TOTAL GENERAL</td>
                                    <td class="text-end"><span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- TOTALES DE IMPUESTOS ORIGINALES (Oculto para compatibilidad) -->
                <div class="clearfix" name="so_total_summary" t-if="False">
                    <div id="total" class="row" name="total">
                        <div class="col-6"></div>
                    </div>
                </div>

                <!-- FIRMAS Y NOTAS -->
                <div style="page-break-inside: avoid;">
                    <div class="row mt-4">
                        <div class="col-12">
                            <div style="border: 1px solid #ccc; padding: 10px; background-color: #fafafa;">
                                <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                    Términos y Condiciones Comerciales (Especializados en Piedra Natural)
                                </strong>
                                <div style="font-size: 8px; text-align: justify; color: #555;">
                                    <p class="mb-1"><strong>1. NATURALEZA DEL PRODUCTO:</strong> La piedra natural (mármol, granito, cuarcita, ónix, etc.) es un producto de la naturaleza. Por lo tanto, está sujeta a variaciones de tono, color, veta, textura y estructura geológica. Las muestras presentadas son únicamente indicativas y no garantizan una identidad exacta con el lote entregado. La presencia de "poros", "cristalizaciones", "venas abiertas" o "fissures" son características propias del material y no se consideran defectos de calidad.</p>
                                    <p class="mb-1"><strong>2. INSPECCIÓN Y ACEPTACIÓN:</strong> El cliente o su representante tiene la responsabilidad de inspeccionar el material físicamente antes de su transformación. La firma de la remisión de entrega o la salida del material de nuestro almacén constituye la aceptación total de la calidad. <strong>No se aceptan reclamaciones una vez que el material ha sido cortado.</strong></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row" style="margin-top: 50px;">
                        <div class="col-5 text-center" style="border-top: 1px solid #000;">
                            Firma Vendedor
                        </div>
                        <div class="col-2"></div>
                        <div class="col-5 text-center" style="border-top: 1px solid #000;">
                            Firma Cliente
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>