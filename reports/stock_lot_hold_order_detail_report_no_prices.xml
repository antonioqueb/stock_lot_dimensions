<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_stock_lot_hold_order_detail_no_prices" model="ir.actions.report">
        <field name="name">Orden de Reserva - Detalle (Sin Precios)</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_stock_lot_hold_order_detail_document_no_prices</field>
        <field name="report_file">stock_lot_dimensions.report_stock_lot_hold_order_detail_document_no_prices</field>
        <field name="print_report_name">'Reserva Detalle - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_stock_lot_hold_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_stock_lot_hold_order_detail_document_no_prices">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">

                    <t t-set="address" t-value="False"/>
                    <t t-set="information_block" t-value="False"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">

                        <!-- ================= ENCABEZADO ================= -->
                        <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                            <div class="col-8">
                                <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                                    Orden de Reserva <span t-field="o.name" style="margin-left: 10px; color: #333;"/>
                                </h4>
                            </div>
                            <div class="col-4 text-end">
                                <div style="font-size: 8px; color: #999; margin-top: 4px;">
                                    Impreso: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                </div>
                            </div>
                        </div>

                        <!-- ================= ALERTA DE VENCIMIENTO ================= -->
                        <div class="row mb-4" t-if="o.fecha_expiracion and o.state not in ['done', 'cancel']">
                            <div class="col-12">
                                <div style="border: 4px solid #ff0000; background-color: #fff5f5; padding: 8px; width: 100%;">
                                    <div style="color: #ff0000; font-weight: 900; font-size: 16px; text-transform: uppercase;">
                                        ⚠️ RESERVA CON VENCIMIENTO: <span t-field="o.fecha_expiracion" t-options='{"widget": "date"}'/>
                                    </div>
                                    <div style="color: #333; font-size: 12px; margin-top: 3px; font-style: italic;">
                                        A partir de esa fecha, las placas se liberan automáticamente y podrán ser asignadas a otro proyecto sin previo aviso.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ================= INFORMACIÓN GENERAL (3 COLUMNAS) ================= -->
                        <div class="row mb-3" id="informations">
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Cliente</strong>
                                </div>
                                <div style="line-height: 1.2; padding-left: 2px;">
                                    <span style="font-weight: bold; font-size: 12px;" t-field="o.partner_id.name"/><br/>
                                    <span t-if="o.partner_id.vat">RFC: <span t-field="o.partner_id.vat"/></span>
                                </div>
                                <div class="mt-1" style="border-top: 1px dotted #9f9f9fff; padding-top: 1px;">
                                    <strong style="font-size: 9px; text-transform: uppercase; color: #555; display: block;">Dirección de Entrega:</strong>
                                    <div style="font-size: 9px; color: #333; line-height: 1.1; margin-top: 2px; white-space: pre-line;">
                                        <span t-field="o.delivery_address"/>
                                    </div>
                                </div>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Referencia</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-0 p-0" style="width: 100%;">
                                    <tr t-if="o.project_id">
                                        <td class="p-0" style="width: 30%;"><strong>Proyecto:</strong></td>
                                        <td class="p-0"><span t-field="o.project_id.name"/></td>
                                    </tr>
                                    <tr t-if="o.arquitecto_id">
                                        <td class="p-0"><strong>Arquitecto:</strong></td>
                                        <td class="p-0"><span t-field="o.arquitecto_id.name"/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0"><strong>Vendedor:</strong></td>
                                        <td class="p-0"><span t-field="o.user_id.name"/></td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Estado</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-1 p-0" style="width: 100%;">
                                    <tr>
                                        <td class="p-0"><strong>Fecha Emisión:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.fecha_orden" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr>
                                        <td class="p-0 pt-1"><strong>Estatus:</strong></td>
                                        <td class="p-0 pt-1 text-end">
                                            <span style="font-weight: 900; text-transform: uppercase;">
                                                <t t-if="o.state == 'draft'">Borrador</t>
                                                <t t-if="o.state == 'confirmed'">Confirmada</t>
                                                <t t-if="o.state == 'done'">Finalizada</t>
                                                <t t-if="o.state == 'cancel'">Cancelada</t>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ================= DETALLE POR LÍNEA (PLACAS INDIVIDUALES - SIN PRECIOS) ================= -->
                        <t t-foreach="o.hold_line_ids" t-as="line">
                            <div style="margin-bottom: 16px; border: 1px solid #bbb;">
                                <div style="padding: 6px 8px; background: #2f2f2f; color: #fff; border-bottom: 1px solid #bbb;">
                                    <div class="row">
                                        <div class="col-6">
                                            <strong style="text-transform: uppercase;" t-esc="line.product_id.display_name"/>
                                        </div>
                                        <div class="col-6 text-end" style="font-size: 9px;">
                                            <strong>Placas:</strong> <span t-esc="len(line.lot_ids) if line.product_id.type != 'service' else '-'"/>
                                            <span style="margin: 0 4px;">|</span>
                                            <strong>m²:</strong> <span t-esc="'%.2f' % (line.cantidad_m2 or 0.0)"/>
                                        </div>
                                    </div>
                                </div>

                                <t t-if="line.product_id.type == 'service'">
                                    <div style="padding: 8px; font-size: 9px; color: #666;">
                                        Línea de servicio. No aplica desglose por placas.
                                    </div>
                                </t>

                                <t t-if="line.product_id.type != 'service'">
                                    <table class="table table-sm mb-0" style="font-size: 8.5px; width: 100%;">
                                        <thead>
                                            <tr style="border-bottom: 1px solid #000; background-color: #f8f8f8;">
                                                <th style="padding: 4px; width: 30px;">#</th>
                                                <th style="padding: 4px;">Lote</th>
                                                <th style="padding: 4px;">Bloque</th>
                                                <th style="padding: 4px;">Atado</th>
                                                <th style="padding: 4px;">No. Placa</th>
                                                <th style="padding: 4px;">Color</th>
                                                <th class="text-center" style="padding: 4px;">Grosor</th>
                                                <th class="text-end" style="padding: 4px;">Alto</th>
                                                <th class="text-end" style="padding: 4px;">Ancho</th>
                                                <th class="text-end" style="padding: 4px;">m²</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="line.lot_ids" t-as="lot">
                                                <t t-set="lot_m2" t-value="(lot.x_alto or 0.0) * (lot.x_ancho or 0.0)"/>
                                                <tr style="border-bottom: 1px solid #e5e5e5;">
                                                    <td class="text-center" style="padding: 4px;">
                                                        <span t-esc="line.lot_ids.ids.index(lot.id) + 1"/>
                                                    </td>
                                                    <td style="padding: 4px; font-weight: 600;"><span t-esc="lot.name or ''"/></td>
                                                    <td style="padding: 4px;"><span t-esc="lot.x_bloque or ''"/></td>
                                                    <td style="padding: 4px;"><span t-esc="lot.x_atado or ''"/></td>
                                                    <td style="padding: 4px;"><span t-esc="lot.x_numero_placa or ''"/></td>
                                                    <td style="padding: 4px;"><span t-esc="lot.x_color or ''"/></td>
                                                    <td class="text-center" style="padding: 4px;"><span t-esc="lot.x_grosor or ''"/></td>
                                                    <td class="text-end" style="padding: 4px;">
                                                        <span t-esc="'%.4f' % (lot.x_alto or 0.0)"/>
                                                    </td>
                                                    <td class="text-end" style="padding: 4px;">
                                                        <span t-esc="'%.4f' % (lot.x_ancho or 0.0)"/>
                                                    </td>
                                                    <td class="text-end" style="padding: 4px; font-weight: 600;">
                                                        <span t-esc="'%.2f' % lot_m2"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot>
                                            <tr style="border-top: 2px solid #000; font-weight: bold; background-color: #f8f8f8;">
                                                <td colspan="9" class="text-end" style="padding: 5px;">Total línea:</td>
                                                <td class="text-end" style="padding: 5px;">
                                                    <span t-esc="'%.2f' % (line.cantidad_m2 or 0.0)"/>
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </t>
                            </div>
                        </t>

                        <!-- ================= NOTAS ================= -->
                        <div t-if="o.notas" class="row mt-2">
                            <div class="col-12">
                                <div style="border: 1px dashed #ccc; padding: 10px; margin-top: 5px;">
                                    <strong style="font-size: 9px; text-transform: uppercase; color: #555;">Notas:</strong>
                                    <div style="font-size: 9px; white-space: pre-wrap;" t-esc="o.notas"/>
                                </div>
                            </div>
                        </div>

                        <!-- ================= TOTAL m² ================= -->
                        <div class="row mt-2">
                            <div class="col-6"></div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="font-size: 9px; border-top: 2px solid #000;">
                                    <tr style="font-weight: 900; font-size: 11px;">
                                        <td class="text-end">TOTAL m²</td>
                                        <td class="text-end" style="width: 30%;">
                                            <span t-esc="'%.2f' % o.total_m2"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ================= FOOTER / FIRMAS ================= -->
                        <div style="margin-top: 50px; width: 100%; page-break-inside: avoid;">
                            <div class="row" style="margin-top: 40px; margin-bottom: 10px;">
                                <div class="col-1"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL VENDEDOR</strong>
                                    </div>
                                </div>
                                <div class="col-2"></div>
                                <div class="col-4 text-center">
                                    <div style="border-top: 1px solid #000; padding-top: 5px;">
                                        <strong style="font-size: 9px; text-transform: uppercase;">FIRMA DEL CLIENTE / ACEPTACIÓN DE LA RESERVA</strong>
                                    </div>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-12 text-center">
                                    <p style="font-size: 9px; margin-top: 5px; padding: 0 20px;">
                                        Al firmar este documento, el cliente confirma la selección de las placas y acepta que la <span style="font-weight: bold;">RESERVA ES VÁLIDA SOLO HASTA EL <span t-field="o.fecha_expiracion" t-options='{"widget": "date"}'/></span>. Para garantizar la disponibilidad del material en su proyecto, se recomienda firmar y formalizar las condiciones comerciales antes de esa fecha.
                                    </p>
                                </div>
                            </div>

                            <div class="row mt-2">
                                <div class="col-12">
                                    <div style="border: 1px solid #ccc; padding: 8px; background-color: #fafafa;">
                                        <strong style="font-size: 10px; display: block; border-bottom: 1px solid #eee; margin-bottom: 5px; text-transform: uppercase;">
                                            Términos y Condiciones – Reserva de Material
                                        </strong>
                                        <div style="font-size: 8px; text-align: justify; color: #555;">
                                            <p style="margin: 0 0 3px 0;">• La reserva de material tiene una vigencia de 7 días naturales a partir de la fecha de confirmación.</p>
                                            <p style="margin: 0 0 3px 0;">• Durante este periodo, el material quedará separado exclusivamente para el cliente.</p>
                                            <p style="margin: 0 0 3px 0;">• En caso de no recibir el pago total o parcial dentro del plazo establecido, la reserva se cancelará automáticamente y el material quedará disponible para venta.</p>
                                            <p style="margin: 0 0 3px 0;">• La reserva no congela precios en caso de variación del tipo de cambio; el precio final será el vigente al momento del pago.</p>
                                            <p style="margin: 0 0 3px 0;">• Pasado el periodo de reserva, la empresa no garantiza disponibilidad del material ni condiciones previamente cotizadas.</p>
                                            <p style="margin: 0;">• El mármol y granito pueden presentar variaciones naturales propias del material.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>