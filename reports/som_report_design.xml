<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         SISTEMA DE DISEÑO GLOBAL DE REPORTES SOM GROUP
         ══════════════════════════════════════════════════════════════════
         Fuente ÚNICA de estilos para TODOS los reportes impresos de TODOS
         los módulos. Cualquier reporte lo hereda con una línea, al inicio
         del contenido de la página:

             <t t-call="stock_lot_dimensions.som_report_style"/>

         Reglas:
         - Este archivo NO se edita por reporte: un cambio aquí re-estiliza
           toda la suite. Ajustes específicos de un reporte van en su propio
           template, DESPUÉS del t-call.
         - Compatible con Odoo 19 / wkhtmltopdf: sin flex/grid en tablas de
           datos, sin variables CSS (se materializan los valores).

         TOKENS (referencia del diseño stock_lot_dimensions):
         - Banda de encabezado de tabla:  #2f2f2f, texto blanco, bold
         - Título de sección:             banda #f2f2f2, texto #222,
                                          9.5px, 800, uppercase
         - Etiquetas de ficha:            #555, 8.5px, uppercase
         - Bordes:                        #d8d8d8 (1px)
         - Tablas de datos:               9px, collapse, layout fijo
         - Bancarios / términos:          11px / 1.35
    -->
    <template id="som_report_style">
        <style type="text/css">
            /* ── Saltos de página seguros (thead sin superposición) ── */
            thead { display: table-row-group; }
            tbody { display: table-row-group; }
            tfoot { display: table-row-group; }
            tr { page-break-inside: avoid; break-inside: avoid; }
            .som-avoid-break { page-break-inside: avoid; }

            /* ── Compactado de tablas Bootstrap (idéntico a la referencia) ── */
            table.table.table-sm.table-striped > thead > tr > th,
            table.table.table-sm > thead > tr > th {
                padding-top: 3px !important;
                padding-bottom: 3px !important;
                line-height: 1.05 !important;
            }
            table.table.table-sm.table-striped > tbody > tr > td,
            table.table.table-sm > tbody > tr > td {
                padding-top: 2px !important;
                padding-bottom: 2px !important;
                line-height: 1.08 !important;
            }
            table.table.table-sm.table-striped > tbody > tr,
            table.table.table-sm > tbody > tr {
                height: auto !important;
            }

            /* ── Tabla de datos canónica ── */
            .som-table {
                width: 100%;
                font-size: 9px;
                border-collapse: collapse;
                table-layout: fixed;
                page-break-inside: auto;
            }
            .som-table th {
                background-color: #2f2f2f;
                color: #fff;
                font-weight: bold;
                padding: 4px 6px;
                text-align: left;
            }
            .som-table td {
                padding: 4px 6px;
                border: 1px solid #d8d8d8 !important;
                overflow-wrap: anywhere;
                word-break: break-word;
            }
            .som-table tbody tr:nth-child(even) td { background-color: #f7f7f7; }
            .som-table .som-num { text-align: right; white-space: nowrap; }

            /* ── Título de sección (banda gris) ── */
            .som-section-title {
                padding: 6px 8px;
                text-align: left;
                font-weight: 800;
                font-size: 9.5px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                background-color: #f2f2f2;
                color: #222;
                border: 1px solid #d8d8d8 !important;
                margin: 0 0 4px 0;
            }

            /* ── Ficha de información (pares etiqueta/valor) ── */
            .som-info { width: 100%; border: 1px solid #d8d8d8 !important; }
            .som-info-row {
                display: table;
                width: 100%;
                table-layout: fixed;
                border-bottom: 1px solid #d8d8d8 !important;
            }
            .som-info-row:last-child { border-bottom: none !important; }
            .som-info-label {
                display: table-cell;
                width: 42%;
                padding: 5px 8px;
                color: #555;
                text-transform: uppercase;
                font-size: 8.5px;
                letter-spacing: 0.3px;
                border-right: 1px solid #d8d8d8 !important;
            }
            .som-info-value {
                display: table-cell;
                padding: 5px 8px;
                font-weight: 600;
                font-size: 9px;
                overflow-wrap: anywhere;
                word-break: break-word;
            }

            /* ── Totales ── */
            .som-totals { width: 100%; font-size: 9.5px; border-collapse: collapse; }
            .som-totals td { padding: 3px 8px; }
            .som-totals .som-totals-label { text-align: right; color: #555; text-transform: uppercase; font-size: 8.5px; }
            .som-totals .som-totals-value { text-align: right; font-weight: 700; white-space: nowrap; width: 18%; }
            .som-totals .som-grand td {
                border-top: 2px solid #2f2f2f !important;
                font-weight: 800;
                font-size: 10.5px;
                padding-top: 5px;
            }

            /* ── Utilidades ── */
            .som-nowrap { white-space: nowrap; }
            .som-upper { text-transform: uppercase; }
            .som-muted { color: #555; }
            .som-small { font-size: 8.5px; }
            .som-doc-title {
                font-size: 15px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: #222;
                margin: 0 0 2px 0;
            }
            .som-doc-subtitle { font-size: 9.5px; color: #555; margin: 0 0 8px 0; }

            /* ── Bancarios y términos (legibilidad fija) ── */
            .aq-bank-details,
            .aq-bank-details *,
            .aq-terms-conditions,
            .aq-terms-conditions * {
                font-size: 11px !important;
                line-height: 1.35 !important;
            }
            .aq-terms-conditions-title {
                font-size: 11px !important;
                line-height: 1.25 !important;
            }
            .aq-terms-conditions p { margin: 0 0 4px 0 !important; }
        </style>
    </template>

    <!-- Bloques reutilizables opcionales -->
    <template id="som_report_section">
        <!-- t-call con: <t t-set="som_title">TÍTULO</t> -->
        <div class="som-section-title"><t t-out="som_title"/></div>
    </template>

</odoo>
