<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- ACCIÓN: REPORTE PICK TICKET (Interno) -->
    <!-- ======================================================= -->
    <record id="action_report_pick_ticket" model="ir.actions.report">
        <field name="name">Pick Ticket</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_lot_dimensions.report_pick_ticket_document</field>
        <field name="report_file">stock_lot_dimensions.report_pick_ticket_document</field>
        <field name="print_report_name">'Pick Ticket - %s' % object.name.split('/')[-1]</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ======================================================= -->
    <!-- PLANTILLA: PICK TICKET -->
    <!-- ======================================================= -->
    <template id="report_pick_ticket_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    
                    <t t-set="address" t-value="False"/>
                    <t t-set="information_block" t-value="False"/>

                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10px; color: #000;">
                        
                        <!-- ================= ENCABEZADO ================= -->
                        <div class="row border-bottom pb-2 mb-2" style="border-color: #000 !important; align-items: center;">
                            <div class="col-8">
                                <h4 class="text-uppercase mb-0" style="font-weight: 800; letter-spacing: 1px;">
                                    Pick Ticket <span t-esc="o.name.split('/')[-1]" style="margin-left: 10px; color: #333;"/>
                                </h4>
                            </div>
                            <div class="col-4 text-end">
                                <div style="font-size: 8px; color: #999; margin-top: 4px;">
                                    Impreso: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                                </div>
                            </div>
                        </div>

                        <!-- ================= INFORMACIÓN GENERAL ================= -->
                        <div class="row mb-4" id="informations">
                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Cliente</strong>
                                </div>
                                <t t-set="commercial_partner" t-value="o.sale_id.partner_id if o.sale_id else o.partner_id"/>
                                
                                <div style="line-height: 1.2; padding-left: 2px;">
                                    <span style="font-weight: bold; font-size: 12px;" t-esc="commercial_partner.name"/>
                                </div>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Dirección de Entrega</strong>
                                </div>
                                <div style="font-size: 10px; color: #333; line-height: 1.2; padding-left: 2px;">
                                    <t t-if="o.move_ids and o.move_ids[0].partner_id and o.move_ids[0].partner_id.id != commercial_partner.id">
                                        <strong t-field="o.move_ids[0].partner_id.name"/><br/>
                                        <span t-field="o.move_ids[0].partner_id.contact_address"/>
                                    </t>
                                    <t t-elif="o.partner_id and o.partner_id.id != commercial_partner.id">
                                        <strong t-field="o.partner_id.name"/><br/>
                                        <span t-field="o.partner_id.contact_address"/>
                                    </t>
                                    <t t-else="">
                                        <span style="font-style: italic; color: #666;">Misma dirección del cliente.</span>
                                    </t>
                                </div>
                            </div>

                            <div class="col-4">
                                <div class="mb-1" style="border-bottom: 1px solid #ccc; padding-bottom: 2px;">
                                    <strong style="font-size: 10px; text-transform: uppercase;">Referencia</strong>
                                </div>
                                <table class="table table-borderless table-sm mb-1 p-0" style="width: 100%;">
                                    <tr>
                                        <td class="p-0"><strong>Fecha Programada:</strong></td>
                                        <td class="p-0 text-end">
                                            <span t-field="o.scheduled_date" t-options='{"widget": "date"}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.origin">
                                        <td class="p-0"><strong>Origen:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.origin"/></td>
                                    </tr>
                                    <tr t-if="o.sale_id and o.sale_id.x_project_id">
                                        <td class="p-0"><strong>Proyecto:</strong></td>
                                        <td class="p-0 text-end"><span t-field="o.sale_id.x_project_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ================= TABLA DE DETALLES ================= -->
                        <div class="mt-3 mb-1">
                            <strong style="font-size: 10px; text-transform: uppercase; background-color: #eee; padding: 2px 5px;">Materiales a Preparar</strong>
                        </div>

                        <table class="table table-sm table-striped" style="width: 100%; font-size: 9px; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 2px solid #000; background-color: #000; color: #fff;">
                                    <th class="text-center" style="width: 5%; color: #fff; font-weight: bold;">#</th>
                                    <th style="width: 15%; color: #fff; font-weight: bold;">UBICACIÓN</th>
                                    <th style="width: 15%; color: #fff; font-weight: bold;">LOTE</th>
                                    <th style="width: 8%; color: #fff; font-weight: bold;">BLOQUE</th>
                                    <th style="width: 8%; color: #fff; font-weight: bold;">ATADO</th>
                                    <th class="text-center" style="width: 8%; color: #fff; font-weight: bold;">GROSOR</th>
                                    <th class="text-center" style="width: 8%; color: #fff; font-weight: bold;">ALTO</th>
                                    <th class="text-center" style="width: 8%; color: #fff; font-weight: bold;">ANCHO</th>
                                    <th class="text-end" style="width: 10%; color: #fff; font-weight: bold;">CANTIDAD</th>
                                    <th class="text-center" style="width: 10%; color: #fff; font-weight: bold;">UDM</th>
                                    <th class="text-center" style="width: 5%; color: #fff; font-weight: bold;">✓</th>
                                </tr>
                            </thead>
                            <tbody style="border-bottom: 1px solid #000;">
                                <!-- ESTRATEGIA: Iteramos por Move (Operación) y extraemos sus líneas -->
                                
                                <t t-set="seq" t-value="1"/>
                                <t t-set="grand_total_qty" t-value="0"/>

                                <!-- Iteramos sobre las operaciones principales (Move) -->
                                <t t-foreach="o.move_ids.sorted(key=lambda m: m.product_id.display_name)" t-as="move">
                                    
                                    <!-- Header del Producto -->
                                    <tr style="background-color: #2f2f2f; color: #fff;">
                                        <td colspan="11" style="padding: 4px 8px; font-weight: bold; font-size: 10px; text-transform: uppercase; color: #FFFFFF;">
                                            <span t-field="move.product_id.display_name"/>
                                        </td>
                                    </tr>

                                    <!-- CASO A: El movimiento TIENE líneas de detalle (move_line_ids) -->
                                    <t t-if="move.move_line_ids">
                                        <t t-foreach="move.move_line_ids.sorted(key=lambda l: l.lot_id.name)" t-as="line">
                                            
                                            <!-- Calculamos cantidad a mostrar -->
                                            <t t-set="qty_to_show" t-value="line.quantity"/>
                                            <t t-set="grand_total_qty" t-value="grand_total_qty + qty_to_show"/>

                                            <tr>
                                                <td class="text-center align-middle">
                                                    <span t-esc="seq"/>
                                                    <t t-set="seq" t-value="seq + 1"/>
                                                </td>
                                                <td class="align-middle">
                                                    <!-- CAMBIO AQUI: Recortamos la ubicación -->
                                                    <span t-esc="'/'.join(line.location_id.display_name.split('/')[-2:]).strip()"/>
                                                </td>
                                                <td class="align-middle">
                                                    <t t-if="line.lot_id">
                                                        <strong t-field="line.lot_id.name"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted text-italic">Sin Lote</span>
                                                    </t>
                                                </td>
                                                <!-- Datos dimensionales del lote -->
                                                <td class="align-middle"><span t-field="line.lot_id.x_bloque"/></td>
                                                <td class="align-middle"><span t-field="line.lot_id.x_atado"/></td>
                                                <td class="text-center align-middle"><span t-field="line.lot_id.x_grosor" t-options='{"widget": "float", "precision": 2}'/></td>
                                                <td class="text-center align-middle"><span t-field="line.lot_id.x_alto" t-options='{"widget": "float", "precision": 3}'/></td>
                                                <td class="text-center align-middle"><span t-field="line.lot_id.x_ancho" t-options='{"widget": "float", "precision": 3}'/></td>
                                                
                                                <td class="text-end align-middle">
                                                    <strong t-esc="qty_to_show" t-options='{"widget": "float", "precision": 2}'/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span t-field="line.product_uom_id.name"/>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span style="font-size: 14px;">☐</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>

                                    <!-- CASO B: NO tiene líneas de detalle todavía -->
                                    <t t-else="">
                                        <t t-set="grand_total_qty" t-value="grand_total_qty + move.product_uom_qty"/>
                                        <tr>
                                            <td class="text-center align-middle">
                                                <span t-esc="seq"/>
                                                <t t-set="seq" t-value="seq + 1"/>
                                            </td>
                                            <td class="align-middle">
                                                <!-- CAMBIO AQUI TAMBIÉN: Recortamos la ubicación origen del movimiento -->
                                                <span t-esc="'/'.join(move.location_id.display_name.split('/')[-2:]).strip()"/>
                                            </td>
                                            <td class="align-middle" colspan="6">
                                                <span class="text-muted text-italic">Sin detalles de lote reservados aún</span>
                                            </td>
                                            <td class="text-end align-middle">
                                                <strong t-field="move.product_uom_qty" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span t-field="move.product_uom.name"/>
                                            </td>
                                            <td class="text-center align-middle">
                                                <span style="font-size: 14px;">☐</span>
                                            </td>
                                        </tr>
                                    </t>

                                </t> <!-- Fin bucle Move -->
                            </tbody>
                            <tfoot style="border-top: 2px solid #000; background-color: #f9f9f9;">
                                <tr>
                                    <td colspan="8" class="text-end" style="padding: 5px; font-weight: bold;">TOTAL UNIDADES:</td>
                                    <td class="text-end" style="padding: 5px; font-weight: bold;">
                                        <span t-esc="grand_total_qty" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ================= NOTAS ================= -->
                        <div class="row mt-3" t-if="o.note">
                            <div class="col-12">
                                <div style="border: 1px solid #ccc; padding: 5px 10px;">
                                    <strong style="font-size: 9px; text-transform: uppercase;">Notas:</strong>
                                    <div style="font-size: 9px; margin-top: 2px;">
                                        <span t-field="o.note"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="text-center text-muted mt-4" style="font-size: 6px;">
                            Documento Interno | Página <span class="page"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>