<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Migración de líneas legacy (1 lote por línea → agrupadas por
            producto). noupdate: los datos legacy ya no pueden generarse con
            el código actual, así que correrla en CADA actualización del
            módulo solo alentaba los deploys. Corre una vez en instalaciones
            nuevas; en bases existentes ya se ejecutó.
        -->
        <function model="stock.lot.hold.order" name="_migrate_legacy_lines"/>
    </data>
</odoo>