<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_lot_dimensions.HoldStoneButton" owl="1">
        <div class="hold-stone-field-wrapper" t-on-click.stop="handleToggle">
            <button
                class="hold-stone-toggle-btn"
                t-att-class="state.isExpanded ? 'active' : ''"
                title="Ver/seleccionar placas"
            >
                <i class="fa fa-th-large" t-if="!state.isExpanded"/>
                <i class="fa fa-chevron-up" t-if="state.isExpanded"/>

                <span
                    t-if="state.selectedCount > 0 and !state.isExpanded"
                    class="hold-stone-count-badge"
                >
                    <t t-esc="state.selectedCount"/>
                </span>
            </button>
        </div>
    </t>
</templates>