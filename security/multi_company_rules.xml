<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Reglas de registro multiempresa. stock.lot.hold ya tiene la suya
             (stock_lot_hold_security.xml); res.company.bank.info también. -->
        <record id="rule_stock_lot_hold_order_company" model="ir.rule">
            <field name="name">Orden de Reserva: multiempresa</field>
            <field name="model_id" ref="model_stock_lot_hold_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_stock_lot_hold_order_line_company" model="ir.rule">
            <field name="name">Línea de Orden de Reserva: multiempresa</field>
            <field name="model_id" ref="model_stock_lot_hold_order_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_stock_lot_assignment_log_company" model="ir.rule">
            <field name="name">Bitácora de Asignación: multiempresa</field>
            <field name="model_id" ref="model_stock_lot_assignment_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
