<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- RESUMEN CON IMÁGENES: logo del cliente en Más información. La
         impresión vive en el menú Imprimir (binding del reporte), sin
         botón propio. -->
    <record id="view_order_form_som_proposal" model="ir.ui.view">
        <field name="name">sale.order.form.som.proposal</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='other_information']" position="inside">
                <group string="Resumen con imágenes" name="som_proposal">
                    <field name="x_client_logo" widget="image"
                           options="{'size': [0, 90]}"
                           filename="x_client_logo_filename"/>
                    <field name="x_client_logo_filename" invisible="1"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
