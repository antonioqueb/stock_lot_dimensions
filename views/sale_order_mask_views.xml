<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MÁSCARA COMERCIAL por línea de venta: columna en la cotización y en
         la orden (mismo modelo), INMEDIATAMENTE a la derecha del producto.
         Anclaje por nombre de campo (jamás posicional — ver nota de xpaths
         vs builds Enterprise). -->
    <record id="view_order_form_mask" model="ir.ui.view">
        <field name="name">sale.order.form.mask</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="x_mask_name" string="Máscara" optional="show"
                       placeholder="Nombre comercial para esta venta"/>
            </xpath>
        </field>
    </record>

    <!-- MÁSCARA DE CLIENTE: debajo del cliente en el encabezado. -->
    <record id="view_order_form_partner_mask" model="ir.ui.view">
        <field name="name">sale.order.form.partner.mask</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id'][not(ancestor::field)]" position="after">
                <field name="x_partner_mask_name"
                       placeholder="Nombre con el que saldrá el cliente en los documentos"/>
            </xpath>
        </field>
    </record>

</odoo>
