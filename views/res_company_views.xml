<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_sale_bank_info" model="ir.ui.view">
        <field name="name">res.company.form.inherit.sale.bank.info</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Datos Bancarios Comerciales" name="sale_bank_info_page">
                    <group>
                        <field name="x_payment_receipt_emails"
                               placeholder="norma@somgroup.com, clara@somgroup.com"/>
                    </group>

                    <field name="x_sale_bank_info_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="active"/>
                            <field name="name"/>
                            <field name="bank_name"/>
                            <field name="currency_id"/>
                            <field name="account_holder"/>
                            <field name="account_number"/>
                            <field name="clabe"/>
                            <field name="swift"/>
                            <field name="branch"/>
                        </list>
                        <form string="Dato Bancario Comercial">
                            <sheet>
                                <group>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="active"/>
                                        <field name="name"/>
                                        <field name="bank_name"/>
                                        <field name="currency_id"/>
                                    </group>
                                    <group>
                                        <field name="account_holder"/>
                                        <field name="account_number"/>
                                        <field name="clabe"/>
                                        <field name="swift"/>
                                        <field name="branch"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="notes" placeholder="Notas opcionales..."/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>