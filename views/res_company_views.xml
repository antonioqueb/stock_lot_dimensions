<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_sale_bank_info" model="ir.ui.view">
        <field name="name">res.company.form.inherit.sale.bank.info</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- Smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_sale_bank_info"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-university">
                    <field name="x_sale_bank_info_count" widget="statinfo" string="Datos Bancarios"/>
                </button>
            </xpath>

            <!-- Campo general -->
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Ventas y Cobranza" name="sale_billing_page">
                    <group>
                        <field name="x_payment_receipt_emails"
                               placeholder="norma@somgroup.com, clara@somgroup.com"/>
                    </group>
                    <group>
                        <label string="Administración de cuentas bancarias"/>
                        <div>
                            <button name="action_open_sale_bank_info"
                                    type="object"
                                    string="Abrir Datos Bancarios Comerciales"
                                    class="btn btn-primary"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>