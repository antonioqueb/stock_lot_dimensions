<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_lot_hold_order_line_tree" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.line.tree</field>
        <field name="model">stock.lot.hold.order.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="lot_ids"
                       widget="hold_stone_button"
                       string=" "
                       width="30px"
                       nolabel="1"
                       class="p-0 text-center"/>
                <field name="product_id"/>
                <field name="lot_count" string="Placas" readonly="1"/>
                <field name="cantidad_m2" string="m²" sum="Total m²" readonly="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="precio_unitario" string="Precio/m²" optional="show"/>
                <field name="precio_total" string="Total" sum="Total General" optional="show" readonly="1"/>
                <field name="lot_ids" column_invisible="1"/>
                <field name="lot_id" column_invisible="1"/>
                <field name="quant_id" column_invisible="1"/>
                <field name="hold_ids" column_invisible="1"/>
                <field name="hold_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_stock_lot_hold_order_tree" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.tree</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="arch" type="xml">
            <list string="Órdenes de Reserva">
                <field name="name"/>
                <field name="fecha_orden" widget="datetime"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="currency_id" optional="show"/>
                <field name="total_placas"/>
                <field name="total_m2"/>
                <field name="total_con_precio" optional="show" widget="monetary"/>
                <field name="fecha_expiracion" widget="datetime"/>
                <field name="dias_restantes" optional="show"
                       decoration-danger="dias_restantes &lt;= 2"
                       decoration-warning="dias_restantes &lt;= 5 and dias_restantes &gt; 2"/>
                <field name="state" widget="badge"/>
                <field name="sale_order_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_stock_lot_hold_order_form" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.form</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="arch" type="xml">
            <form string="Orden de Reserva">
                <header>
                    <button name="action_confirm" string="Confirmar Reserva" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_convert_to_sale_order" string="Convertir a Orden de Venta" type="object" class="btn-success"
                            invisible="state != 'confirmed' or sale_order_id"
                            confirm="¿Convertir esta reserva en orden de venta? Se liberarán los apartados automáticamente."/>
                    <button name="action_renew" string="Renovar 5 Días" type="object" class="btn-warning" invisible="state != 'confirmed' or sale_order_id"/>
                    <button name="action_done" string="Finalizar" type="object" invisible="state != 'confirmed' or sale_order_id"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(sale.act_res_partner_2_sale_order)d" type="action" class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not sale_order_id" context="{'search_default_order_id': sale_order_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Ver</span><span class="o_stat_text">Orden</span>
                            </div>
                        </button>
                    </div>
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="border rounded p-3 bg-light text-success" invisible="not sale_order_id">
                        <span class="fw-bold">Orden de Venta Generada:</span>
                        <field name="sale_order_id" readonly="1"/>
                    </div>
                    <group>
                        <group string="Datos del Cliente">
                            <field name="partner_id" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                            <field name="delivery_address" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                            <field name="project_id" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                            <field name="arquitecto_id" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                        </group>
                        <group string="Información">
                            <field name="user_id" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                            <field name="fecha_orden" readonly="1"/>
                            <field name="fecha_expiracion" readonly="1"/>
                            <field name="dias_restantes" readonly="1"
                                   decoration-danger="dias_restantes &lt;= 2"
                                   decoration-warning="dias_restantes &lt;= 5 and dias_restantes &gt; 2"/>
                            <field name="currency_id" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                            <field name="total_placas" readonly="1"/>
                            <field name="total_m2" readonly="1"/>
                            <field name="total_con_precio" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Placas Reservadas">
                            <field name="hold_line_ids"
                                   readonly="state in ['done', 'cancel'] or sale_order_id"
                                   context="{'tree_view_ref': 'stock_lot_dimensions.view_stock_lot_hold_order_line_tree'}"/>
                        </page>
                        <page string="Notas">
                            <field name="notas" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_stock_lot_hold_order" model="ir.actions.act_window">
        <field name="name">Órdenes de Reserva</field>
        <field name="res_model">stock.lot.hold.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_holds_root" name="Holds" parent="sale.sale_menu_root" action="action_stock_lot_hold_order" sequence="3"/>
</odoo>