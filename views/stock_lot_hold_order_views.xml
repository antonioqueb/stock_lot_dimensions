<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_lot_hold_order_line_tree" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.line.tree</field>
        <field name="model">stock.lot.hold.order.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="lot_ids"
                       widget="hold_stone_button"
                       string=" "
                       width="30px"
                       nolabel="1"
                       class="p-0 text-center"/>
                <field name="product_id"/>
                <field name="x_mask_name" string="Máscara" optional="show"
                       placeholder="Nombre comercial para esta venta"/>
                <field name="lot_count" string="Placas" readonly="1"/>
                <field name="cantidad_m2" string="m²" sum="Total m²" readonly="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="precio_unitario" string="Precio/m²" optional="show"/>
                <field name="precio_total" string="Total" sum="Total General" optional="show" readonly="1"/>
                <field name="lot_ids" column_invisible="1"/>
                <field name="lot_id" column_invisible="1"/>
                <field name="quant_id" column_invisible="1"/>
                <field name="hold_ids" column_invisible="1"/>
                <field name="hold_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_stock_lot_hold_order_tree" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.tree</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="arch" type="xml">
            <list string="Órdenes de Reserva">
                <field name="name"/>
                <field name="fecha_orden" widget="datetime"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="currency_id" optional="show"/>
                <field name="total_placas"/>
                <field name="total_m2"/>
                <field name="total_con_precio" optional="show" widget="monetary"/>
                <field name="fecha_expiracion" widget="datetime"/>
                <field name="dias_restantes" optional="show"
                       decoration-danger="dias_restantes &lt;= 2"
                       decoration-warning="dias_restantes &lt;= 5 and dias_restantes &gt; 2"/>
                <field name="x_estatus_reserva" widget="badge"
                       decoration-success="x_estatus_reserva == 'vigente'"
                       decoration-danger="x_estatus_reserva == 'vencida'"
                       decoration-info="x_estatus_reserva == 'en_so'"
                       decoration-muted="x_estatus_reserva in ('cancelada', 'finalizada')"/>
                <field name="state" widget="badge" optional="hide"/>
                <field name="sale_order_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_stock_lot_hold_order_search" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.search</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="arch" type="xml">
            <search string="Reservas">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="filter_vigente" string="Vigentes"
                        domain="[('x_estatus_reserva', '=', 'vigente')]"/>
                <filter name="filter_vencida" string="Vencidas"
                        domain="[('x_estatus_reserva', '=', 'vencida')]"/>
                <filter name="filter_en_so" string="En SO"
                        domain="[('x_estatus_reserva', '=', 'en_so')]"/>
                <filter name="filter_cancelada" string="Canceladas"
                        domain="[('x_estatus_reserva', '=', 'cancelada')]"/>
                <separator/>
                <filter name="filter_mias" string="Mis reservas"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="group_estatus" string="Agrupar por estatus"
                        context="{'group_by': 'x_estatus_reserva'}"/>
                <filter name="group_vendedor" string="Agrupar por vendedor"
                        context="{'group_by': 'user_id'}"/>
                <filter name="group_cliente" string="Agrupar por cliente"
                        context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_stock_lot_hold_order_form" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.form</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="arch" type="xml">
            <form string="Orden de Reserva">
                <header>
                    <button name="action_confirm" string="Confirmar Reserva" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_convert_to_sale_order" string="Convertir a Orden de Venta" type="object" class="btn-success"
                            invisible="state != 'confirmed' or sale_order_id"
                            confirm="¿Convertir esta reserva en orden de venta? Se liberarán los apartados automáticamente."/>
                    <button name="action_renew" string="Renovar 5 Días" type="object" class="btn-warning" invisible="state != 'confirmed' or sale_order_id"/>
                    <button name="action_send_hold_confirmation_email" string="Enviar Correo" type="object" icon="fa-envelope-o" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Finalizar" type="object" invisible="state != 'confirmed' or sale_order_id"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(sale.act_res_partner_2_sale_order)d" type="action" class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not sale_order_id" context="{'search_default_order_id': sale_order_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Ver</span><span class="o_stat_text">Orden</span>
                            </div>
                        </button>
                    </div>
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="border rounded p-3 bg-light text-success" invisible="not sale_order_id">
                        <span class="fw-bold">Orden de Venta Generada:</span>
                        <field name="sale_order_id" readonly="1"/>
                    </div>
                    <group>
                        <group string="Datos del Cliente">
                            <field name="partner_id" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                            <!-- Correo y teléfono del cliente (related
                                 editable): el correo es el que recibe la
                                 confirmación y los avisos de vencimiento.
                                 Se dejan editables aun con el apartado
                                 cerrado — corregir un dato de contacto en
                                 la ficha nunca sobra. -->
                            <field name="x_partner_email" string="Correo" widget="email"
                                   placeholder="correo@cliente.com"/>
                            <field name="x_partner_phone" string="Teléfono" widget="phone"
                                   placeholder="+52 81 0000 0000"/>
                            <field name="delivery_address" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                            <field name="project_id" readonly="state in ['done', 'cancel'] or sale_order_id"
                                   domain="['|', ('partner_id', '=', False), ('partner_id', 'child_of', partner_id)]"
                                   context="{'default_partner_id': partner_id}"/>
                            <field name="arquitecto_id" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                        </group>
                        <group string="Información">
                            <field name="user_id" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                            <field name="fecha_orden" readonly="1"/>
                            <field name="fecha_expiracion" readonly="1"/>
                            <field name="dias_restantes" readonly="1"
                                   decoration-danger="dias_restantes &lt;= 2"
                                   decoration-warning="dias_restantes &lt;= 5 and dias_restantes &gt; 2"/>
                            <field name="currency_id" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                            <field name="total_placas" readonly="1"/>
                            <field name="total_m2" readonly="1"/>
                            <field name="total_con_precio" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Placas Reservadas">
                            <field name="hold_line_ids"
                                   readonly="state in ['done', 'cancel'] or sale_order_id"
                                   context="{'tree_view_ref': 'stock_lot_dimensions.view_stock_lot_hold_order_line_tree'}"/>
                        </page>
                        <page string="Notas">
                            <field name="notas" readonly="state in ['done', 'cancel'] or sale_order_id"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_stock_lot_hold_order_kanban" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.kanban</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_estatus_reserva" class="o_kanban_small_column">
                <field name="x_estatus_reserva"/>
                <field name="dias_restantes"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column p-2" style="gap: 4px;">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong><field name="name"/></strong>
                                <field name="x_estatus_reserva" widget="label_selection"
                                       options="{'classes': {'vigente': 'success', 'vencida': 'danger', 'en_so': 'info', 'cancelada': 'secondary', 'finalizada': 'secondary', 'borrador': 'warning'}}"/>
                            </div>
                            <div><i class="fa fa-user me-1" title="Cliente"/><field name="partner_id"/></div>
                            <div class="text-muted">
                                <i class="fa fa-id-badge me-1" title="Vendedor"/><field name="user_id"/>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>
                                    <i class="fa fa-th-large me-1" title="Placas"/><field name="total_placas"/> placas
                                    · <field name="total_m2"/> m²
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">
                                    <i class="fa fa-clock-o me-1" title="Vence"/><field name="fecha_expiracion" widget="datetime"/>
                                </span>
                                <span t-if="record.dias_restantes.raw_value &lt;= 2"
                                      class="badge text-bg-danger">
                                    <field name="dias_restantes"/> días
                                </span>
                                <span t-elif="record.dias_restantes.raw_value &lt;= 5"
                                      class="badge text-bg-warning">
                                    <field name="dias_restantes"/> días
                                </span>
                                <span t-else="" class="badge text-bg-light">
                                    <field name="dias_restantes"/> días
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_stock_lot_hold_order" model="ir.actions.act_window">
        <field name="name">Órdenes de Reserva</field>
        <field name="res_model">stock.lot.hold.order</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <menuitem id="menu_holds_root" name="Holds" parent="sale.sale_menu_root"
              action="action_stock_lot_hold_order" sequence="3"
              groups="sales_team.group_sale_salesman"/>
</odoo>