<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA LIST SEPARADA PARA LÍNEAS -->
    <record id="view_stock_lot_hold_order_line_tree" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.line.tree</field>
        <field name="model">stock.lot.hold.order.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="lot_id" 
                       required="1" 
                       domain="[('product_id', '!=', False)]"
                       options="{'no_create': True}"/>
                <field name="product_id" readonly="1"/>
                <field name="cantidad_m2" string="m²" sum="Total m²" readonly="1"/>
                <field name="x_grosor" string="Grosor" optional="show" readonly="1"/>
                <field name="x_alto" string="Alto" optional="show" readonly="1"/>
                <field name="x_ancho" string="Ancho" optional="show" readonly="1"/>
                <field name="x_tipo" string="Tipo" optional="show" readonly="1"/>
                <field name="hold_id" string="Hold Creado" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- VISTA LIST PRINCIPAL -->
    <record id="view_stock_lot_hold_order_tree" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.tree</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="arch" type="xml">
            <list string="Órdenes de Reserva">
                <field name="name"/>
                <field name="fecha_orden" widget="datetime"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="total_placas"/>
                <field name="total_m2"/>
                <field name="fecha_expiracion" widget="datetime"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- VISTA FORM -->
    <record id="view_stock_lot_hold_order_form" model="ir.ui.view">
        <field name="name">stock.lot.hold.order.form</field>
        <field name="model">stock.lot.hold.order</field>
        <field name="arch" type="xml">
            <form string="Orden de Reserva">
                <header>
                    <button name="action_confirm" 
                            string="Confirmar Reserva" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_renew" 
                            string="Renovar 5 Días" 
                            type="object" 
                            class="btn-warning"
                            invisible="state != 'confirmed'"/>
                    <button name="action_done" 
                            string="Finalizar" 
                            type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" 
                            string="Cancelar" 
                            type="object"
                            invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                
                <sheet>
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    
                    <group>
                        <group string="Cliente">
                            <field name="partner_id" readonly="state in ['done', 'cancel']"/>
                            <field name="project_id" readonly="state in ['done', 'cancel']"/>
                            <field name="arquitecto_id" readonly="state in ['done', 'cancel']"/>
                        </group>
                        
                        <group string="Información">
                            <field name="user_id" readonly="state in ['done', 'cancel']"/>
                            <field name="fecha_orden" readonly="1"/>
                            <field name="fecha_expiracion" readonly="1"/>
                            <field name="total_placas" readonly="1"/>
                            <field name="total_m2" readonly="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Placas Reservadas">
                            <field name="hold_line_ids" 
                                   readonly="state in ['done', 'cancel']"
                                   context="{'tree_view_ref': 'stock_lot_dimensions.view_stock_lot_hold_order_line_tree'}"/>
                        </page>
                        
                        <page string="Notas">
                            <field name="notas" readonly="state in ['done', 'cancel']"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="action_stock_lot_hold_order" model="ir.actions.act_window">
        <field name="name">Órdenes de Reserva</field>
        <field name="res_model">stock.lot.hold.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENÚ -->
    <menuitem id="menu_stock_lot_hold_order"
              name="Órdenes de Reserva"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_lot_hold_order"
              sequence="99"/>
</odoo>