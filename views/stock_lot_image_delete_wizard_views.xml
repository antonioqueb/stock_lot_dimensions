<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Form del Wizard -->
    <record id="view_stock_lot_image_delete_wizard_form" model="ir.ui.view">
        <field name="name">stock.lot.image.delete.wizard.form</field>
        <field name="model">stock.lot.image.delete.wizard</field>
        <field name="arch" type="xml">
            <form string="Eliminar Todas las Fotos">
                <div class="alert alert-danger" role="alert" style="margin-bottom: 20px;">
                    <h3 class="text-danger"><i class="fa fa-exclamation-triangle"/> ADVERTENCIA</h3>
                    <p>
                        Está a punto de eliminar <strong>TODAS</strong> las fotografías de los lotes en el sistema.
                        Esta acción borrará físicamente las imágenes y sus referencias.
                        <strong>Esta acción es IRREVERSIBLE.</strong>
                    </p>
                </div>
                
                <sheet>
                    <group>
                        <field name="total_images" readonly="1"/>
                        <field name="confirm_deletion"/>
                    </group>
                </sheet>
                
                <footer>
                    <button string="ELIMINAR TODO" 
                            name="action_delete_all_images" 
                            type="object" 
                            class="btn-danger" 
                            icon="fa-trash"/>
                    <button string="Cancelar" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_stock_lot_image_delete_wizard" model="ir.actions.act_window">
        <field name="name">Eliminación Masiva de Fotos</field>
        <field name="res_model">stock.lot.image.delete.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú item en Inventario > Configuración -->
    <menuitem id="menu_stock_lot_image_delete"
              name="Eliminar Fotos Masivamente"
              parent="stock.menu_stock_config_settings"
              action="action_stock_lot_image_delete_wizard"
              groups="stock.group_stock_manager"
              sequence="100"/>
</odoo>