<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_project_architect" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.project.architect</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Insertar después del cliente -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_project_id"/>
                <field name="x_architect_id"/>
            </xpath>
        </field>
    </record>
</odoo>