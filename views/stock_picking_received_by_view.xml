<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_received_by" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.received.by</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_received_by_name" 
                       placeholder="Nombre de quien recibe el material"
                       invisible="picking_type_code != 'outgoing'"/>
            </xpath>
        </field>
    </record>
</odoo>